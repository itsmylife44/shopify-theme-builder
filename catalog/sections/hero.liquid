{% liquid
  assign loading = 'eager'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  elsif section.index > 3
    assign loading = 'lazy'
  endif

  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
%}

<div class="hero full-width color-{{ section.settings.color_scheme }}">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: true, class: 'hero__media-item'
      }}
    {% elsif section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'hero__media-item',
          widths: '750, 1100, 1500, 2200, 3000, 3840',
          sizes: '100vw',
          loading: loading,
          fetchpriority: fetchpriority
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__media-item hero__placeholder' }}
    {% endif %}
  </div>

  {% if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank %}
    <div class="hero__content">
      {% if section.settings.heading != blank %}
        <{{ heading_tag }} class="hero__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="hero__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="hero__button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
    align-items: end;
    min-height: clamp(28rem, 75vh, 48rem);
    padding-block: 3rem;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media-item {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .hero__content {
    position: relative;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 40rem;
    padding: 2rem;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .hero__heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .hero__text {
    line-height: 1.5;
  }

  .hero__button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-button);
    color: var(--color-button-label);
    text-decoration: none;
  }

  .hero__button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop, in place of the image."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell customers what makes your products special.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
