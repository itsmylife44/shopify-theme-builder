<div class="image-with-text full-width image-with-text--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }}">
  <div class="image-with-text__inner">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'image-with-text__placeholder' }}
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.heading != blank %}
        <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-with-text__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="image-with-text__button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .image-with-text__inner {
    grid-column: 2;
    display: grid;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  @media (min-width: 750px) {
    .image-with-text__inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .image-with-text--image-right .image-with-text__media {
      order: 1;
    }
  }

  .image-with-text__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .image-with-text__media img,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .image-with-text__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .image-with-text__text {
    line-height: 1.5;
  }

  .image-with-text__button {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-button);
    color: var(--color-button-label);
    text-decoration: none;
  }

  .image-with-text__button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair text with an image to tell the story of your brand or a product.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
