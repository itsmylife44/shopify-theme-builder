{% doc %}
  Renders a short shipping and returns summary, the free-shipping threshold
  theme setting when it's set (only in the shop currency, the one it's in),
  and links to the shop's shipping and refund policy pages when they are set.

  @example
  {% content_for 'block', type: 'shipping-note', id: 'shipping-note' %}
{% enddoc %}

{% capture content %}
  {{ block.settings.text }}
  {% if settings.free_shipping_threshold > 0 and cart.currency.iso_code == shop.currency %}
    {% assign amount = settings.free_shipping_threshold | times: 100 | round | money %}
    <p>{{ 'product.free_shipping_over' | t: amount: amount }}</p>
  {% endif %}
  {% if shop.shipping_policy or shop.refund_policy %}
    <ul class="shipping-note__links" role="list">
      {% if shop.shipping_policy %}
        <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>
      {% endif %}
      {% if shop.refund_policy %}
        <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>
      {% endif %}
    </ul>
  {% endif %}
{% endcapture %}
{% assign content = content | strip %}

{% if content != blank %}
  <div class="shipping-note text-small" {{ block.shopify_attributes }}>
    {{ content }}
  </div>
{% elsif request.design_mode %}
  <p class="block-hint text-small" {{ block.shopify_attributes }}>{{ 'blank_block.shipping_note' | t }}</p>
{% endif %}

{% stylesheet %}
  .shipping-note {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .shipping-note > * {
    margin: 0;
  }

  .shipping-note__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.shipping_note",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "info": "t:info.shipping_note_text"
    }
  ],
  "presets": [{ "name": "t:general.shipping_note" }]
}
{% endschema %}
