[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:general.logo"
      },
      {
        "type": "text",
        "id": "logo_asset",
        "label": "t:labels.logo_asset",
        "info": "t:info.logo_asset"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "t:labels.show_breadcrumbs",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:labels.button_label",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "t:labels.social_x"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "t:labels.social_pinterest"
      }
    ]
  }
]
