<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction }}">
  <head>
    {% unless settings.type_heading_font.system? and settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% # Inlined CSS Variables, after preloading the heading font variant they load and the body font's base weight %}
    {% render 'css-variables', preload: true %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Reveal on scroll, the one shared script of the motion setting %}
    {% if settings.motion != 'none' %}
      <script src="{{ 'reveal.js' | asset_url }}" defer></script>
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-to-content" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    {% render 'breadcrumbs' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
