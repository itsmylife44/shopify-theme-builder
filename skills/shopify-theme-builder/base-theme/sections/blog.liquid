{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="basic-page full-width color-{{ section.settings.color_scheme }}">
  <h1>{{ blog.title }}</h1>

  {% paginate blog.articles by 6 %}
    {% if blog.articles.size == 0 %}
      <p>{{ 'blog.empty' | t }}</p>
    {% else %}
      <div class="blog__articles">
        {% for article in blog.articles %}
          <article class="blog__article">
            <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {% if article.image %}
                {{ article.image | image_url: width: 800 | image_tag: sizes: '(min-width: 750px) 33vw, 100vw' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder' }}
              {% endif %}
            </a>
            <h2 class="text-h4">{{ article.title | link_to: article.url }}</h2>
            {% assign date = article.published_at | time_tag: format: 'date' %}
            {% assign author = article.author | escape %}
            <p>{{ 'blog.article_metadata_html' | t: date: date, author: author }}</p>
            {% if article.excerpt != blank %}
              <div>{{ article.excerpt }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    {%- if paginate.pages > 1 -%}
      <div>{{- paginate | default_pagination -}}</div>
    {%- endif -%}
  {% endpaginate %}
</div>

{% stylesheet %}
  .blog__articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 2rem;
  }

  .blog__article {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .blog__article :is(img, .placeholder) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .blog__article h2 a {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
