{% comment %}
  The home page of a Theme before the Creator composes it from the Section Catalog.
{% endcomment %}

<div class="basic-page basic-page--center full-width">
  <h1>{{ shop.name }}</h1>

  {% if shop.description != blank %}
    <p>{{ shop.description | escape }}</p>
  {% endif %}

  <a class="button" href="{{ routes.all_products_collection_url }}">
    {{- 'general.shop_all' | t -}}
  </a>
</div>

{% schema %}
{
  "name": "t:general.welcome",
  "settings": [],
  "presets": [
    {
      "name": "t:general.welcome"
    }
  ]
}
{% endschema %}
