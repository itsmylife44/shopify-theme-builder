{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="basic-page full-width color-{{ section.settings.color_scheme }}">
  <h1>{{ page.title }}</h1>

  <div class="basic-page__text">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
