{% comment %}
  This section is used in the page template to render store pages like About us
  (the contact page has its own template, page.contact).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="basic-page full-width color-{{ section.settings.color_scheme }}">
  <div class="page__column">
    <h1>{{ page.title }}</h1>
    {% if page.content != blank %}
      <div class="basic-page__text rte">{{ page.content }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .page__column {
    display: grid;
    gap: var(--space-lg);
    justify-self: center;
    width: 100%;
    max-width: var(--width-prose);
  }

  .page__column > h1 {
    margin-block: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
