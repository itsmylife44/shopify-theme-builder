{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="basic-page basic-page--center full-width color-{{ section.settings.color_scheme }}">
  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password', class: 'basic-page__form' %}
    {% if form.errors %}
      <div role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="basic-page__field">
      <label for="password-input">
        {{ 'password.password' | t }}
      </label>
      <input type="password" name="password" id="password-input" autocomplete="current-password" required>
    </div>

    <button type="submit" class="button">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
