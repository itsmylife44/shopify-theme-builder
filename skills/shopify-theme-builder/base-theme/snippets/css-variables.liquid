{%- liquid
  # A heading weight other than the font's own loads that weight of the heading font when the family has it.
  assign heading_font = settings.type_heading_font
  assign heading_weight = settings.type_heading_font.weight
  if settings.type_heading_weight != 'font'
    assign heading_weight = settings.type_heading_weight
    assign heading_font = settings.type_heading_font | font_modify: 'weight', heading_weight | default: settings.type_heading_font
  endif
  case settings.type_heading_tracking
    when 'tighter'
      assign heading_tracking = '-0.04em'
    when 'tight'
      assign heading_tracking = '-0.02em'
    when 'wide'
      assign heading_tracking = '0.06em'
    when 'wider'
      assign heading_tracking = '0.12em'
    else
      assign heading_tracking = 'normal'
  endcase
  # The heading line height moves display and heading line heights together, a tenth a step.
  case settings.type_heading_line_height
    when 'tight'
      assign line_height_display = 1
      assign line_height_heading = 1.1
    when 'loose'
      assign line_height_display = 1.2
      assign line_height_heading = 1.3
    else
      assign line_height_display = 1.1
      assign line_height_heading = 1.2
  endcase

  # A button weight other than the body font's own loads that weight of the body font when the family has it.
  assign button_weight = 'var(--font-body--weight)'
  if settings.button_font_weight != 'font'
    assign button_weight = settings.button_font_weight
    assign button_font = settings.type_body_font | font_modify: 'weight', button_weight
  endif
  assign outline_button = false
  if settings.button_primary_style == 'outline'
    assign outline_button = true
  endif

  # The shape family: one radius each for buttons, inputs, cards, media and badges.
  case settings.shape_family
    when 'square'
      assign radius_buttons = '0'
      assign radius_inputs = '0'
      assign radius_cards = '0'
      assign radius_media = '0'
      assign radius_badges = '0'
    when 'round'
      assign radius_buttons = 'var(--style-border-radius-pill)'
      assign radius_inputs = '1.5rem'
      assign radius_cards = '1rem'
      assign radius_media = '1rem'
      assign radius_badges = 'var(--style-border-radius-pill)'
    else
      assign radius_buttons = '0.25rem'
      assign radius_inputs = '0.25rem'
      assign radius_cards = '0.5rem'
      assign radius_media = '0.5rem'
      assign radius_badges = '0.25rem'
  endcase

  # The density: section spacing and grid gaps in px on desktop.
  case settings.density
    when 'compact'
      assign section_spacing = 48
      assign grid_gap = 16
    when 'airy'
      assign section_spacing = 112
      assign grid_gap = 32
    else
      assign section_spacing = 80
      assign grid_gap = 24
  endcase

  assign framed = false
  if settings.media_treatment == 'framed'
    assign framed = true
  endif

  # A product image multiplies with a light tint (brightness over 150 of 255), so the white of a cut-out photo takes
  # the tint; over a dark tint multiply would turn the whole photo nearly black, so it sits on the tint unblended.
  assign media_blend = 'normal'
  if settings.media_tint != blank
    assign tint_brightness = settings.media_tint | color_brightness
    if tint_brightness > 150
      assign media_blend = 'multiply'
    endif
  endif

  # Motion: hovers, reveals on scroll, the card image zoom and the hero's slow zoom; none sets no motion at all.
  case settings.motion
    when 'none'
      assign motion_duration = '0s'
      assign motion_duration_reveal = '0s'
      assign motion_duration_zoom = '0s'
      assign motion_duration_hero_zoom = '0s'
      assign motion_easing = 'ease'
      assign motion_rise = '0'
      assign motion_hero_zoom = '1'
    when 'expressive'
      assign motion_duration = '0.25s'
      assign motion_duration_reveal = '0.8s'
      assign motion_duration_zoom = '1.5s'
      assign motion_duration_hero_zoom = '8s'
      assign motion_easing = 'cubic-bezier(0.165, 0.84, 0.44, 1)'
      assign motion_rise = '2rem'
      assign motion_hero_zoom = '1.06'
    else
      assign motion_duration = '0.2s'
      assign motion_duration_reveal = '0.6s'
      assign motion_duration_zoom = '0.25s'
      assign motion_duration_hero_zoom = '0s'
      assign motion_easing = 'ease-out'
      assign motion_rise = '0'
      assign motion_hero_zoom = '1'
  endcase

  case settings.page_width
    when 'narrow'
      assign page_width = '75rem'
    when 'wide'
      assign page_width = '110rem'
    else
      assign page_width = '90rem'
  endcase

  # Display type grows linearly from its mobile size at a 390px viewport to its size at 1200px.
  assign display_mobile = settings.type_display_size_mobile | at_most: settings.type_display_size
  assign display_slope = settings.type_display_size | minus: display_mobile | divided_by: 810.0
  assign display_intercept = display_slope | times: -390 | plus: display_mobile | divided_by: 16.0 | round: 4
  assign display_vw = display_slope | times: 100 | round: 4
-%}
{%- if preload -%}
  {% # The layout's preloads: the heading variant the @font-face below loads, and the body font's base weight %}
  {% unless heading_font.system? %}
    {{ heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
  {% endunless %}
  {% unless settings.type_body_font.system? %}
    {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
  {% endunless %}
{%- endif -%}
{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}
  {% if button_font %}{{ button_font | font_face: font_display: 'swap' }}{% endif %}

  :root {
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ heading_weight }};
    --font-heading--case: {{ settings.type_heading_case }};
    --font-heading--tracking: {{ heading_tracking }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};
    {% # The accent font: labels and prices. %}
    --font-accent--family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    --font-accent--style: {{ settings.type_accent_font.style }};
    --font-accent--weight: {{ settings.type_accent_font.weight }};
    {% comment %}
      The type scale. Each heading level is the body size times the scale ratio to the power of its step (h4 1, h3 2,
      h2 3, h1 4; h5 halfway between body and h4). h1 to h3 and display are fluid: they reach their size at a 1200px
      viewport (--font-size-fluid is the body size there) and shrink to a ratio half as steep on mobile, which keeps
      their order. Display has its own desktop and mobile sizes (see display_mobile above), never below h1.
    {% endcomment %}
    --font-scale: {{ settings.type_scale_ratio | divided_by: 100.0 }};
    --font-scale-mobile: calc(1 + (var(--font-scale) - 1) / 2);
    --font-size-body: {{ settings.type_body_size | divided_by: 16.0 }}rem;
    --font-size-fluid: {{ settings.type_body_size | divided_by: 12.0 | round: 4 }}vw;
    --font-size-display: max(var(--font-size-h1), clamp({{ display_mobile | divided_by: 16.0 }}rem, calc({{ display_intercept }}rem + {{ display_vw }}vw), {{ settings.type_display_size | divided_by: 16.0 }}rem));
    --font-size-h1: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 4)), calc(var(--font-size-fluid) * pow(var(--font-scale), 4)), calc(var(--font-size-body) * pow(var(--font-scale), 4)));
    --font-size-h2: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 3)), calc(var(--font-size-fluid) * pow(var(--font-scale), 3)), calc(var(--font-size-body) * pow(var(--font-scale), 3)));
    --font-size-h3: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 2)), calc(var(--font-size-fluid) * pow(var(--font-scale), 2)), calc(var(--font-size-body) * pow(var(--font-scale), 2)));
    --font-size-h4: calc(var(--font-size-body) * var(--font-scale));
    --font-size-h5: calc(var(--font-size-body) * (1 + var(--font-scale)) / 2);
    --font-size-h6: var(--font-size-body);
    --font-size-small: calc(var(--font-size-body) * 0.875);
    --font-size-label: calc(var(--font-size-body) * 0.75);
    --line-height-display: {{ line_height_display }};
    --line-height-heading: {{ line_height_heading }};
    --line-height-body: 1.5;
    {% comment %}
      Spacing: padding, margins and gaps take a step of this scale. Sections pad their top with
      --section-spacing-start and their bottom with --section-spacing, and grids of items space them with --grid-gap
      (--grid-row-gap between rows of cards with text): both follow the density, halved (the gaps three quarters) on
      mobile. A section's spacing setting scales --section-spacing-theme on the section (critical.css), and the top
      drops after a section on the same color scheme (below).
    {% endcomment %}
    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --section-spacing-theme: {{ section_spacing | divided_by: 32.0 }}rem;
    --section-spacing: var(--section-spacing-theme);
    --section-spacing-start: var(--section-spacing);
    --grid-gap: {{ grid_gap | times: 0.75 | divided_by: 16 }}rem;
    --grid-row-gap: calc(var(--grid-gap) * 1.5);
    {% # Content widths: forms, a text column beside media, a column of running text (about 70 characters a line). %}
    --width-narrow: 30rem;
    --width-text: 40rem;
    --width-prose: 70ch;
    --border-width: {{ settings.border_width }}px;
    --style-border-radius-pill: 999px;
    --style-border-radius-inputs: {{ radius_inputs }};
    --style-border-radius-cards: {{ radius_cards }};
    --style-border-radius-media: {{ radius_media }};
    --style-border-radius-badges: {{ radius_badges }};
    --focus-ring-width: 2px;
    --focus-ring-offset: 2px;
    {% # Faded controls: thumbnails not shown, options not available. Muted text takes --color-foreground-muted. %}
    --opacity-muted: 0.7;
    --opacity-disabled: 0.5;
    {% # Touch targets: primary controls (buttons, fields, menu, close, variant options) are at least --target-size, every other control --target-size-min. %}
    --target-size: 44px;
    --target-size-min: 24px;
    {% # Buttons: the shared .button and .button--secondary in critical.css. %}
    --button-padding-block: var(--space-sm);
    --button-padding-inline: var(--space-lg);
    --button-border-width: var(--border-width);
    --button-radius: {{ radius_buttons }};
    --button-text-transform: {{ settings.button_text_case }};
    --button-letter-spacing: {% if settings.button_text_case == 'uppercase' %}0.06em{% else %}normal{% endif %};
    --button-font-weight: {{ button_weight }};
    {% comment %}
      Product cards: the shared .product-card in critical.css. A bordered card sets a border width, a card on a
      surface a background (with the color scheme, below); both pad the text, and the image fills the card's top
      and sides. The hover zooms the image by a scale, unless the card shows a second image.
    {% endcomment %}
    --card-image-ratio: {{ settings.card_image_ratio }};
    --card-text-align: {{ settings.card_text_alignment | replace: 'left', 'start' | replace: 'right', 'end' }};
    --card-border-width: {% if settings.card_style == 'bordered' %}var(--border-width){% else %}0{% endif %};
    --card-padding: {% if settings.card_style == 'plain' %}0{% else %}var(--space-md){% endif %};
    --card-hover-scale: {% if settings.card_hover == 'none' %}1{% else %}1.03{% endif %};
    {% comment %}
      Media, for product images only (product cards, the product page, featured product, quick add, predictive
      search and collection images): each sits in a box with the tint behind it. Full-bleed crops the image to fill
      the box; framed shows all of it, inset. An image over a light tint multiplies with it, so the white of a
      cut-out product photo takes the tint; over a dark tint it sits unblended. Every other image always covers its
      box and uses none of these.
    {% endcomment %}
    --media-fit: {% if framed %}contain{% else %}cover{% endif %};
    --media-inset: {% if framed %}5%{% else %}0{% endif %};
    --media-background: {{ settings.media_tint | default: 'transparent' }};
    --media-blend: {{ media_blend }};
    {% comment %}
      Motion: hover transitions take --motion-duration with --motion-easing. Sections revealed on scroll (reveal.js)
      fade in over --motion-duration-reveal with --motion-easing-enter and rise by --motion-rise, the items of their
      grids each --motion-stagger after the one before. A card image zooms over --motion-duration-zoom, and the hero's
      and the slides' images slowly zoom to --motion-hero-zoom over --motion-duration-hero-zoom. Reduced motion sets
      them to nothing, below.
    {% endcomment %}
    --motion-duration: {{ motion_duration }};
    --motion-duration-reveal: {{ motion_duration_reveal }};
    --motion-duration-zoom: {{ motion_duration_zoom }};
    --motion-duration-hero-zoom: {{ motion_duration_hero_zoom }};
    --motion-easing: {{ motion_easing }};
    --motion-easing-enter: cubic-bezier(0.05, 0.7, 0.1, 1);
    --motion-stagger: 60ms;
    --motion-rise: {{ motion_rise }};
    --motion-hero-zoom: {{ motion_hero_zoom }};
    {% comment %}
      The breakpoint is 750px: layouts switch at @media (min-width: 750px) and (max-width: 749px), and image sizes
      at (min-width: 750px). CSS variables don't work in media queries, so it is this constant instead of a variable.
    {% endcomment %}
    --page-width: {{ page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
  }

  @media (min-width: 750px) {
    :root {
      --section-spacing-theme: {{ section_spacing | divided_by: 16.0 }}rem;
      --grid-gap: {{ grid_gap | divided_by: 16.0 }}rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --motion-duration: 0s;
      --motion-duration-reveal: 0s;
      --motion-duration-zoom: 0s;
      --motion-duration-hero-zoom: 0s;
      --motion-rise: 0;
      --motion-stagger: 0s;
      --motion-hero-zoom: 1;
    }
  }

  {% # The first color scheme is the page default; sections opt into others with a color-<scheme id> class. %}
  {% # Variables also go on :root, the background only on the class, so it paints the element that uses it. %}
  {% for scheme in settings.color_schemes %}
    {% liquid
      # A surface card sits on the media tint, so its image and text share one field, where the scheme's text
      # reads on the tint (4.5:1); otherwise, and without a tint, on 5% of the text color.
      assign card_background = 'transparent'
      if settings.card_style == 'surface'
        assign card_background = 'rgb(from var(--color-foreground) r g b / 0.05)'
        if settings.media_tint != blank
          assign tint_contrast = scheme.settings.text | color_contrast: settings.media_tint
          if tint_contrast >= 4.5
            assign card_background = settings.media_tint
          endif
        endif
      endif

      # Muted text (vendors, compare-at prices, labels): the text mixed toward the background, 70% text first, then
      # more until it reads at 4.6:1 (a margin over 4.5:1, since color_contrast rounds), else the text itself.
      # check-direction.mjs derives it the same way.
      assign muted_text = scheme.settings.text
      for step in (14..19)
        assign share = step | times: 5
        assign mix = scheme.settings.text | color_mix: scheme.settings.background, share
        assign mix_contrast = mix | color_contrast: scheme.settings.background
        if mix_contrast >= 4.6
          assign muted_text = mix
          break
        endif
      endfor
    %}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-foreground-muted: {{ muted_text }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-button-border: {{ scheme.settings.button }};
      {% # The primary button: filled with the button color, or an outline in it. %}
      --color-primary-button: {% if outline_button %}transparent{% else %}{{ scheme.settings.button }}{% endif %};
      --color-primary-button-label: {% if outline_button %}{{ scheme.settings.button }}{% else %}{{ scheme.settings.button_label }}{% endif %};
      --color-secondary-button: {{ scheme.settings.background }};
      --color-secondary-button-label: {{ scheme.settings.text }};
      --color-secondary-button-border: {{ scheme.settings.text }};
      {% # On hover a filled button mixes toward its label, an outline one fills, and the secondary one tints. %}
      --color-button-hover: {% if outline_button %}{{ scheme.settings.button }}{% else %}color-mix(in oklch, {{ scheme.settings.button }}, {{ scheme.settings.button_label }} 15%){% endif %};
      --color-button-hover-label: {{ scheme.settings.button_label }};
      --color-button-hover-border: var(--color-button-hover);
      --color-secondary-button-hover: color-mix(in oklch, {{ scheme.settings.background }}, {{ scheme.settings.text }} 10%);
      {% # The accent: links in running text, sale prices and badges. %}
      --color-accent: {{ scheme.settings.accent }};
      {% # The border: inputs, bordered cards and chips; dividers take it at half strength. %}
      --color-border: {{ scheme.settings.border }};
      --color-border-subtle: rgb(from {{ scheme.settings.border }} r g b / 0.5);
      --card-background: {{ card_background }};
    }
    .color-{{ scheme.id }} {
      background-color: var(--color-background);
      {% if scheme.settings.background_gradient != blank %}
        background-image: {{ scheme.settings.background_gradient }};
      {% endif %}
      color: var(--color-foreground);
    }
    {% comment %}
      Two neighbours on one scheme share one gap: a section after one on the same scheme drops its top padding,
      unless that one ends in media (media-edge) or has no spacing, where the top padding is the only gap.
    {% endcomment %}
    .shopify-section:has(> .color-{{ scheme.id }}:not(.media-edge, [data-spacing='none'])) + .shopify-section > .color-{{ scheme.id }} {
      --section-spacing-start: 0px;
    }
  {% endfor %}
{% endstyle %}
