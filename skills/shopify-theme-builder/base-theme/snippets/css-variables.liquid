{%- liquid
  # A heading weight other than the font's own loads that weight of the heading font when the family has it.
  assign heading_font = settings.type_heading_font
  assign heading_weight = settings.type_heading_font.weight
  if settings.type_heading_weight != 'font'
    assign heading_weight = settings.type_heading_weight
    assign heading_font = settings.type_heading_font | font_modify: 'weight', heading_weight | default: settings.type_heading_font
  endif
  case settings.type_heading_tracking
    when 'tight'
      assign heading_tracking = '-0.02em'
    when 'wide'
      assign heading_tracking = '0.06em'
    else
      assign heading_tracking = 'normal'
  endcase

  # A button weight other than the body font's own loads that weight of the body font when the family has it.
  assign button_weight = 'var(--font-body--weight)'
  if settings.button_font_weight != 'font'
    assign button_weight = settings.button_font_weight
    assign button_font = settings.type_body_font | font_modify: 'weight', button_weight
  endif
  assign outline_button = false
  if settings.button_primary_style == 'outline'
    assign outline_button = true
  endif

  # The shape family: one radius each for buttons, inputs, cards, media and badges.
  case settings.shape_family
    when 'square'
      assign radius_buttons = '0'
      assign radius_inputs = '0'
      assign radius_cards = '0'
      assign radius_media = '0'
      assign radius_badges = '0'
    when 'round'
      assign radius_buttons = 'var(--style-border-radius-pill)'
      assign radius_inputs = '1.5rem'
      assign radius_cards = '1rem'
      assign radius_media = '1rem'
      assign radius_badges = 'var(--style-border-radius-pill)'
    else
      assign radius_buttons = '0.25rem'
      assign radius_inputs = '0.25rem'
      assign radius_cards = '0.5rem'
      assign radius_media = '0.5rem'
      assign radius_badges = '0.25rem'
  endcase

  # The density: section spacing and grid gaps in px on desktop.
  case settings.density
    when 'compact'
      assign section_spacing = 48
      assign grid_gap = 16
    when 'airy'
      assign section_spacing = 112
      assign grid_gap = 32
    else
      assign section_spacing = 80
      assign grid_gap = 24
  endcase

  case settings.page_width
    when 'narrow'
      assign page_width = '75rem'
    when 'wide'
      assign page_width = '110rem'
    else
      assign page_width = '90rem'
  endcase
-%}
{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_accent_font | font_face: font_display: 'swap' }}
  {% if button_font %}{{ button_font | font_face: font_display: 'swap' }}{% endif %}

  :root {
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ heading_weight }};
    --font-heading--case: {{ settings.type_heading_case }};
    --font-heading--tracking: {{ heading_tracking }};
    --font-body--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body--style: {{ settings.type_body_font.style }};
    --font-body--weight: {{ settings.type_body_font.weight }};
    {% # The accent font: labels and prices. %}
    --font-accent--family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    --font-accent--style: {{ settings.type_accent_font.style }};
    --font-accent--weight: {{ settings.type_accent_font.weight }};
    {% comment %}
      The type scale. Each heading level is the body size times the scale ratio to the power of its step (h4 1, h3 2,
      h2 3, h1 4; h5 halfway between body and h4). h1 to h3 and display are fluid: they reach their size at a 1200px
      viewport (--font-size-fluid is the body size there) and shrink to a ratio half as steep on mobile, which keeps
      their order. Display is its own size, never below h1.
    {% endcomment %}
    --font-scale: {{ settings.type_scale_ratio | divided_by: 100.0 }};
    --font-scale-mobile: calc(1 + (var(--font-scale) - 1) / 2);
    --font-size-body: {{ settings.type_body_size | divided_by: 16.0 }}rem;
    --font-size-fluid: {{ settings.type_body_size | divided_by: 12.0 | round: 4 }}vw;
    --font-size-display: max(var(--font-size-h1), clamp({{ settings.type_display_size | times: 0.64 | divided_by: 16 }}rem, {{ settings.type_display_size | divided_by: 12.0 | round: 4 }}vw, {{ settings.type_display_size | divided_by: 16.0 }}rem));
    --font-size-h1: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 4)), calc(var(--font-size-fluid) * pow(var(--font-scale), 4)), calc(var(--font-size-body) * pow(var(--font-scale), 4)));
    --font-size-h2: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 3)), calc(var(--font-size-fluid) * pow(var(--font-scale), 3)), calc(var(--font-size-body) * pow(var(--font-scale), 3)));
    --font-size-h3: clamp(calc(var(--font-size-body) * pow(var(--font-scale-mobile), 2)), calc(var(--font-size-fluid) * pow(var(--font-scale), 2)), calc(var(--font-size-body) * pow(var(--font-scale), 2)));
    --font-size-h4: calc(var(--font-size-body) * var(--font-scale));
    --font-size-h5: calc(var(--font-size-body) * (1 + var(--font-scale)) / 2);
    --font-size-h6: var(--font-size-body);
    --font-size-small: calc(var(--font-size-body) * 0.875);
    --font-size-label: calc(var(--font-size-body) * 0.75);
    --line-height-display: 1.1;
    --line-height-heading: 1.2;
    --line-height-body: 1.5;
    {% comment %}
      Spacing: padding, margins and gaps take a step of this scale. Sections pad their top and bottom with
      --section-spacing, and grids of items space them with --grid-gap (--grid-row-gap between rows of cards with
      text): both follow the density, halved (the gaps three quarters) on mobile.
    {% endcomment %}
    --space-2xs: 0.25rem;
    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --section-spacing: {{ section_spacing | divided_by: 32.0 }}rem;
    --grid-gap: {{ grid_gap | times: 0.75 | divided_by: 16 }}rem;
    --grid-row-gap: calc(var(--grid-gap) * 1.5);
    {% # Content widths: forms, a text column beside media, a column of running text. %}
    --width-narrow: 30rem;
    --width-text: 40rem;
    --width-prose: 45rem;
    --border-width: {{ settings.border_width }}px;
    --style-border-radius-pill: 999px;
    --style-border-radius-inputs: {{ radius_inputs }};
    --style-border-radius-cards: {{ radius_cards }};
    --style-border-radius-media: {{ radius_media }};
    --style-border-radius-badges: {{ radius_badges }};
    --focus-ring-width: 2px;
    --focus-ring-offset: 2px;
    --opacity-muted: 0.7;
    --opacity-disabled: 0.5;
    {% # Buttons: the shared .button and .button--secondary in critical.css. %}
    --button-padding-block: var(--space-sm);
    --button-padding-inline: var(--space-lg);
    --button-border-width: var(--border-width);
    --button-radius: {{ radius_buttons }};
    --button-text-transform: {{ settings.button_text_case }};
    --button-font-weight: {{ button_weight }};
    {% # Product cards: the shared .product-card in critical.css. A bordered card sets a border width, a card on a surface a background; both pad it. %}
    --card-image-ratio: 1;
    --card-text-align: start;
    --card-border-width: 0;
    --card-padding: 0;
    --card-background: transparent;
    {% comment %}
      The breakpoint is 750px: layouts switch at @media (min-width: 750px) and (max-width: 749px), and image sizes
      at (min-width: 750px). CSS variables don't work in media queries, so it is this constant instead of a variable.
    {% endcomment %}
    --page-width: {{ page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
  }

  @media (min-width: 750px) {
    :root {
      --section-spacing: {{ section_spacing | divided_by: 16.0 }}rem;
      --grid-gap: {{ grid_gap | divided_by: 16.0 }}rem;
    }
  }

  {% # The first color scheme is the page default; sections opt into others with a color-<scheme id> class. %}
  {% # Variables also go on :root, the background only on the class, so it paints the element that uses it. %}
  {% for scheme in settings.color_schemes %}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-button-border: {{ scheme.settings.button }};
      {% # The primary button: filled with the button color, or an outline in it. %}
      --color-primary-button: {% if outline_button %}transparent{% else %}{{ scheme.settings.button }}{% endif %};
      --color-primary-button-label: {% if outline_button %}{{ scheme.settings.button }}{% else %}{{ scheme.settings.button_label }}{% endif %};
      --color-secondary-button: {{ scheme.settings.background }};
      --color-secondary-button-label: {{ scheme.settings.text }};
      --color-secondary-button-border: {{ scheme.settings.text }};
      --color-border: rgb(from var(--color-foreground) r g b / 0.3);
      --color-border-subtle: rgb(from var(--color-foreground) r g b / 0.15);
    }
    .color-{{ scheme.id }} {
      background-color: var(--color-background);
      {% if scheme.settings.background_gradient != blank %}
        background-image: {{ scheme.settings.background_gradient }};
      {% endif %}
      color: var(--color-foreground);
    }
  {% endfor %}
{% endstyle %}
