{% doc %}
  Renders, as a CSS aspect-ratio, the ratio a section's `image_ratio` setting picks for its images: `card`
  follows the Theme's product card ratio, so one page keeps to few ratios; `natural` lets each image keep its own.

  @param {string} ratio - The setting's value: card, portrait, square, landscape or natural

  @example
  <div style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};">
{% enddoc %}
{%- case ratio -%}
  {%- when 'portrait' -%}
    4 / 5
  {%- when 'square' -%}
    1 / 1
  {%- when 'landscape' -%}
    4 / 3
  {%- when 'natural' -%}
    auto
  {%- else -%}
    var(--card-image-ratio)
{%- endcase -%}
