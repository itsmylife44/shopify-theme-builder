{% comment %}A grid of collections, each with its image and title.{% endcomment %}
<div class="collection-list full-width color-{{ section.settings.color_scheme }}">
  <div class="collection-list__inner">
    {% if section.settings.heading != blank %}
      <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul
      class="collection-list__grid"
      role="list"
      style="--columns: {{ section.settings.columns }};"
    >
      {% if section.settings.collections != blank %}
        {% for collection in section.settings.collections %}
          <li>
            <a class="collection-list__card" href="{{ collection.url }}">
              <span class="collection-list__image">
                {% if collection.featured_image %}
                  {{
                    collection.featured_image
                    | image_url: width: 1200
                    | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 50vw', loading: 'lazy', alt: ''
                  }}
                {% else %}
                  {% assign placeholder = forloop.index0 | modulo: 6 | plus: 1 %}
                  {{ 'collection-' | append: placeholder | placeholder_svg_tag: 'collection-list__placeholder' }}
                {% endif %}
              </span>
              <span class="collection-list__title">{{ collection.title | escape }}</span>
            </a>
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.columns) %}
          {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
          <li class="collection-list__card">
            <span class="collection-list__image">
              {{ 'collection-' | append: placeholder | placeholder_svg_tag: 'collection-list__placeholder' }}
            </span>
            <span class="collection-list__title">{{ 'collection_list.collection_title' | t }}</span>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .collection-list {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .collection-list__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  .collection-list__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .collection-list__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .collection-list__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .collection-list__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .collection-list__image img,
  .collection-list__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-list__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .collection-list__title {
    font-size: 1.125rem;
  }

  a.collection-list__card:hover .collection-list__title {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .collection-list a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by collection"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:labels.collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list"
    }
  ]
}
{% endschema %}
