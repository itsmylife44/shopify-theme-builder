{% comment %}Questions and answers that open one at a time.{% endcomment %}
<div class="faq full-width color-{{ section.settings.color_scheme }}">
  <div class="faq__inner">
    {% if section.settings.heading != blank %}
      <h2 class="faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq__list">
      {% for block in section.blocks %}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">{{ block.settings.question | escape }}</summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .faq {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .faq__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .faq__heading {
    text-align: center;
  }

  .faq__list {
    width: 100%;
    max-width: var(--width-prose);
  }

  .faq__item {
    border-bottom: var(--border-width) solid var(--color-border-subtle);
  }

  .faq__question {
    padding-block: var(--space-md);
    font-weight: 600;
    cursor: pointer;
  }

  .faq__answer {
    padding-block-end: var(--space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently asked questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:general.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Ask a question customers often have"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>Answer it clearly, so customers don't need to contact you.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
