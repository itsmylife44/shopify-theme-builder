{% comment %}A grid of products from one collection, under a heading.{% endcomment %}
{% liquid
  assign featured = section.settings.collection
  assign show_products = false
  if featured != blank and featured.products_count > 0
    assign show_products = true
  endif
%}

<div class="featured-collection full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}"{% if section.settings.reveal %} data-reveal{% endif %}>
  <div class="featured-collection__inner">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul
      class="featured-collection__grid"
      data-reveal-stagger
      role="list"
      style="--columns: {{ section.settings.columns }};"
    >
      {% if show_products %}
        {% for product in featured.products limit: section.settings.products_to_show %}
          <li>
            {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, anatomy: section.settings.card_anatomy %}
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
          <li>
            {% render 'product-card', placeholder: placeholder, anatomy: section.settings.card_anatomy %}
          </li>
        {% endfor %}
      {% endif %}
    </ul>

    {% if section.settings.show_view_all and show_products %}
      <a class="button" href="{{ featured.url }}">
        {{- 'featured_collection.view_all' | t: collection: featured.title -}}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-collection {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .featured-collection__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .featured-collection__grid {
    display: grid;
    gap: var(--grid-row-gap) var(--grid-gap);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile: one row that swipes, the next card peeking in, so an odd count never leaves a card alone on a row. */
  @media (max-width: 749px) {
    .featured-collection__grid {
      grid-auto-flow: column;
      grid-auto-columns: 75%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .featured-collection__grid > * {
      scroll-snap-align: start;
    }
  }

  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }









{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_link_to_the_collection",
      "default": true
    },
    {
      "type": "select",
      "id": "card_anatomy",
      "label": "t:labels.card_anatomy",
      "options": [
        {
          "value": "theme",
          "label": "t:options.card_anatomy.theme"
        },
        {
          "value": "minimal",
          "label": "t:options.card_anatomy.minimal"
        },
        {
          "value": "detailed",
          "label": "t:options.card_anatomy.detailed"
        },
        {
          "value": "editorial",
          "label": "t:options.card_anatomy.editorial"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:labels.reveal",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    },
    {
      "name": "t:general.featured_collection_minimal",
      "settings": {
        "card_anatomy": "minimal",
        "products_to_show": 4,
        "columns": 4
      }
    },
    {
      "name": "t:general.featured_collection_detailed",
      "settings": {
        "card_anatomy": "detailed",
        "products_to_show": 8,
        "columns": 4
      }
    },
    {
      "name": "t:general.featured_collection_editorial",
      "settings": {
        "card_anatomy": "editorial",
        "products_to_show": 3,
        "columns": 3,
        "show_quick_add": false
      }
    }
  ]
}
{% endschema %}
