{% comment %}A grid of products from one collection, under a heading.{% endcomment %}
{% liquid
  assign featured = section.settings.collection
  assign show_products = false
  if featured != blank and featured.products_count > 0
    assign show_products = true
  endif
%}

<div class="featured-collection full-width color-{{ section.settings.color_scheme }}">
  <div class="featured-collection__inner">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul
      class="featured-collection__grid"
      role="list"
      style="--columns: {{ section.settings.columns }};"
    >
      {% if show_products %}
        {% for product in featured.products limit: section.settings.products_to_show %}
          <li class="featured-collection__card">
            <a class="featured-collection__image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy'
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'featured-collection__placeholder' }}
              {% endif %}
            </a>
            <a class="featured-collection__title" href="{{ product.url }}">{{ product.title | escape }}</a>
            <p class="featured-collection__price">{{ product.price | money }}</p>
            {% assign unit_variant = product.selected_or_first_available_variant %}
            {% if unit_variant.unit_price_measurement %}
              <p class="featured-collection__unit-price text-small">
                <span class="visually-hidden">{{ 'product.unit_price' | t }}</span>
                {{ unit_variant.unit_price | unit_price_with_measurement: unit_variant.unit_price_measurement }}
              </p>
            {% endif %}
            {% if section.settings.show_quick_add %}
              {% if product.has_only_default_variant and product.requires_selling_plan == false %}
                <form class="featured-collection__quick-add" action="{{ routes.cart_add_url }}" method="post" data-quick-add-form>
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {% if product.available %}
                    <button
                      type="submit"
                      class="featured-collection__quick-add-button"
                      aria-label="{{ 'quick_add.add_label' | t: product: product.title }}"
                    >
                      {{- 'quick_add.add' | t -}}
                    </button>
                  {% else %}
                    <button type="button" class="featured-collection__quick-add-button" disabled>{{ 'product.sold_out' | t }}</button>
                  {% endif %}
                </form>
              {% else %}
                <a
                  class="featured-collection__quick-add-button"
                  href="{{ product.url }}"
                  aria-haspopup="dialog"
                  aria-label="{{ 'quick_add.choose_options_label' | t: product: product.title }}"
                  data-quick-add
                >
                  {{- 'quick_add.choose_options' | t -}}
                </a>
              {% endif %}
            {% endif %}
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
          <li class="featured-collection__card">
            <div class="featured-collection__image">
              {{ 'product-' | append: placeholder | placeholder_svg_tag: 'featured-collection__placeholder' }}
            </div>
            <p class="featured-collection__title">{{ 'featured_collection.product_title' | t }}</p>
            <p class="featured-collection__price">{{ 1999 | money }}</p>
          </li>
        {% endfor %}
      {% endif %}
    </ul>

    {% if section.settings.show_view_all and show_products %}
      <a class="featured-collection__view-all" href="{{ featured.url }}">
        {{- 'featured_collection.view_all' | t: collection: featured.title -}}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-collection {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .featured-collection__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .featured-collection__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .featured-collection__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .featured-collection__image img,
  .featured-collection__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-collection__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .featured-collection__title {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.featured-collection__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .featured-collection__price {
    margin: 0;
  }

  .featured-collection__unit-price {
    margin: 0;
    opacity: 0.7;
  }

  .featured-collection .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .featured-collection__view-all {
    padding: 0.75rem 1.5rem;
    background-color: var(--color-button);
    color: var(--color-button-label);
    text-decoration: none;
  }

  .featured-collection a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .featured-collection__quick-add {
    display: contents;
  }

  .featured-collection__quick-add-button {
    align-self: start;
    margin-block-start: auto;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-button);
    background-color: var(--color-button);
    color: var(--color-button-label);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .featured-collection__quick-add-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_link_to_the_collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
