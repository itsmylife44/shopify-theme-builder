{% comment %}One product with its media, price, variant picker and add to cart button, on any page.{% endcomment %}
{% liquid
  assign product = section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
%}

<div class="featured-product full-width color-{{ section.settings.color_scheme }}">
  <featured-product class="featured-product__inner">
    <div class="featured-product__media">
      {% if featured_media %}
        {{
          featured_media.preview_image
          | image_url: width: 1500
          | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'featured-product__placeholder' }}
      {% endif %}
    </div>

    <div class="featured-product__details">
      {% if product != blank %}
        <h2 class="featured-product__title">
          <a href="{{ product.url }}">{{ product.title | escape }}</a>
        </h2>

        {% capture variant_options %}
          {% for variant in product.variants %}
            {% capture variant_price %}
              {% if variant.compare_at_price > variant.price %}
                <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
                {{ variant.price | money }}
                <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
                <s class="featured-product__compare-at">{{ variant.compare_at_price | money }}</s>
              {% else %}
                {{ variant.price | money }}
              {% endif %}
            {% endcapture %}
            {% if variant.id == current_variant.id %}
              {% assign current_price = variant_price %}
            {% endif %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant_price | strip | escape }}"
              {% if variant.id == current_variant.id %}
                selected
              {% endif %}
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              {{ variant.title | escape }}
              {%- unless variant.available %} - {{ 'product.sold_out' | t }}{% endunless %}
            </option>
          {% endfor %}
        {% endcapture %}
        <p class="featured-product__price">{{ current_price }}</p>

        {% form 'product', product, class: 'featured-product__form' %}
          {% if product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% else %}
            <label class="featured-product__field">
              {{ product.options | join: ' / ' | escape }}
              <select name="id">
                {{ variant_options }}
              </select>
            </label>
          {% endif %}
          <label class="featured-product__field">
            {{ 'product.quantity' | t }}
            <input class="featured-product__quantity" type="number" name="quantity" min="1" value="1">
          </label>
          <button
            type="submit"
            class="featured-product__add"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              {{ 'product.add_to_cart' | t }}
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>
          {% if section.settings.show_dynamic_checkout %}
            {{ form | payment_button }}
          {% endif %}
        {% endform %}
      {% else %}
        <h2 class="featured-product__title">{{ 'featured_collection.product_title' | t }}</h2>
        <p class="featured-product__price">{{ 1999 | money }}</p>
        <button type="button" class="featured-product__add" disabled>{{ 'product.add_to_cart' | t }}</button>
      {% endif %}

      {% content_for 'blocks' %}
    </div>
  </featured-product>
</div>

{% javascript %}
  class FeaturedProduct extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', (event) => {
        if (event.target.name !== 'id') return;
        this.querySelector('.featured-product__price').innerHTML = event.target.selectedOptions[0].dataset.price;
      });
    }
  }

  if (!customElements.get('featured-product')) customElements.define('featured-product', FeaturedProduct);
{% endjavascript %}

{% stylesheet %}
  .featured-product {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .featured-product__inner {
    grid-column: 2;
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
  }

  @media (min-width: 750px) {
    .featured-product__inner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 3rem;
    }
  }

  .featured-product__media img,
  .featured-product__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured-product__placeholder {
    aspect-ratio: 1;
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .featured-product__details,
  .featured-product__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-product__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .featured-product__title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-product__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .featured-product__price {
    font-size: 1.25rem;
  }

  .featured-product__compare-at {
    margin-inline-start: 0.5rem;
    opacity: 0.6;
  }

  .featured-product__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .featured-product__field :is(select, input) {
    padding: 0.5rem;
    border: 1px solid rgb(from var(--color-foreground) r g b / 0.3);
    background-color: transparent;
    color: inherit;
    font: inherit;
  }

  .featured-product__quantity {
    width: 6rem;
  }

  .featured-product__add {
    padding: 0.875rem 1.5rem;
    border: 0;
    background-color: var(--color-button);
    color: var(--color-button-label);
    font: inherit;
    cursor: pointer;
  }

  .featured-product__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .featured-product :is(a, button, input, select):focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .featured-product .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_product",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:labels.show_dynamic_checkout_buttons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom-liquid"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_product"
    }
  ]
}
{% endschema %}
