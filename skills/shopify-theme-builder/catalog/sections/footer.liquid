{% comment %}The shop's footer: the brand's text, menus, social links, an email signup, the country and language selectors, Shop's Follow on Shop button and the payment icons.{% endcomment %}
<footer class="footer full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}">
  <div class="footer__inner">
    <div class="footer__columns">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <div class="footer__text" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2 class="footer__heading text-h6">{{ block.settings.heading | escape }}</h2>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          {% when 'menu' %}
            {% assign menu_label = block.settings.heading | default: block.settings.menu.title %}
            <nav
              class="footer__menu"
              {% if menu_label != blank %}
                aria-label="{{ menu_label | escape }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.heading != blank %}
                <h2 class="footer__heading text-h6">{{ block.settings.heading | escape }}</h2>
              {% endif %}
              <ul class="footer__list" role="list">
                {% for link in block.settings.menu.links %}
                  <li>
                    <a
                      href="{{ link.url }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% when 'social' %}
            {% liquid
              assign social_ids = 'instagram,facebook,tiktok,x,youtube,pinterest' | split: ','
              assign social_names = 'Instagram,Facebook,TikTok,X,YouTube,Pinterest' | split: ','
            %}
            {%- capture social_links -%}
              {%- for id in social_ids -%}
                {%- assign key = 'social_' | append: id -%}
                {%- if settings[key] != blank -%}
                  <li>
                    <a
                      href="{{ settings[key] }}"
                      class="footer__social-link"
                      rel="noopener"
                      target="_blank"
                      aria-label="{{ social_names[forloop.index0] }}"
                    >
                      {%- case id -%}
                        {%- when 'instagram' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                        {%- when 'facebook' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4a22 22 0 0 0-2.5-.1c-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8z"/></svg>
                        {%- when 'tiktok' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.6 3c.4 2.3 1.9 3.9 4.1 4.1v3.1a7.3 7.3 0 0 1-4-1.3v6.4a6.1 6.1 0 1 1-6.1-6.1c.3 0 .7 0 1 .1v3.2a2.9 2.9 0 1 0 2 2.8V3z"/></svg>
                        {%- when 'x' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg>
                        {%- when 'youtube' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z"/></svg>
                        {%- when 'pinterest' -%}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2z"/></svg>
                      {%- endcase -%}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {% if social_links != blank %}
              <div class="footer__social" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="footer__heading text-h6">{{ block.settings.heading | escape }}</h2>
                {% endif %}
                <ul class="footer__social-list" role="list" aria-label="{{ 'footer.social' | t }}">
                  {{ social_links }}
                </ul>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}

      {% if section.settings.show_newsletter %}
        <div class="footer__newsletter">
          {% if section.settings.newsletter_heading != blank %}
            <h2 class="footer__heading text-h6">{{ section.settings.newsletter_heading | escape }}</h2>
          {% endif %}
          {% form 'customer', id: 'FooterNewsletter', class: 'footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="FooterNewsletter-email" class="visually-hidden">{{ 'footer.newsletter_email' | t }}</label>
            <input
              id="FooterNewsletter-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="{{ 'footer.newsletter_email' | t }}"
            >
            <button type="submit" class="button">{{ section.settings.newsletter_button_label | escape }}</button>
            {% if form.posted_successfully? %}
              <p class="footer__newsletter-message" role="status">{{ 'footer.newsletter_success' | t }}</p>
            {% elsif form.errors %}
              <div class="footer__newsletter-message" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      <footer-localization>
        {% form 'localization', id: 'FooterLocalization', class: 'footer__localization text-small' %}
          {% if localization.available_countries.size > 1 %}
            <details class="footer__disclosure" name="footer-localization">
              <summary>
                <span class="footer__disclosure-label">{{ 'localization.country' | t }}</span>
                {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
              </summary>
              <ul class="footer__disclosure-list" role="list">
                {% for country in localization.available_countries %}
                  <li>
                    <button
                      type="submit"
                      name="country_code"
                      value="{{ country.iso_code }}"
                      class="footer__disclosure-option"
                      {% if country.iso_code == localization.country.iso_code %}
                        aria-current="true"
                      {% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </button>
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
          {% if localization.available_languages.size > 1 %}
            <details class="footer__disclosure" name="footer-localization">
              <summary>
                <span class="footer__disclosure-label">{{ 'localization.language' | t }}</span>
                {{ localization.language.endonym_name | capitalize }}
              </summary>
              <ul class="footer__disclosure-list" role="list">
                {% for language in localization.available_languages %}
                  <li>
                    <button
                      type="submit"
                      name="language_code"
                      value="{{ language.iso_code }}"
                      lang="{{ language.iso_code }}"
                      class="footer__disclosure-option"
                      {% if language.iso_code == localization.language.iso_code %}
                        aria-current="true"
                      {% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </button>
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        {% endform %}
      </footer-localization>
    {% endif %}

    <div class="footer__bottom text-small">
      <p>
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}
      </p>

      {% if section.settings.show_follow_on_shop %}
        <div class="footer__follow">
          {{ shop | login_button: action: 'follow' }}
        </div>
      {% endif %}

      {% if section.settings.show_payment_icons %}
        <ul class="footer__payment footer__list" role="list">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-top: auto;
  }

  .footer__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--space-xl);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover,
  .footer a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .footer__heading {
    margin-block-end: var(--space-md);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .footer__newsletter {
    max-width: var(--width-narrow);
  }

  body:has(.shopify-section > .newsletter) .footer__newsletter {
    display: none;
  }

  .footer__newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .footer__newsletter-form input[type='email'] {
    flex: 1 1 12rem;
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    background-color: transparent;
    color: inherit;
  }

  .footer__newsletter-message {
    flex-basis: 100%;
  }

  .footer__text {
    max-width: var(--width-text);
  }

  .footer__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
  }

  .footer__social-link svg {
    width: 20px;
    height: 20px;
  }

  .footer__localization {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
  }

  footer-localization {
    display: contents;
  }

  .footer__disclosure summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    cursor: pointer;
  }

  .footer__disclosure summary::-webkit-details-marker {
    display: none;
  }

  .footer__disclosure summary::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    border-block-end: var(--border-width) solid currentcolor;
    border-inline-end: var(--border-width) solid currentcolor;
    rotate: 225deg;
    translate: 0 0.15em;
  }

  .footer__disclosure[open] summary::after {
    rotate: 45deg;
    translate: 0 -0.15em;
  }

  .footer__disclosure-label {
    color: var(--color-foreground-muted);
  }

  .footer__disclosure-list {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: 0;
    z-index: 10;
    min-width: 12rem;
    max-height: 60vh;
    margin: 0;
    padding: var(--space-xs) var(--space-md);
    overflow-y: auto;
    list-style: none;
    border: var(--border-width) solid var(--color-border-subtle);
    background-color: var(--color-background);
  }

  .footer__disclosure-option {
    display: flex;
    align-items: center;
    width: 100%;
    min-block-size: var(--target-size-min);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .footer__disclosure-option[aria-current='true'],
  .footer__disclosure-option:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .footer__payment {
    flex-direction: row;
    flex-wrap: wrap;
  }

  @media (min-width: 750px) {
    .footer__columns {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .footer__newsletter {
      grid-column: span 2;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FooterLocalization extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.addEventListener(
        'keydown',
        (event) => {
          const open = event.key === 'Escape' && event.target.closest('.footer__disclosure[open]');
          if (!open) return;
          open.open = false;
          open.querySelector('summary').focus();
        },
        { signal }
      );
      document.addEventListener(
        'click',
        (event) => {
          for (const details of this.querySelectorAll('.footer__disclosure[open]')) {
            if (!details.contains(event.target)) details.open = false;
          }
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('footer-localization')) {
    customElements.define('footer-localization', FooterLocalization);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "limit": 1,
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.show_follow_on_shop",
      "info": "t:info.footer_show_follow_on_shop",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:labels.show_newsletter_signup",
      "info": "t:info.footer_show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:labels.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "t:labels.button_label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "t:general.payments"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:general.text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Share what the shop makes, where to find it and when it is open.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:general.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "social",
      "name": "t:general.social_media",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Follow us"
        },
        {
          "type": "paragraph",
          "content": "t:info.social_links_setting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "menu"
        },
        {
          "type": "social"
        }
      ]
    }
  ]
}
{% endschema %}
