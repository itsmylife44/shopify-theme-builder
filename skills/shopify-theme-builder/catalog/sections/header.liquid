{% comment %}The shop's header, in one of three layouts and optionally sticky: the logo or shop name, the menu with dropdowns and a drawer, the country and language selectors, the search box with suggestions, the account link and the cart, in a drawer or on the cart page.{% endcomment %}
{% capture menu_items %}
  {% for link in section.settings.menu.links %}
    <li>
      {% if link.links.size > 0 %}
        <details class="header__submenu" name="header-submenu">
          <summary class="header__menu-link">{{ link.title | escape }}</summary>
          <ul class="header__submenu-list" role="list">
            {% for child in link.links %}
              <li>
                <a
                  class="header__menu-link"
                  href="{{ child.url }}"
                  {% if child.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- child.title | escape -}}
                </a>
                {% if child.links.size > 0 %}
                  <ul class="header__submenu-list" role="list">
                    {% for grandchild in child.links %}
                      <li>
                        <a
                          class="header__menu-link"
                          href="{{ grandchild.url }}"
                          {% if grandchild.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- grandchild.title | escape -}}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </details>
      {% else %}
        <a
          class="header__menu-link"
          href="{{ link.url }}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {% endif %}
    </li>
  {% endfor %}
{% endcapture %}

{% capture header_localization %}
  {% if section.settings.show_localization %}
    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      {% form 'localization', id: 'HeaderLocalization', class: 'header__localization text-small' %}
        {% if localization.available_countries.size > 1 %}
          <label class="visually-hidden" for="HeaderCountry">{{ 'localization.country' | t }}</label>
          <select id="HeaderCountry" name="country_code">
            {% for country in localization.available_countries %}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {% endfor %}
          </select>
        {% endif %}
        {% if localization.available_languages.size > 1 %}
          <label class="visually-hidden" for="HeaderLanguage">{{ 'localization.language' | t }}</label>
          <select id="HeaderLanguage" name="language_code">
            {% for language in localization.available_languages %}
              <option
                value="{{ language.iso_code }}"
                lang="{{ language.iso_code }}"
                {% if language.iso_code == localization.language.iso_code %}
                  selected
                {% endif %}
              >
                {{ language.endonym_name | capitalize }}
              </option>
            {% endfor %}
          </select>
        {% endif %}
        <button type="submit" class="button--secondary">{{ 'localization.update' | t }}</button>
      {% endform %}
    {% endif %}
  {% endif %}
{% endcapture %}

<header
  class="header full-width header--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}
  {%- if section.settings.sticky %} header--sticky{% endif -%}
  "
  style="--logo-height: {{ section.settings.logo_height }}px;"
>
  <header-menu class="header__inner">
    {% if section.settings.menu.links.size > 0 %}
      <button
        type="button"
        class="header__menu-button"
        aria-haspopup="dialog"
        aria-controls="HeaderDrawer"
        aria-label="{{ 'header.menu' | t }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="M3 5.5h14M3 10h14M3 14.5h14" />
        </svg>
      </button>
      <dialog id="HeaderDrawer" class="header__drawer" aria-label="{{ 'header.main_menu' | t }}">
        <div class="header__drawer-inner">
          <form method="dialog">
            <button class="header__drawer-close" aria-label="{{ 'header.close_menu' | t }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m5 5 10 10M15 5 5 15" />
              </svg>
            </button>
          </form>
          <nav aria-label="{{ 'header.main_menu' | t }}">
            <ul class="header__menu-list text-h5" role="list">
              {{ menu_items }}
            </ul>
          </nav>
          {{ header_localization | replace: 'Header', 'HeaderDrawer' }}
        </div>
      </dialog>
    {% endif %}

    <a class="header__logo" href="{{ routes.root_url }}">
      {% if settings.logo %}
        {% assign logo_sizes = settings.logo.aspect_ratio | times: section.settings.logo_height | ceil | append: 'px' %}
        {{
          settings.logo
          | image_url: width: 800
          | image_tag: alt: shop.name, class: 'header__logo-image', widths: '200, 400, 600, 800', sizes: logo_sizes
        }}
      {% elsif settings.logo_asset != blank %}
        {% # theme-check-disable ImgWidthAndHeight %}
        <img
          src="{{ settings.logo_asset | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="header__logo-image header__logo-image--asset"
        >
        {% # theme-check-enable ImgWidthAndHeight %}
      {% else %}
        <span class="header__shop-name text-h3">{{ shop.name | escape }}</span>
      {% endif %}
    </a>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="header__menu" aria-label="{{ 'header.main_menu' | t }}">
        <ul class="header__menu-list" role="list">
          {{ menu_items }}
        </ul>
      </nav>
    {% endif %}

    <div class="header__icons">
      {{ header_localization }}
      {% if section.settings.show_search %}
        <details class="header__search">
          <summary class="header__search-toggle" aria-label="{{ 'header.search' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <circle cx="8.75" cy="8.75" r="5.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12.5 12.5 4 4" />
            </svg>
          </summary>
          <predictive-search class="header__search-panel" data-url="{{ routes.predictive_search_url }}">
            <form action="{{ routes.search_url }}" method="get" role="search">
              <input
                id="HeaderSearch"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'search.placeholder' | t }}"
                aria-label="{{ 'header.search' | t }}"
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="PredictiveSearchResults"
              >
              <input type="hidden" name="options[prefix]" value="last">
              <button type="submit" class="button--secondary">{{ 'search.submit' | t }}</button>
            </form>
            <div
              id="PredictiveSearchResults"
              class="header__search-results"
              role="listbox"
              aria-label="{{ 'search.suggestions' | t }}"
              hidden
            ></div>
          </predictive-search>
        </details>
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      {% capture cart_link %}
        <a class="header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count }}">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <span class="header__cart-count text-label" aria-hidden="true">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endcapture %}
      {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
        <cart-drawer
          class="header__cart-drawer"
          data-cart-url="{{ routes.cart_url }}"
          data-add-url="{{ routes.cart_add_url }}.js"
          data-change-url="{{ routes.cart_change_url }}.js"
          data-section="{{ section.id }}"
          data-sections="main-cart,{{ section.id }}"
        >
          {{ cart_link }}
          <dialog class="header__drawer header__drawer--cart" aria-label="{{ 'cart.title' | t }}">
            <div class="header__drawer-inner">
              <form method="dialog">
                <button class="header__drawer-close" aria-label="{{ 'header.close_cart' | t }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m5 5 10 10M15 5 5 15" />
                  </svg>
                </button>
              </form>
              <p class="header__cart-error" role="alert" hidden></p>
              <div class="header__cart-content"></div>
            </div>
          </dialog>
        </cart-drawer>
      {% else %}
        {{ cart_link }}
      {% endif %}
    </div>
  </header-menu>
</header>

{% stylesheet %}
  .header {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .header__inner {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    position: relative;
    min-height: 5rem;
    padding-block: var(--space-md);
  }

  .header a:not(.button, .button--secondary) {
    color: inherit;
    text-decoration: none;
  }

  .header__logo-image {
    max-height: var(--logo-height);
    width: auto;
  }

  .header__logo-image--asset {
    height: var(--logo-height);
  }

  .shopify-section:has(> .header--sticky) {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
  }

  html:has(.header--sticky) {
    scroll-padding-block-start: var(--header-offset);
  }

  .shopify-section:has(> .header--sticky[data-hidden]) {
    translate: 0 -100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shopify-section:has(> .header--sticky) {
      transition: translate var(--motion-duration) var(--motion-easing);
    }
  }

  .header--logo_center_menu_below .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .header--logo_center_menu_below .header__menu-button {
    grid-area: 1 / 1;
    justify-self: start;
  }

  .header--logo_center_menu_below .header__logo {
    grid-area: 1 / 2;
  }

  .header--logo_center_menu_below .header__icons {
    grid-area: 1 / 3;
    justify-self: end;
  }

  .header--logo_center_menu_below .header__menu {
    grid-area: 2 / 1 / 3 / -1;
    justify-self: center;
  }

  .header--logo_left_drawer .header__icons {
    margin-inline-start: auto;
  }

  .header__shop-name {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
  }

  .header__menu {
    display: none;
  }

  .header__menu-list,
  .header__submenu-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__menu-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-size-min);
  }

  .header__menu-link[aria-current='page'],
  .header__menu-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .header__submenu {
    position: relative;
  }

  .header__submenu summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    cursor: pointer;
  }

  .header__submenu summary::-webkit-details-marker {
    display: none;
  }

  .header__submenu summary::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    border-block-end: var(--border-width) solid currentcolor;
    border-inline-end: var(--border-width) solid currentcolor;
    rotate: 45deg;
    translate: 0 -0.15em;
  }

  .header__submenu[open] summary::after {
    rotate: 225deg;
    translate: 0 0.15em;
  }

  .header__submenu-list {
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__submenu-list .header__submenu-list {
    margin-block-start: var(--space-sm);
    padding-inline-start: var(--space-md);
  }

  .header__menu .header__submenu > .header__submenu-list {
    position: absolute;
    inset-block-start: calc(100% + 1rem);
    inset-inline-start: -1rem;
    z-index: 10;
    min-width: 12rem;
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border-subtle);
    background-color: var(--color-background);
  }

  .header__menu-button,
  .header__drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .header__menu-button svg,
  .header__drawer-close svg {
    width: 2rem;
  }

  .header__drawer {
    width: min(20rem, 85vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .header__drawer--cart {
    width: min(32rem, 100vw);
    margin-inline-start: auto;
  }

  .header__cart-drawer {
    display: contents;
  }

  .header__cart-content .basic-page {
    --content-grid: 0 1fr 0;
    padding-block: 0;
  }

  .header__cart-content a:not(.button, .button--secondary) {
    text-decoration: underline;
  }

  .header__cart-content .main-cart__image {
    width: 5rem;
  }

  .header__drawer::backdrop {
    background-color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }

  .header__drawer-inner {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg);
  }

  .header__drawer .header__menu-list {
    flex-direction: column;
    gap: var(--space-md);
  }

  .header__drawer .header__submenu > .header__submenu-list {
    margin-block-start: var(--space-md);
    padding-inline-start: var(--space-md);
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__icons svg {
    width: 2rem;
  }

  .header__localization {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .header__icons .header__localization {
    flex-wrap: nowrap;
  }

  .header__icons .header__localization select {
    max-width: 10rem;
  }

  .header__drawer .header__localization {
    margin-block-start: auto;
  }

  header-menu:defined .header__localization button {
    display: none;
  }

  .header__localization select {
    padding: var(--space-2xs) var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .header__search summary {
    display: flex;
    list-style: none;
    cursor: pointer;
  }

  .header__search summary::-webkit-details-marker {
    display: none;
  }

  .header__search-panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    z-index: 10;
    display: block;
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border-subtle);
    background-color: var(--color-background);
  }

  .header__search-panel form {
    display: flex;
    gap: var(--space-xs);
  }

  .header__search-panel input {
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: transparent;
    color: inherit;
    font: inherit;
  }

  .header__search-panel input {
    flex: 1;
    min-width: 0;
  }

  .header__search-results {
    max-height: 70vh;
    margin-block-start: var(--space-xs);
    overflow-y: auto;
  }

  .header__cart {
    position: relative;
    display: flex;
  }

  .header__search-toggle,
  .header__cart {
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
  }

  .header__cart-count {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    min-width: 1.25rem;
    padding-inline: var(--space-2xs);
    border-radius: var(--style-border-radius-badges);
    background-color: var(--color-accent);
    color: var(--color-background);
    min-height: 1.25rem;
    display: grid;
    place-items: center;
  }

  @media (max-width: 749px) {
    .header__menu-button ~ .header__icons .header__localization {
      display: none;
    }

    .header__inner {
      flex-wrap: nowrap;
      column-gap: var(--space-xs);
    }

    .header--logo_center_menu_below .header__inner {
      grid-template-columns: minmax(max-content, 1fr) minmax(0, auto) minmax(max-content, 1fr);
    }

    .header__menu-button,
    .header__icons {
      flex-shrink: 0;
    }

    .header__icons {
      gap: 0;
      margin-inline-start: auto;
    }

    .header__logo {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .header__logo-image {
      max-width: 100%;
      object-fit: contain;
    }
  }

  @media (min-width: 750px) {
    .header__inner {
      flex-wrap: nowrap;
    }

    .header__menu {
      display: block;
      min-width: 0;
    }

    .header__menu-button {
      display: none;
    }

    .header--logo_left_drawer .header__menu {
      display: none;
    }

    .header--logo_left_drawer .header__menu-button {
      display: flex;
    }

    .header__drawer .header__localization {
      display: none;
    }
  }

  .quick-add {
    width: min(30rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .quick-add::backdrop {
    background-color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }

  .quick-add__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .quick-add__inner > form[method='dialog'] {
    align-self: end;
  }

  .quick-add__close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .quick-add__close svg {
    width: 2rem;
  }

  .quick-add__summary {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: center;
    gap: var(--space-md);
  }

  .quick-add__media {
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
    background-color: var(--media-background);
  }

  .quick-add__media img,
  .quick-add__placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    padding: var(--media-inset);
    object-fit: var(--media-fit);
    mix-blend-mode: var(--media-blend);
  }

  .quick-add__title {
    margin: 0;
  }

  .quick-add__price,
  .quick-add__plan {
    margin: 0;
  }

  .quick-add__compare-at {
    margin-inline-start: var(--space-xs);
    opacity: var(--opacity-muted);
  }

  .quick-add__option {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .quick-add__option legend {
    margin-block-end: var(--space-xs);
  }

  .quick-add__option-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .quick-add__option-label--unavailable {
    text-decoration: line-through;
    opacity: var(--opacity-muted);
  }

  .quick-add__option-input:checked + .quick-add__option-label {
    background-color: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }

  .quick-add__form {
    display: flex;
    flex-direction: column;
  }

  .quick-add__add {
    width: 100%;
  }

  .quick-add__details {
    align-self: start;
    color: inherit;
    text-underline-offset: 0.3em;
  }
{% endstylesheet %}

{% javascript %}
  class HeaderMenu extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      const drawer = this.querySelector('#HeaderDrawer');
      this.querySelector('.header__menu-button')?.addEventListener('click', () => drawer.showModal(), { signal });
      drawer?.addEventListener('click', (event) => event.target === drawer && drawer.close(), { signal });
      this.addEventListener(
        'change',
        (event) => event.target.form?.classList.contains('header__localization') && event.target.form.requestSubmit(),
        { signal }
      );
      this.addEventListener(
        'keydown',
        (event) => {
          const open = event.key === 'Escape' && event.target.closest('.header__menu details[open], .header__search[open]');
          if (!open) return;
          open.open = false;
          open.querySelector('summary').focus();
        },
        { signal }
      );
      const sticky = this.closest('.header--sticky');
      if (sticky) {
        let lastScroll = scrollY;
        const root = document.documentElement.style;
        const offset = () => root.setProperty('--header-offset', `${sticky.hasAttribute('data-hidden') ? 0 : sticky.offsetHeight}px`);
        const hide = (hidden) => {
          sticky.toggleAttribute('data-hidden', hidden);
          offset();
        };
        addEventListener(
          'scroll',
          () => {
            hide(scrollY > lastScroll && scrollY > sticky.offsetHeight && !this.querySelector('details[open]'));
            lastScroll = scrollY;
          },
          { passive: true, signal }
        );
        this.addEventListener('focusin', () => hide(false), { signal });
        const resize = new ResizeObserver(offset);
        resize.observe(sticky);
        signal.addEventListener('abort', () => {
          resize.disconnect();
          root.removeProperty('--header-offset');
        });
      }
      for (const details of this.querySelectorAll('.header__menu .header__submenu')) {
        const hover = (open) => (event) => {
          if (event.pointerType !== 'mouse') return;
          clearTimeout(details.hoverTimer);
          details.hoverTimer = setTimeout(() => (details.open = open), 300);
        };
        details.addEventListener('pointerenter', hover(true), { signal });
        details.addEventListener('pointerleave', hover(false), { signal });
      }
      document.addEventListener(
        'click',
        (event) => {
          for (const details of this.querySelectorAll('.header__menu details[open], .header__search[open]')) {
            if (!details.contains(event.target)) details.open = false;
          }
        },
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('header-menu')) customElements.define('header-menu', HeaderMenu);

  class PredictiveSearch extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.input = this.querySelector('input[type="search"]');
      this.results = this.querySelector('[role="listbox"]');
      const details = this.closest('details');
      details?.addEventListener('toggle', () => (details.open ? this.input.focus() : this.close()), { signal });
      this.input.addEventListener(
        'input',
        () => {
          clearTimeout(this.timer);
          this.timer = setTimeout(() => this.search(this.input.value.trim()), 300);
        },
        { signal }
      );
      this.input.addEventListener('keydown', (event) => this.onKeydown(event), { signal });
    }

    disconnectedCallback() {
      this.controller.abort();
      this.request?.abort();
      clearTimeout(this.timer);
    }

    async search(terms) {
      this.request?.abort();
      if (!terms) return this.close();
      this.request = new AbortController();
      const url = `${this.dataset.url}?q=${encodeURIComponent(terms)}&resources[type]=query,product,collection,page&resources[limit_scope]=each&section_id=predictive-search`;
      try {
        const response = await fetch(url, { signal: this.request.signal });
        if (!response.ok) throw new Error(`Predictive search failed: ${response.status}`);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        this.results.innerHTML = html.querySelector('.predictive-search')?.innerHTML ?? '';
        const expanded = Boolean(this.results.querySelector('[role="option"]'));
        this.results.hidden = !expanded;
        this.input.setAttribute('aria-expanded', String(expanded));
        this.input.removeAttribute('aria-activedescendant');
      } catch (error) {
        if (error.name !== 'AbortError') this.close();
      }
    }

    close() {
      this.results.hidden = true;
      this.input.setAttribute('aria-expanded', 'false');
      this.input.removeAttribute('aria-activedescendant');
    }

    onKeydown(event) {
      if (this.results.hidden) return;
      const options = [...this.results.querySelectorAll('[role="option"]')];
      const current = options.findIndex((option) => option.getAttribute('aria-selected') === 'true');
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopPropagation();
        this.close();
      } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const next = current === -1 ? (step === 1 ? 0 : options.length - 1) : (current + step + options.length) % options.length;
        for (const option of options) option.setAttribute('aria-selected', String(option === options[next]));
        this.input.setAttribute('aria-activedescendant', options[next].id);
        options[next].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && current !== -1) {
        event.preventDefault();
        options[current].click();
      }
    }
  }

  if (!customElements.get('predictive-search')) customElements.define('predictive-search', PredictiveSearch);

  class CartDrawer extends HTMLElement {
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.dialog = this.querySelector('dialog');
      this.addEventListener('click', (event) => this.onClick(event), { signal });
      this.addEventListener('change', (event) => {
        const input = event.target.closest('input[data-line]');
        if (input) this.change(input.dataset.line, input.value);
      }, { signal });
      this.dialog.addEventListener(
        'close',
        () => (this.opener?.isConnected ? this.opener : this.querySelector('.header__cart'))?.focus(),
        { signal }
      );
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    async onClick(event) {
      if (event.target === this.dialog) return this.dialog.close();
      const remove = event.target.closest('a[data-line]');
      if (remove) {
        event.preventDefault();
        return this.change(remove.dataset.line, 0);
      }
      const link = event.target.closest('.header__cart');
      if (!link) return;
      event.preventDefault();
      const html = await fetch(`${this.dataset.cartUrl}?section_id=main-cart`)
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!html) return location.assign(link.href);
      this.render({ 'main-cart': html });
      this.open(link);
    }

    async add(form, opener) {
      const body = new FormData(form);
      body.append('sections', this.dataset.sections);
      const response = await fetch(this.dataset.addUrl, { method: 'POST', headers: { Accept: 'application/json' }, body }).catch(() => null);
      if (!response?.ok) return form.submit();
      this.render((await response.json()).sections);
      this.open(opener);
    }

    async change(line, quantity) {
      const response = await fetch(this.dataset.changeUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: Number(line), quantity: Number(quantity), sections: this.dataset.sections }),
      }).catch(() => null);
      const json = await response?.json().catch(() => null);
      if (response?.ok) return this.render(json.sections);
      const error = this.querySelector('.header__cart-error');
      error.textContent = json?.description ?? json?.message ?? '';
      error.hidden = false;
    }

    render(sections) {
      this.querySelector('.header__cart-error').hidden = true;
      const parse = (html) => new DOMParser().parseFromString(html ?? '', 'text/html');
      const line = document.activeElement?.closest('input[data-line]')?.dataset.line;
      const cart = parse(sections?.['main-cart']).querySelector('.main-cart');
      if (cart) this.querySelector('.header__cart-content').replaceChildren(cart);
      const link = parse(sections?.[this.dataset.section]).querySelector('.header__cart');
      if (link) this.querySelector('.header__cart').replaceWith(link);
      if (this.dialog.open && !this.dialog.contains(document.activeElement)) {
        (this.querySelector(`input[data-line="${line}"]`) ?? this.querySelector('.header__drawer-close')).focus();
      }
    }

    open(opener) {
      this.opener = opener;
      if (!this.dialog.open) this.dialog.showModal();
    }
  }

  if (!customElements.get('cart-drawer')) customElements.define('cart-drawer', CartDrawer);

  class QuickAddDialog extends HTMLElement {
    static async load(url, optionValues, signal) {
      const target = new URL(url, location.origin);
      target.searchParams.set('section_id', 'quick-add');
      if (optionValues) target.searchParams.set('option_values', optionValues);
      const text = await fetch(target, { signal })
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      return text ? new DOMParser().parseFromString(text, 'text/html').querySelector('quick-add-dialog') : null;
    }

    static async open(trigger) {
      const fresh = await QuickAddDialog.load(trigger.href);
      if (!fresh) return location.assign(trigger.href);
      document.querySelector('quick-add-dialog')?.remove();
      document.body.append(fresh);
      fresh.show(trigger);
    }

    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.dialog = this.querySelector('dialog');
      this.dialog.addEventListener('click', (event) => event.target === this.dialog && this.dialog.close(), { signal });
      this.dialog.addEventListener('close', () => this.opener?.focus(), { signal });
      this.addEventListener('change', (event) => this.onChange(event), { signal });
      this.addEventListener('submit', (event) => this.onSubmit(event), { signal });
    }

    disconnectedCallback() {
      this.controller.abort();
      this.request?.abort();
    }

    show(opener) {
      this.opener = opener;
      this.dialog.showModal();
    }

    async onChange(event) {
      const input = event.target.closest('[data-option-value-id]');
      if (!input) return;
      const optionValues = [...this.querySelectorAll('[data-option-value-id]:checked')]
        .map((option) => option.dataset.optionValueId)
        .join(',');
      this.request?.abort();
      this.request = new AbortController();
      const url = input.dataset.productUrl || this.querySelector('.quick-add__inner').dataset.url;
      const fresh = await QuickAddDialog.load(url, optionValues, this.request.signal);
      const inner = fresh?.querySelector('.quick-add__inner');
      if (!inner) return;
      this.querySelector('.quick-add__inner').replaceWith(inner);
      document.getElementById(input.id)?.focus();
    }

    onSubmit(event) {
      if (event.target.method === 'dialog') return;
      const drawer = document.querySelector('cart-drawer');
      if (!drawer?.add) return;
      event.preventDefault();
      this.dialog.close();
      drawer.add(event.target, this.opener);
    }
  }

  if (!customElements.get('quick-add-dialog')) {
    customElements.define('quick-add-dialog', QuickAddDialog);

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-quick-add]');
      if (!trigger || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      QuickAddDialog.open(trigger);
    });

    document.addEventListener('submit', (event) => {
      if (!event.target.closest('[data-quick-add-form]')) return;
      const drawer = document.querySelector('cart-drawer');
      if (!drawer?.add) return;
      event.preventDefault();
      drawer.add(event.target, event.submitter);
    });
  }
{% endjavascript %}

