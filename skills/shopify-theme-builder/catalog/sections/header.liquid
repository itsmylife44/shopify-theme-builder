{% comment %}The shop's header: the logo or shop name, the menu, the country and language selectors, the search link, the account link and the cart.{% endcomment %}
<header class="header full-width color-{{ section.settings.color_scheme }}">
  <div class="header__inner">
    <a class="header__logo" href="{{ routes.root_url }}">
      {% if settings.logo %}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag: alt: shop.name, class: 'header__logo-image', widths: '200, 400', sizes: '200px'
        }}
      {% elsif settings.logo_asset != blank %}
        {% # theme-check-disable ImgWidthAndHeight %}
        <img
          src="{{ settings.logo_asset | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="header__logo-image header__logo-image--asset"
        >
        {% # theme-check-enable ImgWidthAndHeight %}
      {% else %}
        <span class="header__shop-name">{{ shop.name | escape }}</span>
      {% endif %}
    </a>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="header__menu" aria-label="{{ 'header.main_menu' | t }}">
        <ul class="header__menu-list" role="list">
          {% for link in section.settings.menu.links %}
            <li>
              <a
                class="header__menu-link"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <div class="header__icons">
      {% if section.settings.show_localization %}
        {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
          {% form 'localization', id: 'HeaderLocalization', class: 'header__localization' %}
            {% if localization.available_countries.size > 1 %}
              <label class="visually-hidden" for="HeaderCountry">{{ 'localization.country' | t }}</label>
              <select id="HeaderCountry" name="country_code">
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            {% if localization.available_languages.size > 1 %}
              <label class="visually-hidden" for="HeaderLanguage">{{ 'localization.language' | t }}</label>
              <select id="HeaderLanguage" name="language_code">
                {% for language in localization.available_languages %}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ language.endonym_name | capitalize }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}
            <button type="submit">{{ 'localization.update' | t }}</button>
          {% endform %}
        {% endif %}
      {% endif %}
      {% if section.settings.show_search %}
        <a class="header__search" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="8.75" cy="8.75" r="5.25" stroke="currentColor" stroke-width="var(--icon-stroke-width)" />
            <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12.5 12.5 4 4" />
          </svg>
        </a>
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'header.cart' | t: count: cart.item_count }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .header__inner {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    min-height: 5rem;
    padding-block: 1rem;
  }

  .header a {
    color: inherit;
    text-decoration: none;
  }

  .header a:focus-visible,
  .header select:focus-visible,
  .header button:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .header__logo-image {
    max-height: 3rem;
    width: auto;
  }

  .header__logo-image--asset {
    height: 3rem;
  }

  .header__shop-name {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.5rem;
  }

  .header__menu {
    order: 3;
    flex-basis: 100%;
  }

  .header__menu-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .header__menu-link[aria-current='page'],
  .header__menu-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__icons svg {
    width: 2rem;
  }

  .header__localization {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .header__localization select,
  .header__localization button {
    padding: 0.25rem 0.5rem;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
    background-color: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .header .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .header__search {
    display: flex;
  }

  .header__cart {
    position: relative;
    display: flex;
  }

  .header__cart-count {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-end: -0.5rem;
    min-width: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: 1rem;
    background-color: var(--color-button);
    color: var(--color-button-label);
    font-size: 0.75rem;
    line-height: 1.25rem;
    text-align: center;
  }

  @media (min-width: 750px) {
    .header__menu {
      order: 0;
      flex-basis: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "tag": "section",
  "enabled_on": {
    "groups": ["header"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:info.logo_setting"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:labels.show_localization",
      "info": "t:info.header_show_localization",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.header"
    }
  ]
}
{% endschema %}
