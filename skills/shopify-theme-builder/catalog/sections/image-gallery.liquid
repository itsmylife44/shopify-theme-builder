{% comment %}A grid of images, each with an optional caption and link.{% endcomment %}
<div class="image-gallery full-width color-{{ section.settings.color_scheme }}">
  <div class="image-gallery__inner">
    {% if section.settings.heading != blank %}
      <h2 class="image-gallery__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul
      class="image-gallery__grid"
      role="list"
      style="--columns: {{ section.settings.columns }};"
    >
      {% for block in section.blocks %}
        <li class="image-gallery__item" {{ block.shopify_attributes }}>
          <figure class="image-gallery__figure">
            {% if block.settings.link != blank %}
              <a class="image-gallery__link" href="{{ block.settings.link }}">
            {% endif %}
            <div class="image-gallery__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 50vw', loading: 'lazy'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'image-gallery__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.caption != blank %}
              <figcaption class="image-gallery__caption">{{ block.settings.caption | escape }}</figcaption>
            {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </figure>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .image-gallery {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .image-gallery__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  .image-gallery__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
  }

  .image-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .image-gallery__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
      gap: 1.5rem;
    }
  }

  .image-gallery__figure {
    margin: 0;
  }

  .image-gallery__link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .image-gallery__link:hover .image-gallery__caption {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .image-gallery__link:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .image-gallery__media {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .image-gallery__media img,
  .image-gallery__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-gallery__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .image-gallery__caption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_gallery",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Gallery"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:general.image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:labels.caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.image_gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
