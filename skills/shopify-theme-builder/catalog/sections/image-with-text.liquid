{% comment %}An image beside a heading, text and a button.{% endcomment %}
<div class="image-with-text full-width image-with-text--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }}">
  <div class="image-with-text__inner">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder image-with-text__placeholder' }}
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.heading != blank %}
        <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-with-text__text rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .image-with-text__inner {
    grid-column: 2;
    display: grid;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  @media (min-width: 750px) {
    .image-with-text__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .image-with-text--image-right .image-with-text__media {
      order: 1;
    }
  }

  .image-with-text__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
    background-color: var(--media-background);
  }

  .image-with-text__media img,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    padding: var(--media-inset);
    object-fit: var(--media-fit);
    mix-blend-mode: var(--media-blend);
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position_on_desktop",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Pair text with an image to tell the story of your brand or a product.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ]
}
{% endschema %}
