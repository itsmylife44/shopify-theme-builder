{% comment %}An image beside a heading, text and a button.{% endcomment %}
{% liquid
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  assign heading_tag = 'h2'
  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
    assign heading_tag = 'h1'
  endif
%}
<div class="image-with-text full-width image-with-text--{{ section.settings.layout }} image-with-text--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }}{% if section.settings.layout == 'full_bleed' %} media-edge{% endif %}" data-spacing="{{ section.settings.spacing }}"{% if section.settings.reveal %} data-reveal{% endif %} style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};">
  <div class="image-with-text__inner">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: loading, fetchpriority: fetchpriority
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder image-with-text__placeholder' }}
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.heading != blank %}
        <{{ heading_tag }} class="image-with-text__heading text-h2">{{ section.settings.heading }}</{{ heading_tag }}>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-with-text__text rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .image-with-text__inner {
    grid-column: 2;
    display: grid;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .image-with-text--full_bleed .image-with-text__inner {
    grid-column: 1 / -1;
    gap: 0;
    padding-block: 0;
  }

  .image-with-text--full_bleed .image-with-text__content {
    justify-self: center;
    max-width: var(--width-text);
    padding: var(--section-spacing) var(--page-margin);
  }

  @media (min-width: 750px) {
    .image-with-text__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .image-with-text--image-right .image-with-text__media {
      order: 1;
    }

    .image-with-text--overlap .image-with-text__inner {
      grid-template-columns: repeat(6, 1fr);
      gap: 0;
    }

    .image-with-text--overlap .image-with-text__media {
      grid-row: 1;
      grid-column: 1 / 5;
    }

    .image-with-text--overlap .image-with-text__content {
      z-index: 1;
      grid-row: 1;
      grid-column: 4 / 7;
      background-color: var(--color-background);
      padding: var(--space-2xl);
      border-radius: var(--style-border-radius-cards);
    }

    .image-with-text--overlap.image-with-text--image-right .image-with-text__media {
      grid-column: 3 / 7;
    }

    .image-with-text--overlap.image-with-text--image-right .image-with-text__content {
      grid-column: 1 / 4;
    }

    .image-with-text--full_bleed .image-with-text__content {
      padding: var(--section-spacing) var(--space-2xl);
    }
  }

  .image-with-text__media {
    aspect-ratio: var(--image-ratio);
    overflow: hidden;
  }

  .image-with-text:not(.image-with-text--full_bleed) .image-with-text__media {
    border-radius: var(--style-border-radius-media);
  }

  .image-with-text__media img,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "card", "label": "t:options.image_ratio.card" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "natural", "label": "t:options.image_ratio.natural" }
      ],
      "default": "card"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "side_by_side", "label": "t:options.layout.side_by_side" },
        { "value": "overlap", "label": "t:options.layout.overlap" },
        { "value": "full_bleed", "label": "t:options.layout.full_bleed" }
      ],
      "default": "side_by_side"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position_on_desktop",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Pair text with an image to tell the story of your brand or a product.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:labels.reveal",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    },
    {
      "name": "t:general.image_with_text_right",
      "settings": {
        "image_position": "right"
      }
    },
    {
      "name": "t:general.image_with_text_overlap",
      "settings": {
        "layout": "overlap"
      }
    },
    {
      "name": "t:general.image_with_text_full_bleed",
      "settings": {
        "layout": "full_bleed"
      }
    }
  ]
}
{% endschema %}
