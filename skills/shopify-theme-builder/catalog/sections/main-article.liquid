{% comment %}The article page: image, title, date, author, content and tags, with paginated comments and a comment form when the blog allows them.{% endcomment %}
<article class="main-article basic-page full-width color-{{ section.settings.color_scheme }}">
  {% if article.image %}
    {{
      article.image
      | image_url: width: 2000
      | image_tag: class: 'main-article__image', widths: '750, 1100, 1500, 2000', sizes: '100vw'
    }}
  {% elsif request.design_mode %}
    {{ 'image' | placeholder_svg_tag: 'main-article__image main-article__placeholder' }}
  {% endif %}

  <header class="main-article__header">
    <h1>{{ article.title | escape }}</h1>
    {% assign date = article.published_at | time_tag: format: 'date' %}
    {% assign author = article.author | escape %}
    <p class="main-article__meta text-small">
      {% if section.settings.show_author %}
        {{ 'blog.article_metadata_html' | t: date: date, author: author }}
      {% else %}
        {{ date }}
      {% endif %}
    </p>
  </header>

  <div class="basic-page__text">{{ article.content }}</div>

  {% if article.tags.size > 0 %}
    <nav class="main-article__tags" aria-label="{{ 'blog.tags' | t }}">
      <ul role="list">
        {% for tag in article.tags %}
          <li>
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  {% if blog.comments_enabled? %}
    <div id="comments" class="main-article__comments">
      {% if article.comments_count > 0 %}
        <h2>{{ 'blog.article_comments' | t }}</h2>

        {% paginate article.comments by 10 %}
          <ul role="list">
            {% for comment in article.comments %}
              <li class="main-article__comment">
                <p class="main-article__meta text-small">
                  <strong>{{ comment.author | escape }}</strong>
                  {{ comment.created_at | time_tag: format: 'date' }}
                </p>
                <div>{{ comment.content }}</div>
              </li>
            {% endfor %}
          </ul>

          {% if paginate.pages > 1 %}
            <nav class="main-article__pagination" aria-label="{{ 'collection.pagination' | t }}">
              {{ paginate | default_pagination: anchor: 'comments' }}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% endif %}

      {% form 'new_comment', article, class: 'basic-page__form' %}
        <h2>{{ 'blog.comment_form_title' | t }}</h2>

        {% if form.posted_successfully? %}
          <p role="status">
            {% if blog.moderated? %}
              {{ 'blog.comment_moderated' | t }}
            {% else %}
              {{ 'blog.comment_posted' | t }}
            {% endif %}
          </p>
        {% elsif form.errors %}
          <div role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="basic-page__field">
          <label for="Comment-author-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
          <input type="text" name="comment[author]" id="Comment-author-{{ section.id }}" value="{{ form.author }}" autocomplete="name" required>
        </div>

        <div class="basic-page__field">
          <label for="Comment-email-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
          <input type="email" name="comment[email]" id="Comment-email-{{ section.id }}" value="{{ form.email }}" autocomplete="email" required>
        </div>

        <div class="basic-page__field">
          <label for="Comment-body-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
          <textarea name="comment[body]" id="Comment-body-{{ section.id }}" rows="5" required>{{ form.body }}</textarea>
        </div>

        <button type="submit">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </div>
  {% endif %}
</article>

{% stylesheet %}
  .main-article .main-article__image {
    grid-column: 1 / -1;
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
  }

  .main-article__placeholder {
    height: 32rem;
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .main-article__header,
  .main-article__comments {
    display: grid;
    gap: 1rem;
    max-width: 45rem;
  }

  .main-article__header h1,
  .main-article__header p {
    margin: 0;
  }

  .main-article__meta {
    margin: 0;
    opacity: 0.7;
  }

  .main-article .basic-page__text img {
    max-width: 100%;
    height: auto;
  }

  .main-article__tags ul,
  .main-article__comments ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-article__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .main-article__tags a {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgb(from var(--color-foreground) r g b / 0.3);
    border-radius: 999px;
    text-decoration: none;
  }

  .main-article__comment {
    display: grid;
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: 1px solid rgb(from var(--color-foreground) r g b / 0.2);
  }

  .main-article__pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .main-article__pagination :is(a, span) {
    padding: 0.25rem 0.75rem;
  }

  .main-article__pagination .current {
    font-weight: bold;
  }

  .main-article a:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_article",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.main_article"
    }
  ]
}
{% endschema %}
