{% comment %}The blog page: its articles as cards with image, title, date and excerpt, with tag links and pagination.{% endcomment %}
<div class="main-blog full-width color-{{ section.settings.color_scheme }}">
  <div class="main-blog__inner">
    <h1 class="main-blog__title">{{ blog.title | escape }}</h1>

    {% if blog.all_tags.size > 0 %}
      <nav class="main-blog__tags" aria-label="{{ 'blog.tags' | t }}">
        <ul role="list">
          <li>
            <a href="{{ blog.url }}" {% if current_tags == blank %}aria-current="page"{% endif %}>
              {{- 'blog.all_tags' | t -}}
            </a>
          </li>
          {% for tag in blog.all_tags %}
            <li>
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                {{- tag | escape -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    {% paginate blog.articles by section.settings.articles_per_page %}
      {% if blog.articles.size > 0 %}
        <ul class="main-blog__grid" role="list" style="--columns: {{ section.settings.columns }};">
          {% for article in blog.articles %}
            <li class="main-blog__card">
              <a class="main-blog__image" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                {% if article.image %}
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder main-blog__placeholder' }}
                {% endif %}
              </a>
              <h2 class="main-blog__article-title text-h4">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>
              {% assign date = article.published_at | time_tag: format: 'date' %}
              {% assign author = article.author | escape %}
              <p class="main-blog__meta text-small">
                {% if section.settings.show_author %}
                  {{ 'blog.article_metadata_html' | t: date: date, author: author }}
                {% else %}
                  {{ date }}
                {% endif %}
              </p>
              <p class="main-blog__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            </li>
          {% endfor %}
        </ul>

        {% if paginate.pages > 1 %}
          <nav class="main-blog__pagination" aria-label="{{ 'collection.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% elsif request.design_mode %}
        <ul class="main-blog__grid" role="list" style="--columns: {{ section.settings.columns }};">
          {% for i in (1..section.settings.columns) %}
            <li class="main-blog__card">
              <div class="main-blog__image">
                {{ 'image' | placeholder_svg_tag: 'placeholder main-blog__placeholder' }}
              </div>
              <h2 class="main-blog__article-title text-h4">{{ 'blog_posts.article_title' | t }}</h2>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>{{ 'blog.empty' | t }}</p>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .main-blog {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-blog__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .main-blog__title {
    margin: 0;
  }

  .main-blog__tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-blog__tags a {
    display: inline-block;
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-badges);
    color: inherit;
    text-decoration: none;
  }

  .main-blog__tags a[aria-current] {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .main-blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .main-blog__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .main-blog__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .main-blog__image {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
  }

  .main-blog__image img,
  .main-blog__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-blog__article-title {
    margin: 0;
  }

  .main-blog__article-title a {
    color: inherit;
    text-decoration: none;
  }

  .main-blog__article-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .main-blog__meta {
    margin: 0;
    opacity: var(--opacity-muted);
  }

  .main-blog__excerpt {
    margin: 0;
  }

  .main-blog__pagination {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .main-blog__pagination :is(a, span) {
    padding: var(--space-2xs) var(--space-sm);
    color: inherit;
  }

  .main-blog__pagination .current {
    font-weight: bold;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_blog",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:labels.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.main_blog"
    }
  ]
}
{% endschema %}
