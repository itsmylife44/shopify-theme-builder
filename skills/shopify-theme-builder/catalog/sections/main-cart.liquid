{% comment %}The cart page's items, discounts, free-shipping progress, order note, checkout and accelerated checkout buttons.{% endcomment %}
<div class="main-cart basic-page full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}">
  <h1>{{ 'cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="main-cart__form">
      <table class="main-cart__items">
        <thead>
          <tr>
            <th scope="col">{{ 'cart.product' | t }}</th>
            <th scope="col">{{ 'cart.quantity' | t }}</th>
            <th scope="col">{{ 'cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <div class="main-cart__product">
                  {% if item.image %}
                    {% render 'image', class: 'main-cart__image', image: item.image, url: item.url, width: 160, height: 160, crop: 'center', sizes: '5rem' %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'main-cart__image placeholder' }}
                  {% endif %}
                  <div>
                    <p>{{ item.product.title | escape | link_to: item.url }}</p>
                    {% unless item.product.has_only_default_variant %}
                      <p>{{ item.variant.title | escape }}</p>
                    {% endunless %}
                    {% if item.selling_plan_allocation %}
                      <p class="main-cart__muted">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                    {% endif %}
                    {% for property in item.properties %}
                      {% assign first_character = property.first | slice: 0 %}
                      {% if property.last != blank and first_character != '_' %}
                        <p class="main-cart__muted">{{ property.first | escape }}: {{ property.last | escape }}</p>
                      {% endif %}
                    {% endfor %}
                    <p class="price">
                      {% if item.original_price > item.final_price %}
                        <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
                        {{ item.final_price | money }}
                        <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
                        <s class="main-cart__muted">{{ item.original_price | money }}</s>
                      {% else %}
                        {{ item.final_price | money }}
                      {% endif %}
                    </p>
                    {% if item.unit_price_measurement %}
                      <p class="main-cart__muted">
                        <span class="visually-hidden">{{ 'cart.unit_price' | t }}</span>
                        {{ item.unit_price | money }}/
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{- item.unit_price_measurement.reference_unit -}}
                      </p>
                    {% endif %}
                    {% if item.line_level_discount_allocations != empty %}
                      <ul class="main-cart__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
                        {% for allocation in item.line_level_discount_allocations %}
                          <li>{{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                    <p>
                      <a
                        href="{{ item.url_to_remove }}"
                        data-line="{{ forloop.index }}"
                        aria-label="{{ 'cart.remove_item' | t: product: item.product.title | escape }}"
                      >
                        {{- 'cart.remove' | t -}}
                      </a>
                    </p>
                  </div>
                </div>
              </td>
              <td>
                <label for="Quantity-{{ section.id }}-{{ forloop.index }}" class="visually-hidden">
                  {{- 'cart.quantity_for' | t: product: item.product.title | escape -}}
                </label>
                <input
                  id="Quantity-{{ section.id }}-{{ forloop.index }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  data-line="{{ forloop.index }}"
                >
              </td>
              <td class="price">
                {% if item.original_line_price > item.final_line_price %}
                  <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
                  <s class="main-cart__muted">{{ item.original_line_price | money }}</s>
                  <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
                {% endif %}
                {{ item.final_line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="main-cart__footer">
        {% if section.settings.show_note %}
          <div class="main-cart__note basic-page__field">
            <label for="CartNote-{{ section.id }}">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote-{{ section.id }}" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
        {% endif %}

        <div class="main-cart__summary">
          {% if cart.cart_level_discount_applications != empty %}
            <ul class="main-cart__discounts" role="list" aria-label="{{ 'cart.discounts' | t }}">
              {% for discount in cart.cart_level_discount_applications %}
                <li>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if settings.free_shipping_threshold > 0 and cart.currency.iso_code == shop.currency %}
            {% liquid
              assign threshold = settings.free_shipping_threshold | times: 100 | round
              assign progress = cart.total_price | at_most: threshold
              assign remaining = threshold | minus: cart.total_price | money
            %}
            <div class="main-cart__shipping">
              <p id="FreeShipping-{{ section.id }}">
                {%- if progress < threshold -%}
                  {{- 'cart.free_shipping_remaining' | t: amount: remaining -}}
                {%- else -%}
                  {{- 'cart.free_shipping' | t -}}
                {%- endif -%}
              </p>
              <progress aria-labelledby="FreeShipping-{{ section.id }}" max="{{ threshold }}" value="{{ progress }}"></progress>
            </div>
          {% endif %}
          <p class="main-cart__subtotal price text-h4">
            {{ 'cart.subtotal' | t }}
            {{ cart.total_price | money_with_currency }}
          </p>
          <p class="rte">{%- render 'tax-note' -%}</p>
          <div class="main-cart__actions">
            <button type="submit" name="update" class="button--secondary">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </div>
    </form>

    {% if additional_checkout_buttons and section.settings.show_additional_checkout_buttons %}
      <div class="main-cart__additional-checkout">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {% endif %}
  {% else %}
    <p>{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">
      {{- 'cart.continue_shopping' | t -}}
    </a>
  {% endif %}
</div>

{% javascript %}
  document.addEventListener('change', (event) => {
    if (!event.target.matches('.main-cart__note textarea')) return;
    fetch(`${window.Shopify?.routes?.root ?? '/'}cart/update.js`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note: event.target.value }),
    });
  });
{% endjavascript %}

{% stylesheet %}
  .main-cart__form {
    display: grid;
    gap: var(--space-xl);
  }

  .main-cart__items {
    width: 100%;
    border-collapse: collapse;
  }

  .main-cart__items th {
    font-weight: inherit;
    text-align: start;
    color: var(--color-foreground-muted);
  }

  .main-cart__items :is(th, td) {
    padding-block: var(--space-md);
    padding-inline: 0 var(--space-md);
    border-bottom: var(--border-width) solid var(--color-border-subtle);
    vertical-align: top;
  }

  .main-cart__items :is(th, td):last-child {
    padding-inline-end: 0;
    text-align: end;
  }

  .main-cart__product {
    display: flex;
    gap: var(--space-md);
  }

  .main-cart__product > div > * + * {
    margin-top: var(--space-2xs);
  }

  .main-cart__image {
    flex: 0 0 5rem;
    width: 5rem;
    height: auto;
    border-radius: var(--style-border-radius-media);
  }

  .main-cart__items input {
    width: 5rem;
  }

  .main-cart__muted {
    color: var(--color-foreground-muted);
  }

  .main-cart__discounts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-cart__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-xl);
  }

  .main-cart__note {
    flex: 1 1 18rem;
    max-width: var(--width-narrow);
  }

  .main-cart__summary {
    display: grid;
    justify-items: end;
    gap: var(--space-sm);
    margin-inline-start: auto;
    text-align: end;
  }

  .main-cart__shipping {
    display: grid;
    gap: var(--space-2xs);
    width: min(100%, 20rem);
  }

  .main-cart__shipping progress {
    width: 100%;
    accent-color: var(--color-accent);
  }

  .main-cart__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: var(--space-xs);
  }

  .main-cart__additional-checkout {
    justify-self: end;
    width: min(100%, 20rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_cart",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_additional_checkout_buttons",
      "label": "t:labels.show_accelerated_checkout_buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:labels.show_order_note",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    }
  ],
  "presets": [
    {
      "name": "t:general.main_cart"
    }
  ]
}
{% endschema %}
