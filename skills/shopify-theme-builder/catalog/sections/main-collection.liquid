{% comment %}The collection page's product grid, with filters and sorting.{% endcomment %}
{% liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif
  assign placeholder_count = section.settings.columns | times: 2
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  assign show_placeholders = false
  if collection.all_products_count == 0 and collections.all.all_products_count == 0
    assign show_placeholders = true
  endif
%}

<div class="main-collection full-width color-{{ section.settings.color_scheme }}">
  <div class="main-collection__inner">
    <div class="main-collection__header">
      <h1 class="main-collection__title">{{ collection.title }}</h1>
      {% if section.settings.show_description and collection.description != blank %}
        <div class="main-collection__description rte">{{ collection.description }}</div>
      {% endif %}
    </div>

    {% if show_filters or section.settings.enable_sorting %}
      <collection-facets>
        <form class="main-collection__facets" action="{{ collection.url }}" method="get">
          {% if show_filters %}
            {% for filter in collection.filters %}
              <details class="main-collection__filter">
                <summary>{{ filter.label | escape }}</summary>
                <div class="main-collection__filter-values">
                  {% case filter.type %}
                    {% when 'price_range' %}
                      <div class="main-collection__price-range">
                        <label>
                          {{ 'collection.price_from' | t }}
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            min="0"
                            step="any"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="0"
                            {% if filter.min_value.value %}
                              value="{{ filter.min_value.value | divided_by: 100.0 }}"
                            {% endif %}
                          >
                        </label>
                        <label>
                          {{ 'collection.price_to' | t }}
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            min="0"
                            step="any"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                            {% if filter.max_value.value %}
                              value="{{ filter.max_value.value | divided_by: 100.0 }}"
                            {% endif %}
                          >
                        </label>
                      </div>
                    {% else %}
                      {% for filter_value in filter.values %}
                        <label class="main-collection__filter-value">
                          <input
                            type="checkbox"
                            name="{{ filter_value.param_name }}"
                            value="{{ filter_value.value }}"
                            {% if filter_value.active %}
                              checked
                            {% endif %}
                            {% if filter_value.count == 0 and filter_value.active == false %}
                              disabled
                            {% endif %}
                          >
                          {{ filter_value.label | escape }} ({{ filter_value.count }})
                        </label>
                      {% endfor %}
                  {% endcase %}
                </div>
              </details>
            {% endfor %}
          {% endif %}

          {% if section.settings.enable_sorting %}
            <label class="main-collection__sort">
              {{ 'collection.sort_by' | t }}
              <select name="sort_by">
                {% for option in collection.sort_options %}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                      selected
                    {% endif %}
                  >
                    {{- option.name | escape -}}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% endif %}

          <button type="submit" class="button main-collection__apply">{{ 'collection.apply' | t }}</button>
        </form>
      </collection-facets>

      {% if show_filters %}
        {% capture active_filters %}
          {% for filter in collection.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                {% assign min_value = filter.min_value.value | default: 0 %}
                {% assign max_value = filter.max_value.value | default: filter.range_max %}
                {% capture price_label %}{{ min_value | money }} – {{ max_value | money }}{% endcapture %}
                <li>
                  <a href="{{ filter.url_to_remove }}">
                    {{- 'collection.remove_filter' | t: filter: price_label -}}
                  </a>
                </li>
              {% endif %}
            {% else %}
              {% for filter_value in filter.active_values %}
                <li>
                  <a href="{{ filter_value.url_to_remove }}">
                    {{- 'collection.remove_filter' | t: filter: filter_value.label -}}
                  </a>
                </li>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% if active_filters != blank %}
          <ul class="main-collection__active" role="list" aria-label="{{ 'collection.active_filters' | t }}">
            {{ active_filters }}
            <li>
              <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
            </li>
          </ul>
        {% endif %}
      {% endif %}
    {% endif %}

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 or show_placeholders %}
        <ul
          class="main-collection__grid"
          role="list"
          data-load-more-grid
          style="--columns: {{ section.settings.columns }};"
        >
          {% if show_placeholders %}
            {% for i in (1..placeholder_count) %}
              {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
              <li>
                {% render 'product-card', placeholder: placeholder, anatomy: section.settings.card_anatomy %}
              </li>
            {% endfor %}
          {% else %}
            {% for product in collection.products %}
              <li>
                {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, anatomy: section.settings.card_anatomy %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      {% elsif collection.all_products_count == 0 %}
        <p class="main-collection__empty">{{ 'collection.empty' | t }}</p>
      {% else %}
        <p class="main-collection__empty">
          {{ 'collection.no_results' | t }}
          <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
        </p>
      {% endif %}

      {% if paginate.pages > 1 %}
        <load-more class="main-collection__more" data-section-id="{{ section.id }}">
          {% if paginate.next %}
            <a class="button button--secondary main-collection__load-more" href="{{ paginate.next.url }}" data-load-more>
              {{- 'collection.load_more' | t -}}
            </a>
          {% endif %}
          <nav class="main-collection__pagination" aria-label="{{ 'collection.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        </load-more>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% javascript %}
  class CollectionFacets extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      form.addEventListener('change', (event) => {
        if (event.target.type !== 'number') form.requestSubmit();
      });
    }
  }

  if (!customElements.get('collection-facets')) {
    customElements.define('collection-facets', CollectionFacets);
  }

  class LoadMore extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', (event) => {
        const link = event.target.closest('[data-load-more]');
        if (!link) return;
        event.preventDefault();
        this.load(link);
      });
    }

    async load(link) {
      if (this.loading) return;
      this.loading = true;
      const url = new URL(link.href);
      url.searchParams.set('section_id', this.dataset.sectionId);
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error(response.statusText);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const items = [...html.querySelector('[data-load-more-grid]').children];
        const grid = this.parentElement.querySelector('[data-load-more-grid]');
        grid.append(...items);
        const next = html.querySelector('[data-load-more]');
        if (next) {
          const nextUrl = new URL(next.getAttribute('href'), link.href);
          nextUrl.searchParams.delete('section_id');
          link.href = nextUrl;
        } else {
          link.remove();
          this.dataset.done = '';
        }
        this.querySelector('nav').replaceWith(html.querySelector('load-more nav'));
        items[0]?.querySelector('a:not([tabindex="-1"]), button')?.focus();
      } catch {
        window.location.assign(link.href);
      } finally {
        this.loading = false;
      }
    }
  }

  if (!customElements.get('load-more')) {
    customElements.define('load-more', LoadMore);
  }
{% endjavascript %}

{% stylesheet %}
  .main-collection {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-collection__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .main-collection__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .main-collection__title {
    margin: 0;
  }

  .main-collection__description {
    max-width: var(--width-prose);
  }

  .main-collection__facets {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .main-collection__filter {
    position: relative;
  }

  .main-collection__filter summary {
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .main-collection__filter-values {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 14rem;
    max-height: 20rem;
    overflow-y: auto;
    margin-top: var(--space-2xs);
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
  }

  .main-collection__filter-value {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--target-size-min);
  }

  .main-collection__filter-value:has(input:disabled) {
    opacity: var(--opacity-disabled);
  }

  .main-collection__price-range {
    display: flex;
    gap: var(--space-md);
  }

  .main-collection__price-range label,
  .main-collection__sort {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .main-collection__price-range input {
    width: 6rem;
  }

  .main-collection__sort {
    margin-inline-start: auto;
  }

  .main-collection :is(input[type='number'], select) {
    padding: var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .main-collection__apply {
    align-self: flex-end;
  }

  .main-collection__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-collection__active a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-badges);
    color: inherit;
    text-decoration: none;
  }

  .main-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-row-gap) var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .main-collection__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }






  .main-collection__empty {
    margin: 0;
  }


  .main-collection__more {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-collection__more .main-collection__load-more {
    display: none;
  }

  .main-collection__pagination {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .main-collection__pagination :is(a, span) {
    padding: var(--space-2xs) var(--space-sm);
    color: inherit;
  }

  .main-collection__pagination .current {
    font-weight: bold;
  }

  @media (max-width: 749px) {
    .main-collection__active {
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .main-collection__active a {
      white-space: nowrap;
    }

    load-more:defined .main-collection__load-more {
      display: flex;
    }

    load-more:defined:is(:has(.main-collection__load-more), [data-done]) .main-collection__pagination {
      display: none;
    }
  }


{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_product_grid",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_collection_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filtering",
      "info": "t:info.main_collection_enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.enable_sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "info": "t:info.main_collection_products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_anatomy",
      "label": "t:labels.card_anatomy",
      "options": [
        {
          "value": "theme",
          "label": "t:options.card_anatomy.theme"
        },
        {
          "value": "minimal",
          "label": "t:options.card_anatomy.minimal"
        },
        {
          "value": "detailed",
          "label": "t:options.card_anatomy.detailed"
        },
        {
          "value": "editorial",
          "label": "t:options.card_anatomy.editorial"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_product_grid"
    },
    {
      "name": "t:general.collection_product_grid_minimal",
      "settings": {
        "card_anatomy": "minimal"
      }
    },
    {
      "name": "t:general.collection_product_grid_detailed",
      "settings": {
        "card_anatomy": "detailed"
      }
    },
    {
      "name": "t:general.collection_product_grid_editorial",
      "settings": {
        "card_anatomy": "editorial",
        "columns": 3,
        "show_quick_add": false
      }
    }
  ]
}
{% endschema %}
