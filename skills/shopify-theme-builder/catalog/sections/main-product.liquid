{% comment %}The product page's media, in a grid, stacked, with thumbnails or in a carousel, beside its title, price, variant picker, buy buttons, shipping note and collapsible content in any order.{% endcomment %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign media_first = product.media | where: 'id', featured_media.id
  assign media_rest = product.media | reject: 'id', featured_media.id
  assign ordered_media = media_first | concat: media_rest
  assign models = product.media | where: 'media_type', 'model'
%}

{% if models != empty %}
  {% # theme-check-disable-next-line RemoteAsset %}
  {{ 'https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css' | stylesheet_tag }}
{% endif %}

<div class="main-product main-product--{{ section.settings.gallery_layout }} full-width color-{{ section.settings.color_scheme }}">
  <product-info
    class="main-product__inner"
    data-url="{{ product.url }}"
    data-section="{{ section.id }}"
  >
    <media-gallery class="main-product__gallery">
      <ul class="main-product__media" role="list" tabindex="0" aria-label="{{ 'product.media' | t }}">
        {% for media in ordered_media %}
          <li class="main-product__media-item">
            {% case media.media_type %}
              {% when 'image' %}
                {% liquid
                  assign loading = 'lazy'
                  assign fetchpriority = 'auto'
                  assign sizes = '(min-width: 750px) 50vw, 100vw'
                  if section.settings.gallery_layout == 'stacked'
                    assign sizes = '(min-width: 750px) 60vw, 100vw'
                  endif
                  if forloop.first
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                %}
                {{
                  media.preview_image
                  | image_url: width: 1500
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500',
                    sizes: sizes,
                    loading: loading,
                    fetchpriority: fetchpriority
                }}
              {% when 'model' %}
                <product-model class="main-product__model">
                  {{ media | model_viewer_tag }}
                </product-model>
              {% when 'external_video' %}
                {{ media | external_video_tag: loading: 'lazy' }}
              {% else %}
                {{ media | media_tag: image_size: '1500x' }}
            {% endcase %}
          </li>
        {% else %}
          <li class="main-product__media-item">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder main-product__placeholder' }}
          </li>
        {% endfor %}
      </ul>
      {% if ordered_media.size > 1 %}
        <ul class="main-product__thumbnails" role="list" aria-label="{{ 'product.media_thumbnails' | t }}">
          {% for media in ordered_media %}
            <li>
              <button
                type="button"
                class="main-product__thumbnail"
                aria-label="{{ 'product.show_media' | t: index: forloop.index, count: forloop.length }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                {{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: alt: '', width: 80, height: 80, sizes: '5rem', loading: 'lazy' }}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.gallery_layout == 'carousel' and ordered_media.size > 1 %}
        <div class="main-product__arrows">
          <button type="button" class="main-product__arrow" data-step="-1" aria-label="{{ 'product.previous_media' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12 5-5 5 5 5" />
            </svg>
          </button>
          <button type="button" class="main-product__arrow" data-step="1" aria-label="{{ 'product.next_media' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m8 5 5 5-5 5" />
            </svg>
          </button>
        </div>
      {% endif %}
    </media-gallery>

    <div class="main-product__details">
      {% content_for 'blocks' %}
    </div>
  </product-info>
</div>

{% javascript %}
  class ProductInfo extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', this.onChange);
      this.addEventListener('submit', (event) => {
        const drawer = document.querySelector('cart-drawer');
        if (!drawer?.add) return;
        event.preventDefault();
        drawer.add(event.target, event.submitter);
      });
    }

    onChange = async (event) => {
      const optionValueId = event.target.dataset.optionValueId;
      if (!optionValueId && event.target.name !== 'selling_plan') return;
      const params = new URLSearchParams({ section_id: this.dataset.section });
      if (optionValueId) {
        const optionValues = [...this.querySelectorAll('[data-option-value-id]:checked')]
          .map((input) => input.dataset.optionValueId)
          .join(',');
        const { productUrl } = event.target.dataset;
        if (productUrl && productUrl !== this.dataset.url) {
          location.assign(`${productUrl}?option_values=${optionValues}`);
          return;
        }
        params.set('option_values', optionValues);
      } else {
        params.set('variant', this.querySelector('input[name="id"]').value);
      }
      const sellingPlan = this.querySelector('input[name="selling_plan"]:checked')?.value;
      if (sellingPlan) params.set('selling_plan', sellingPlan);
      this.request?.abort();
      this.request = new AbortController();
      const text = await fetch(`${this.dataset.url}?${params}`, { signal: this.request.signal })
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!text) return;
      const fresh = new DOMParser().parseFromString(text, 'text/html').querySelector('product-info');
      if (!fresh) return;
      const variant = fresh.querySelector('input[name="id"]')?.value;
      if (variant) {
        const plan = sellingPlan ? `&selling_plan=${sellingPlan}` : '';
        history.replaceState(null, '', `${this.dataset.url}?variant=${variant}${plan}`);
      }
      const quantity = this.querySelector('input[name="quantity"]')?.value;
      const focused = event.target.id;
      const recipient = this.querySelector('.buy-buttons__recipient');
      this.replaceChildren(...fresh.childNodes);
      if (recipient) this.querySelector('.buy-buttons__recipient')?.replaceWith(recipient);
      const quantityInput = this.querySelector('input[name="quantity"]');
      if (quantityInput && quantity) quantityInput.value = quantity;
      document.getElementById(focused)?.focus();
    };
  }

  if (!customElements.get('product-info')) customElements.define('product-info', ProductInfo);

  class ProductModel extends HTMLElement {
    connectedCallback() {
      window.Shopify?.loadFeatures?.([
        {
          name: 'model-viewer-ui',
          version: '1.0',
          onLoad: (errors) => {
            const viewer = this.querySelector('model-viewer');
            if (errors || !viewer || this.ui) return;
            this.ui = new Shopify.ModelViewerUI(viewer);
          },
        },
      ]);
    }
  }

  if (!customElements.get('product-model')) customElements.define('product-model', ProductModel);

  class MediaGallery extends HTMLElement {
    connectedCallback() {
      this.list = this.querySelector('.main-product__media');
      this.strip = this.querySelector('.main-product__thumbnails');
      this.querySelectorAll('.main-product__arrow').forEach((arrow) =>
        arrow.addEventListener('click', () => this.show(this.index + Number(arrow.dataset.step)))
      );
      if (!this.strip) return;
      this.thumbnails = [...this.strip.querySelectorAll('.main-product__thumbnail')];
      this.thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => this.show(index)));
      this.list.addEventListener('scroll', this.onScroll, { passive: true });
    }

    // The media scrolled to: scrollLeft is negative right to left.
    get index() {
      const [first, second] = this.list.children;
      return Math.round(Math.abs(this.list.scrollLeft / (second.offsetLeft - first.offsetLeft)));
    }

    show(index) {
      this.list.children[index]?.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'start',
      });
    }

    onScroll = () => {
      const current = this.thumbnails[this.index];
      if (!current || current.hasAttribute('aria-current')) return;
      this.thumbnails.forEach((thumbnail) => thumbnail.removeAttribute('aria-current'));
      current.setAttribute('aria-current', 'true');
      const strip = this.strip.getBoundingClientRect();
      const box = current.getBoundingClientRect();
      if (box.left < strip.left) this.strip.scrollBy(box.left - strip.left, 0);
      if (box.right > strip.right) this.strip.scrollBy(box.right - strip.right, 0);
    };
  }

  if (!customElements.get('media-gallery')) customElements.define('media-gallery', MediaGallery);
{% endjavascript %}

{% stylesheet %}
  .main-product {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-product__inner {
    grid-column: 2;
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--section-spacing);
  }

  @media (min-width: 750px) {
    .main-product__inner {
      grid-template-columns: 3fr 2fr;
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .main-product__media {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  @media (min-width: 750px) {
    .main-product--grid .main-product__media,
    .main-product--stacked .main-product__media {
      grid-auto-flow: row;
      overflow: visible;
    }

    .main-product--grid .main-product__media {
      grid-template-columns: 1fr 1fr;
    }

    .main-product--grid .main-product__media-item:first-child {
      grid-column: 1 / -1;
    }

    .main-product--carousel .main-product__media {
      grid-auto-columns: 85%;
    }
  }

  .main-product__media-item {
    overflow: hidden;
    background-color: var(--media-background);
    scroll-snap-align: start;
  }

  .main-product:not(.main-product--stacked) .main-product__media-item {
    border-radius: var(--style-border-radius-media);
  }

  /* Stacked: the gallery runs to the edge of the page, the details and thumbnails keep the page margin. */
  .main-product--stacked .main-product__inner {
    grid-column: 1 / -1;
    padding-block-start: 0;
  }

  .main-product--stacked :is(.main-product__details, .main-product__thumbnails) {
    padding-inline: var(--page-margin);
  }

  @media (min-width: 750px) {
    .main-product--stacked .main-product__details {
      max-width: var(--width-text);
      padding-inline-start: 0;
    }
  }

  .main-product__gallery {
    display: block;
    min-width: 0;
  }

  .main-product__thumbnails {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * var(--space-xs)) / 4.5);
    gap: var(--space-xs);
    margin: 0;
    padding: calc(var(--focus-ring-width) + var(--focus-ring-offset));
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  @media (min-width: 750px) {
    .main-product:not(.main-product--thumbnails) .main-product__thumbnails {
      display: none;
    }

    .main-product__thumbnails {
      grid-auto-columns: calc((100% - 6 * var(--space-xs)) / 6.5);
    }
  }

  .main-product__thumbnail {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--style-border-radius-media);
    background: none;
    cursor: pointer;
    opacity: var(--opacity-muted);
  }

  .main-product__thumbnail[aria-current='true'] {
    outline: var(--focus-ring-width) solid currentcolor;
    opacity: 1;
  }

  .main-product__thumbnail img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: var(--media-fit);
    border-radius: var(--style-border-radius-media);
    background-color: var(--media-background);
  }

  .main-product__arrows {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding-block-start: var(--space-xs);
  }

  @media (max-width: 749px) {
    .main-product__arrows {
      display: none;
    }
  }

  .main-product__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: var(--space-xs);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .main-product__arrow svg {
    width: 1.5rem;
  }

  .main-product__arrow svg:dir(rtl) {
    scale: -1 1;
  }

  .main-product__media-item img {
    padding: var(--media-inset);
    mix-blend-mode: var(--media-blend);
  }

  .main-product__media-item img,
  .main-product__media-item video,
  .main-product__media-item iframe,
  .main-product__placeholder {
    width: 100%;
    height: auto;
  }

  .main-product__media-item iframe {
    aspect-ratio: 16 / 9;
  }

  .main-product__model {
    display: block;
    aspect-ratio: 1;
  }

  .main-product__model .shopify-model-viewer-ui,
  .main-product__model model-viewer {
    width: 100%;
    height: 100%;
  }

  .main-product__placeholder {
    aspect-ratio: 1;
  }

  .main-product__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .main-product__details {
      position: sticky;
      top: calc(var(--header-offset, 0px) + 2rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_product",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:labels.gallery_layout",
      "info": "t:info.main_product_gallery_layout",
      "options": [
        { "value": "grid", "label": "t:options.gallery_layout.grid" },
        { "value": "stacked", "label": "t:options.gallery_layout.stacked" },
        { "value": "thumbnails", "label": "t:options.gallery_layout.thumbnails" },
        { "value": "carousel", "label": "t:options.gallery_layout.carousel" }
      ],
      "default": "grid"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "_product-title" },
    { "type": "_product-price" },
    { "type": "_variant-picker" },
    { "type": "_buy-buttons" },
    { "type": "custom-liquid" },
    { "type": "shipping-note" },
    { "type": "collapsible-content" }
  ],
  "presets": [
    {
      "name": "t:general.main_product",
      "blocks": [
        { "type": "_product-title" },
        { "type": "_product-price" },
        { "type": "_variant-picker" },
        { "type": "_buy-buttons" },
        { "type": "shipping-note" },
        { "type": "collapsible-content", "settings": { "heading": "Description", "source": "description" } },
        { "type": "collapsible-content", "settings": { "heading": "Materials", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Care", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Shipping and returns", "source": "text" } }
      ]
    },
    {
      "name": "t:general.main_product_stacked",
      "settings": { "gallery_layout": "stacked" },
      "blocks": [
        { "type": "_product-title" },
        { "type": "_product-price" },
        { "type": "_variant-picker" },
        { "type": "_buy-buttons" },
        { "type": "shipping-note" },
        { "type": "collapsible-content", "settings": { "heading": "Description", "source": "description" } },
        { "type": "collapsible-content", "settings": { "heading": "Materials", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Care", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Shipping and returns", "source": "text" } }
      ]
    },
    {
      "name": "t:general.main_product_thumbnails",
      "settings": { "gallery_layout": "thumbnails" },
      "blocks": [
        { "type": "_product-title" },
        { "type": "_product-price" },
        { "type": "_variant-picker" },
        { "type": "_buy-buttons" },
        { "type": "shipping-note" },
        { "type": "collapsible-content", "settings": { "heading": "Description", "source": "description" } },
        { "type": "collapsible-content", "settings": { "heading": "Materials", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Care", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Shipping and returns", "source": "text" } }
      ]
    },
    {
      "name": "t:general.main_product_carousel",
      "settings": { "gallery_layout": "carousel" },
      "blocks": [
        { "type": "_product-title" },
        { "type": "_product-price" },
        { "type": "_variant-picker" },
        { "type": "_buy-buttons" },
        { "type": "shipping-note" },
        { "type": "collapsible-content", "settings": { "heading": "Description", "source": "description" } },
        { "type": "collapsible-content", "settings": { "heading": "Materials", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Care", "source": "text" } },
        { "type": "collapsible-content", "settings": { "heading": "Shipping and returns", "source": "text" } }
      ]
    }
  ]
}
{% endschema %}
