{% comment %}The product page's media, in a grid, stacked, with thumbnails or in a carousel, beside its title, price, variant picker, buy buttons, shipping note and collapsible content in any order.{% endcomment %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign media_first = product.media | where: 'id', featured_media.id
  assign media_rest = product.media | reject: 'id', featured_media.id
  assign ordered_media = media_first | concat: media_rest
  assign models = product.media | where: 'media_type', 'model'
  assign images = ordered_media | where: 'media_type', 'image'
  assign zoom = false
  if section.settings.image_zoom == 'lightbox' and images != empty
    assign zoom = true
  endif
  assign image_index = 0
  assign price = current_variant.price
  assign allocation = current_variant.selected_selling_plan_allocation
  if product.requires_selling_plan and allocation == nil
    assign allocation = current_variant.selling_plan_allocations.first
  endif
  if allocation
    assign price = allocation.price
  endif
  assign variant_price = price | money | strip_html
  if current_variant.available
    assign availability = 'product.in_stock' | t
  else
    assign availability = 'product.sold_out' | t
  endif
  assign variant_status = 'product.variant_status' | t: price: variant_price, availability: availability
%}

{% if models != empty %}
  {% # theme-check-disable-next-line RemoteAsset %}
  {{ 'https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css' | stylesheet_tag }}
{% endif %}

<div class="main-product main-product--{{ section.settings.gallery_layout }} full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}" style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};">
  <product-info
    class="main-product__inner"
    data-url="{{ product.url }}"
    data-section="{{ section.id }}"
    data-status="{{ variant_status }}"
  >
    <media-gallery class="main-product__gallery">
      <ul class="main-product__media" role="list" tabindex="0" aria-label="{{ 'product.media' | t }}">
        {% for media in ordered_media %}
          <li class="main-product__media-item">
            {% case media.media_type %}
              {% when 'image' %}
                {% liquid
                  assign loading = 'lazy'
                  assign fetchpriority = 'auto'
                  assign sizes = '(min-width: 750px) 50vw, 100vw'
                  if section.settings.gallery_layout == 'stacked'
                    assign sizes = '(min-width: 750px) 60vw, 100vw'
                  endif
                  if forloop.first
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                  assign image_index = image_index | plus: 1
                %}
                {% if zoom %}
                  <button
                    type="button"
                    class="main-product__zoom"
                    data-index="{{ image_index | minus: 1 }}"
                    aria-haspopup="dialog"
                    aria-label="{{ 'product.zoom' | t: index: image_index, count: images.size }}"
                  >
                {% endif %}
                {{
                  media.preview_image
                  | image_url: width: 1500
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500',
                    sizes: sizes,
                    loading: loading,
                    fetchpriority: fetchpriority
                }}
                {% if zoom %}
                  </button>
                {% endif %}
              {% when 'model' %}
                <product-model class="main-product__model">
                  {{ media | model_viewer_tag }}
                </product-model>
              {% when 'external_video' %}
                {{ media | external_video_tag: loading: 'lazy' }}
              {% else %}
                {{ media | media_tag: image_size: '1500x' }}
            {% endcase %}
          </li>
        {% else %}
          <li class="main-product__media-item">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder main-product__placeholder' }}
          </li>
        {% endfor %}
      </ul>
      {% if ordered_media.size > 1 %}
        <ul class="main-product__thumbnails" role="list" aria-label="{{ 'product.media_thumbnails' | t }}">
          {% for media in ordered_media %}
            <li>
              <button
                type="button"
                class="main-product__thumbnail"
                aria-label="{{ 'product.show_media' | t: index: forloop.index, count: forloop.length }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: alt: '', sizes: '5rem', loading: 'lazy' }}
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.gallery_layout == 'carousel' and ordered_media.size > 1 %}
        <div class="main-product__arrows">
          <button type="button" class="main-product__arrow" data-step="-1" aria-label="{{ 'product.previous_media' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12 5-5 5 5 5" />
            </svg>
          </button>
          <button type="button" class="main-product__arrow" data-step="1" aria-label="{{ 'product.next_media' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m8 5 5 5-5 5" />
            </svg>
          </button>
        </div>
      {% endif %}
      {% if zoom %}
        <media-lightbox>
          <dialog class="main-product__lightbox" aria-label="{{ 'product.lightbox' | t }}" scroll-lock>
            <ul class="main-product__lightbox-images" role="list">
              {% for image in images %}
                <li class="main-product__lightbox-image" {% unless forloop.first %}hidden{% endunless %}>
                  {{ image.preview_image | image_url: width: 3000 | image_tag: srcset: nil, sizes: '100vw', loading: 'lazy' }}
                </li>
              {% endfor %}
            </ul>
            <form method="dialog">
              <button class="main-product__lightbox-close" aria-label="{{ 'product.close_lightbox' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m5 5 10 10M15 5 5 15" />
                </svg>
              </button>
            </form>
            {% if images.size > 1 %}
              <div class="main-product__lightbox-arrows">
                <button type="button" class="main-product__lightbox-arrow" data-step="-1" aria-label="{{ 'product.previous_media' | t }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12 5-5 5 5 5" />
                  </svg>
                </button>
                <button type="button" class="main-product__lightbox-arrow" data-step="1" aria-label="{{ 'product.next_media' | t }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m8 5 5 5-5 5" />
                  </svg>
                </button>
              </div>
              <p
                class="main-product__lightbox-count text-label"
                aria-live="polite"
                data-template="{{ 'product.media_position' | t: index: '[index]', count: images.size }}"
              >
                {{- 'product.media_position' | t: index: 1, count: images.size -}}
              </p>
            {% endif %}
          </dialog>
        </media-lightbox>
      {% endif %}
    </media-gallery>

    <div class="main-product__details">
      {% content_for 'blocks' %}
    </div>

    {% if section.settings.sticky_buy_bar %}
      <sticky-buy-bar class="main-product__buy-bar" data-form="product-form-{{ section.id }}">
        <p class="main-product__buy-bar-title">{{ product.title | escape }}</p>
        <span class="main-product__buy-bar-price price">{{ price | money }}</span>
        <button
          type="submit"
          form="product-form-{{ section.id }}"
          class="button main-product__buy-bar-button"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {% if current_variant.available %}
            {{ 'product.add_to_cart' | t }}
          {% else %}
            {{ 'product.sold_out' | t }}
          {% endif %}
        </button>
      </sticky-buy-bar>
    {% endif %}
  </product-info>
  <p class="main-product__status visually-hidden" role="status"></p>
</div>

{% javascript %}
  class ProductInfo extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', this.onChange);
      this.addEventListener('submit', (event) => {
        const drawer = document.querySelector('cart-drawer');
        if (!drawer?.add) return;
        event.preventDefault();
        drawer.add(event.target, event.submitter);
      });
    }

    onChange = async (event) => {
      const optionValueId = event.target.dataset.optionValueId;
      if (!optionValueId && event.target.name !== 'selling_plan') return;
      const params = new URLSearchParams({ section_id: this.dataset.section });
      if (optionValueId) {
        const optionValues = [...this.querySelectorAll('[data-option-value-id]:checked')]
          .map((input) => input.dataset.optionValueId)
          .join(',');
        const { productUrl } = event.target.dataset;
        if (productUrl && productUrl !== this.dataset.url) {
          location.assign(`${productUrl}?option_values=${optionValues}`);
          return;
        }
        params.set('option_values', optionValues);
      } else {
        params.set('variant', this.querySelector('input[name="id"]').value);
      }
      const sellingPlan = this.querySelector('input[name="selling_plan"]:checked')?.value;
      if (sellingPlan) params.set('selling_plan', sellingPlan);
      this.request?.abort();
      this.request = new AbortController();
      const text = await fetch(`${this.dataset.url}?${params}`, { signal: this.request.signal })
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!text) return;
      const fresh = new DOMParser().parseFromString(text, 'text/html').querySelector('product-info');
      if (!fresh) return;
      const variant = fresh.querySelector('input[name="id"]')?.value;
      if (variant) {
        const plan = sellingPlan ? `&selling_plan=${sellingPlan}` : '';
        history.replaceState(null, '', `${this.dataset.url}?variant=${variant}${plan}`);
      }
      const quantity = this.querySelector('input[name="quantity"]')?.value;
      const focused = event.target.id;
      const recipient = this.querySelector('.buy-buttons__recipient');
      this.replaceChildren(...fresh.childNodes);
      const status = this.parentElement.querySelector('.main-product__status');
      status.textContent = fresh.dataset.status;
      if (recipient) this.querySelector('.buy-buttons__recipient')?.replaceWith(recipient);
      const quantityInput = this.querySelector('input[name="quantity"]');
      if (quantityInput && quantity) quantityInput.value = quantity;
      document.getElementById(focused)?.focus();
    };
  }

  if (!customElements.get('product-info')) customElements.define('product-info', ProductInfo);

  class ProductModel extends HTMLElement {
    connectedCallback() {
      window.Shopify?.loadFeatures?.([
        {
          name: 'model-viewer-ui',
          version: '1.0',
          onLoad: (errors) => {
            const viewer = this.querySelector('model-viewer');
            if (errors || !viewer || this.ui) return;
            this.ui = new Shopify.ModelViewerUI(viewer);
          },
        },
      ]);
    }
  }

  if (!customElements.get('product-model')) customElements.define('product-model', ProductModel);

  class MediaGallery extends HTMLElement {
    connectedCallback() {
      this.lightbox = this.querySelector('media-lightbox');
      this.addEventListener('click', (event) => {
        const zoom = event.target.closest('.main-product__zoom');
        if (zoom) this.lightbox?.open(Number(zoom.dataset.index), zoom);
      });
      this.list = this.querySelector('.main-product__media');
      this.strip = this.querySelector('.main-product__thumbnails');
      this.querySelectorAll('.main-product__arrow').forEach((arrow) =>
        arrow.addEventListener('click', () => this.show(this.index + Number(arrow.dataset.step)))
      );
      if (!this.strip) return;
      this.thumbnails = [...this.strip.querySelectorAll('.main-product__thumbnail')];
      this.thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener('click', () => this.show(index)));
      this.list.addEventListener('scroll', this.onScroll, { passive: true });
    }

    // The media scrolled to: scrollLeft is negative right to left.
    get index() {
      const [first, second] = this.list.children;
      return Math.round(Math.abs(this.list.scrollLeft / (second.offsetLeft - first.offsetLeft)));
    }

    show(index) {
      this.list.children[index]?.scrollIntoView({
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'start',
      });
    }

    onScroll = () => {
      const current = this.thumbnails[this.index];
      if (!current || current.hasAttribute('aria-current')) return;
      this.thumbnails.forEach((thumbnail) => thumbnail.removeAttribute('aria-current'));
      current.setAttribute('aria-current', 'true');
      const strip = this.strip.getBoundingClientRect();
      const box = current.getBoundingClientRect();
      if (box.left < strip.left) this.strip.scrollBy(box.left - strip.left, 0);
      if (box.right > strip.right) this.strip.scrollBy(box.right - strip.right, 0);
    };
  }

  if (!customElements.get('media-gallery')) customElements.define('media-gallery', MediaGallery);

  class MediaLightbox extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      this.slides = [...this.querySelectorAll('.main-product__lightbox-image')];
      this.count = this.querySelector('.main-product__lightbox-count');
      this.pointers = new Map();
      // A modal dialog closes on Escape by itself; give focus back to the image that opened it.
      this.dialog.addEventListener('close', () => this.opener?.focus());
      this.querySelectorAll('.main-product__lightbox-arrow').forEach((arrow) =>
        arrow.addEventListener('click', () => this.show(this.index + Number(arrow.dataset.step)))
      );
      this.dialog.addEventListener('keydown', (event) => {
        if (this.slides.length < 2 || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        const next = getComputedStyle(this).direction === 'rtl' ? 'ArrowLeft' : 'ArrowRight';
        this.show(this.index + (event.key === next ? 1 : -1));
      });
      for (const type of ['pointerdown', 'pointermove', 'pointerup', 'pointercancel']) {
        this.dialog.addEventListener(type, this.onPointer);
      }
    }

    open(index, opener) {
      this.opener = opener;
      this.show(index);
      this.dialog.showModal();
    }

    show(index) {
      this.index = (index + this.slides.length) % this.slides.length;
      this.slides.forEach((slide, i) => (slide.hidden = i !== this.index));
      this.pointers.clear();
      this.zoom = { scale: 1, x: 0, y: 0 };
      this.transform();
      if (this.count) this.count.textContent = this.count.dataset.template.replace('[index]', this.index + 1);
    }

    transform() {
      const image = this.slides[this.index].querySelector('img');
      if (image) image.style.transform = `translate(${this.zoom.x}px, ${this.zoom.y}px) scale(${this.zoom.scale})`;
    }

    // The fingers' midpoint, from the center of the image, and the distance between two of them.
    gesture() {
      const points = [...this.pointers.values()];
      const box = this.slides[this.index].getBoundingClientRect();
      const [a, b] = points;
      return {
        box,
        midX: points.reduce((sum, point) => sum + point.clientX, 0) / points.length - box.x - box.width / 2,
        midY: points.reduce((sum, point) => sum + point.clientY, 0) / points.length - box.y - box.height / 2,
        distance: b ? Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY) : 0,
      };
    }

    // Two fingers pinch, one pans a zoomed image: the point of the image under the fingers stays under them.
    onPointer = (event) => {
      if (event.type === 'pointerdown') {
        const slide = event.target.closest('.main-product__lightbox-image');
        if (!slide) return;
        slide.setPointerCapture(event.pointerId);
        this.pointers.set(event.pointerId, event);
      } else if (!this.pointers.has(event.pointerId)) {
        return;
      } else if (event.type === 'pointermove') {
        this.pointers.set(event.pointerId, event);
        this.move();
        return;
      } else {
        this.pointers.delete(event.pointerId);
      }
      if (this.pointers.size) this.start = { ...this.zoom, ...this.gesture() };
    };

    move() {
      const { box, midX, midY, distance } = this.gesture();
      const start = this.start;
      const pinch = distance && start.distance ? distance / start.distance : 1;
      const scale = Math.min(4, Math.max(1, start.scale * pinch));
      const clamp = (value, size) => Math.min((scale - 1) * size / 2, Math.max(-(scale - 1) * size / 2, value));
      this.zoom = {
        scale,
        x: clamp(midX - (scale * (start.midX - start.x)) / start.scale, box.width),
        y: clamp(midY - (scale * (start.midY - start.y)) / start.scale, box.height),
      };
      this.transform();
    }
  }

  if (!customElements.get('media-lightbox')) customElements.define('media-lightbox', MediaLightbox);

  // Shows once the main add to cart has scrolled past the top of the screen; the page keeps its height free below.
  class StickyBuyBar extends HTMLElement {
    connectedCallback() {
      const add = document.getElementById(this.dataset.form)?.querySelector('.buy-buttons__add');
      if (!add) return;
      this.observer = new IntersectionObserver(([entry]) => {
        this.toggleAttribute('data-visible', !entry.isIntersecting && entry.boundingClientRect.bottom < 0);
        document.documentElement.style.setProperty('--buy-bar-height', `${this.offsetHeight}px`);
      });
      this.observer.observe(add);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('sticky-buy-bar')) customElements.define('sticky-buy-bar', StickyBuyBar);
{% endjavascript %}

{% stylesheet %}
  .main-product {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-product__inner {
    grid-column: 2;
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--section-spacing);
  }

  @media (min-width: 750px) {
    .main-product__inner {
      grid-template-columns: 3fr 2fr;
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .main-product__media {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  @media (min-width: 750px) {
    .main-product--grid .main-product__media,
    .main-product--stacked .main-product__media {
      grid-auto-flow: row;
      overflow: visible;
    }

    .main-product--grid .main-product__media {
      grid-template-columns: 1fr 1fr;
    }

    .main-product--grid .main-product__media-item:first-child {
      grid-column: 1 / -1;
    }

    .main-product--carousel .main-product__media {
      grid-auto-columns: 85%;
    }
  }

  .main-product__media-item {
    overflow: hidden;
    background-color: var(--media-background);
    scroll-snap-align: start;
  }

  .main-product:not(.main-product--stacked) .main-product__media-item {
    border-radius: var(--style-border-radius-media);
  }

  /* Stacked: the gallery runs to the edge of the page, the details and thumbnails keep the page margin. */
  .main-product--stacked .main-product__inner {
    grid-column: 1 / -1;
    padding-block-start: 0;
  }

  .main-product--stacked :is(.main-product__details, .main-product__thumbnails) {
    padding-inline: var(--page-margin);
  }

  @media (min-width: 750px) {
    .main-product--stacked .main-product__details {
      max-width: var(--width-text);
      padding-inline-start: 0;
    }
  }

  .main-product__gallery {
    display: block;
    min-width: 0;
  }

  .main-product__thumbnails {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4 * var(--space-xs)) / 4.5);
    gap: var(--space-xs);
    margin: 0;
    padding: calc(var(--focus-ring-width) + var(--focus-ring-offset));
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  @media (min-width: 750px) {
    .main-product:not(.main-product--thumbnails) .main-product__thumbnails {
      display: none;
    }

    .main-product__thumbnails {
      grid-auto-columns: calc((100% - 6 * var(--space-xs)) / 6.5);
    }
  }

  .main-product__thumbnail {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--style-border-radius-media);
    background: none;
    cursor: pointer;
    opacity: var(--opacity-muted);
  }

  .main-product__thumbnail[aria-current='true'] {
    outline: var(--focus-ring-width) solid currentcolor;
    opacity: 1;
  }

  .main-product__thumbnail img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--image-ratio);
    object-fit: var(--media-fit);
    border-radius: var(--style-border-radius-media);
    background-color: var(--media-background);
  }

  .main-product__arrows {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding-block-start: var(--space-xs);
  }

  @media (max-width: 749px) {
    .main-product__arrows {
      display: none;
    }
  }

  .main-product__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: var(--space-xs);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .main-product__arrow svg {
    width: 1.5rem;
  }

  .main-product__arrow svg:dir(rtl) {
    scale: -1 1;
  }

  .main-product__zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: zoom-in;
  }

  .main-product__lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
  }

  .main-product__lightbox[open] {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
  }

  /* Positioned, so the controls stay above the zoomed image, which a transform lifts. */
  .main-product__lightbox > * {
    position: relative;
    grid-area: 1 / 1;
  }

  .main-product__lightbox-images {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-product__lightbox-image {
    height: 100%;
    overflow: hidden;
    touch-action: none;
  }

  .main-product__lightbox-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .main-product__lightbox form {
    align-self: start;
    justify-self: end;
    padding: var(--space-sm);
  }

  .main-product__lightbox-arrows {
    display: flex;
    align-self: center;
    justify-content: space-between;
    padding-inline: var(--space-sm);
    pointer-events: none;
  }

  .main-product__lightbox-count {
    align-self: end;
    justify-self: center;
    margin-block-end: var(--space-md);
    padding: var(--space-2xs) var(--space-xs);
    background-color: var(--color-background);
  }

  .main-product__lightbox-close,
  .main-product__lightbox-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
  }

  .main-product__lightbox-close svg {
    width: 2rem;
  }

  .main-product__lightbox-arrow svg {
    width: 1.5rem;
  }

  .main-product__lightbox-arrow svg:dir(rtl) {
    scale: -1 1;
  }

  .main-product__media-item img {
    aspect-ratio: var(--image-ratio);
    padding: var(--media-inset);
    object-fit: var(--media-fit);
    mix-blend-mode: var(--media-blend);
  }

  .main-product__media-item img,
  .main-product__media-item video,
  .main-product__media-item iframe,
  .main-product__placeholder {
    width: 100%;
    height: auto;
  }

  .main-product__media-item iframe {
    aspect-ratio: 16 / 9;
  }

  .main-product__model {
    display: block;
    aspect-ratio: 1;
  }

  .main-product__model .shopify-model-viewer-ui,
  .main-product__model model-viewer {
    width: 100%;
    height: 100%;
  }

  .main-product__placeholder {
    aspect-ratio: var(--image-ratio);
  }

  .main-product__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .main-product__details {
      position: sticky;
      top: calc(var(--header-offset, 0px) + 2rem);
    }
  }

  .main-product__buy-bar {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    padding-block-end: calc(var(--space-sm) + env(safe-area-inset-bottom));
    padding-inline: max(var(--page-margin), env(safe-area-inset-left), env(safe-area-inset-right));
    border-block-start: var(--border-width) solid var(--color-border-subtle);
    background-color: var(--color-background);
    translate: 0 100%;
    visibility: hidden;
  }

  .main-product__buy-bar[data-visible] {
    translate: none;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .main-product__buy-bar {
      transition:
        translate var(--motion-duration) var(--motion-easing),
        visibility var(--motion-duration);
    }
  }

  @media (min-width: 750px) {
    .main-product__buy-bar {
      display: none;
    }
  }

  @media (max-width: 749px) {
    body:has(.main-product__buy-bar) {
      padding-block-end: var(--buy-bar-height);
    }

    html:has(.main-product__buy-bar) {
      scroll-padding-block-end: var(--buy-bar-height);
    }
  }

  .main-product__buy-bar-title {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .main-product__buy-bar-button {
    flex-shrink: 0;
  }
{% endstylesheet %}

