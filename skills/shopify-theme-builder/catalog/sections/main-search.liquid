{% comment %}The search page: the search box and the results (products, articles and pages), with filters and sorting.{% endcomment %}
{% liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign show_filters = false
  if section.settings.enable_filtering and search.performed and search.filters.size > 0
    assign show_filters = true
  endif
  assign show_sorting = false
  if section.settings.enable_sorting and search.performed
    assign show_sorting = true
  endif
  assign placeholder_count = section.settings.columns | times: 2
  assign encoded_terms = search.terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign terms = search.terms | escape
%}

<div class="main-search full-width color-{{ section.settings.color_scheme }}">
  <div class="main-search__inner">
    <div class="main-search__header">
      <h1 class="main-search__title">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
        <input
          type="search"
          name="q"
          value="{{ terms }}"
          placeholder="{{ 'search.placeholder' | t }}"
          aria-label="{{ 'search.title' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button main-search__apply">{{ 'search.submit' | t }}</button>
      </form>
      {% if search.performed and search.results_count > 0 %}
        <p class="main-search__count">
          {{ 'search.results_for_html' | t: terms: terms, count: search.results_count }}
        </p>
      {% endif %}
    </div>

    {% if show_filters or show_sorting %}
      <search-facets>
        <form class="main-search__facets" action="{{ routes.search_url }}" method="get">
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="options[prefix]" value="last">

          {% if show_filters %}
            {% for filter in search.filters %}
              <details class="main-search__filter">
                <summary>{{ filter.label | escape }}</summary>
                <div class="main-search__filter-values">
                  {% case filter.type %}
                    {% when 'price_range' %}
                      <div class="main-search__price-range">
                        <label>
                          {{ 'collection.price_from' | t }}
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            min="0"
                            step="any"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="0"
                            {% if filter.min_value.value %}
                              value="{{ filter.min_value.value | divided_by: 100.0 }}"
                            {% endif %}
                          >
                        </label>
                        <label>
                          {{ 'collection.price_to' | t }}
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            min="0"
                            step="any"
                            max="{{ filter.range_max | divided_by: 100.0 }}"
                            placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                            {% if filter.max_value.value %}
                              value="{{ filter.max_value.value | divided_by: 100.0 }}"
                            {% endif %}
                          >
                        </label>
                      </div>
                    {% else %}
                      {% for filter_value in filter.values %}
                        <label class="main-search__filter-value">
                          <input
                            type="checkbox"
                            name="{{ filter_value.param_name }}"
                            value="{{ filter_value.value }}"
                            {% if filter_value.active %}
                              checked
                            {% endif %}
                            {% if filter_value.count == 0 and filter_value.active == false %}
                              disabled
                            {% endif %}
                          >
                          {{ filter_value.label | escape }} ({{ filter_value.count }})
                        </label>
                      {% endfor %}
                  {% endcase %}
                </div>
              </details>
            {% endfor %}
          {% endif %}

          {% if show_sorting %}
            <label class="main-search__sort">
              {{ 'collection.sort_by' | t }}
              <select name="sort_by">
                {% for option in search.sort_options %}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                      selected
                    {% endif %}
                  >
                    {{- option.name | escape -}}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% endif %}

          <button type="submit" class="button main-search__apply">{{ 'collection.apply' | t }}</button>
        </form>
      </search-facets>

      {% if show_filters %}
        {% capture active_filters %}
          {% for filter in search.filters %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                {% assign min_value = filter.min_value.value | default: 0 %}
                {% assign max_value = filter.max_value.value | default: filter.range_max %}
                {% capture price_label %}{{ min_value | money }} – {{ max_value | money }}{% endcapture %}
                <li>
                  <a href="{{ filter.url_to_remove }}">
                    {{- 'collection.remove_filter' | t: filter: price_label -}}
                  </a>
                </li>
              {% endif %}
            {% else %}
              {% for filter_value in filter.active_values %}
                <li>
                  <a href="{{ filter_value.url_to_remove }}">
                    {{- 'collection.remove_filter' | t: filter: filter_value.label -}}
                  </a>
                </li>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endcapture %}

        {% if active_filters != blank %}
          <ul class="main-search__active" role="list" aria-label="{{ 'collection.active_filters' | t }}">
            {{ active_filters }}
            <li>
              <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
            </li>
          </ul>
        {% endif %}
      {% endif %}
    {% endif %}

    {% if search.performed %}
      {% paginate search.results by section.settings.results_per_page %}
        {% if search.results_count > 0 %}
          <ul
            class="main-search__grid"
            role="list"
            style="--columns: {{ section.settings.columns }};"
          >
            {% for result in search.results %}
              <li class="main-search__card">
                {% case result.object_type %}
                  {% when 'product' %}
                    {% render 'product-card', product: result, show_quick_add: section.settings.show_quick_add %}
                  {% when 'article' %}
                    <a class="main-search__image" href="{{ result.url }}" tabindex="-1" aria-hidden="true">
                      {% if result.image %}
                        {{
                          result.image
                          | image_url: width: 1200
                          | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy'
                        }}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder main-search__placeholder' }}
                      {% endif %}
                    </a>
                    <p class="main-search__type text-small">{{ 'search.article' | t }}</p>
                    <a class="main-search__product-title" href="{{ result.url }}">{{ result.title | escape }}</a>
                    <p class="main-search__excerpt text-small">{{ result.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                  {% when 'page' %}
                    <p class="main-search__type text-small">{{ 'search.page' | t }}</p>
                    <a class="main-search__product-title" href="{{ result.url }}">{{ result.title | escape }}</a>
                    <p class="main-search__excerpt text-small">{{ result.content | strip_html | truncatewords: 20 }}</p>
                {% endcase %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="main-search__empty">
            {{ 'search.no_results_html' | t: terms: terms }}
            {% if show_filters %}
              <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
            {% endif %}
          </p>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="main-search__pagination" aria-label="{{ 'collection.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% endpaginate %}
    {% elsif request.design_mode %}
      <ul
        class="main-search__grid"
        role="list"
        style="--columns: {{ section.settings.columns }};"
      >
        {% for i in (1..placeholder_count) %}
          {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
          <li>
            {% render 'product-card', placeholder: placeholder %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% javascript %}
  class SearchFacets extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form');
      form.addEventListener('change', (event) => {
        if (event.target.type !== 'number') form.requestSubmit();
      });
    }
  }

  if (!customElements.get('search-facets')) {
    customElements.define('search-facets', SearchFacets);
  }
{% endjavascript %}

{% stylesheet %}
  .main-search {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-search__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .main-search__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .main-search__title {
    margin: 0;
  }

  .main-search__facets {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .main-search__filter {
    position: relative;
  }

  .main-search__filter summary {
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .main-search__filter-values {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 14rem;
    max-height: 20rem;
    overflow-y: auto;
    margin-top: var(--space-2xs);
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
  }

  .main-search__filter-value {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .main-search__filter-value:has(input:disabled) {
    opacity: var(--opacity-disabled);
  }

  .main-search__price-range {
    display: flex;
    gap: var(--space-md);
  }

  .main-search__price-range label,
  .main-search__sort {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .main-search__price-range input {
    width: 6rem;
  }

  .main-search__sort {
    margin-inline-start: auto;
  }

  .main-search :is(input[type='number'], select) {
    padding: var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .main-search__apply {
    align-self: flex-end;
  }

  .main-search__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-search__active a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-badges);
    color: inherit;
    text-decoration: none;
  }

  .main-search__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .main-search__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .main-search__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .main-search__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
  }

  .main-search__image img,
  .main-search__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-search__product-title {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.main-search__product-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .main-search__empty {
    margin: 0;
  }


  .main-search__pagination {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .main-search__pagination :is(a, span) {
    padding: var(--space-2xs) var(--space-sm);
    color: inherit;
  }

  .main-search__pagination .current {
    font-weight: bold;
  }
  .main-search__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    max-width: var(--width-text);
  }

  .main-search__form input {
    flex: 1 1 14rem;
    padding: var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .main-search__count,
  .main-search__type,
  .main-search__excerpt {
    margin: 0;
  }

  .main-search__type {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: var(--opacity-muted);
  }

  .main-search__excerpt {
    opacity: var(--opacity-muted);
  }


{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search_results",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:labels.enable_filtering",
      "info": "t:info.main_collection_enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:labels.enable_sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:labels.results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.search_results"
    }
  ]
}
{% endschema %}
