{% comment %}The search page: the search box and the results (products, articles and pages), with filters and sorting.{% endcomment %}
{% liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign show_filters = false
  if section.settings.enable_filtering and search.performed and search.filters.size > 0
    assign show_filters = true
  endif
  assign show_sorting = false
  if section.settings.enable_sorting and search.performed
    assign show_sorting = true
  endif
  assign placeholder_count = section.settings.columns | times: 2
  assign encoded_terms = search.terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign terms = search.terms | escape
%}

<div class="main-search full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}" style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};">
  <div class="main-search__inner">
    <div class="main-search__header">
      <h1 class="main-search__title">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form">
        <input
          type="search"
          name="q"
          value="{{ terms }}"
          placeholder="{{ 'search.placeholder' | t }}"
          aria-label="{{ 'search.title' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button main-search__apply">{{ 'search.submit' | t }}</button>
      </form>
    </div>

    {% if search.performed %}
      <facet-filters class="main-search__results" data-section-id="{{ section.id }}">
        {% if show_filters or show_sorting %}
          <button
            type="button"
            class="button button--secondary main-search__open"
            aria-haspopup="dialog"
            data-facets-open
          >
            {{ 'collection.filter_and_sort' | t }}
          </button>
          <dialog class="main-search__drawer" aria-labelledby="FacetsTitle-{{ section.id }}">
            <form class="main-search__facets" action="{{ routes.search_url }}" method="get" data-facets-part="form">
              <div class="main-search__drawer-header">
                <h2 id="FacetsTitle-{{ section.id }}" class="main-search__drawer-title text-h4">
                  {{- 'collection.filter_and_sort' | t -}}
                </h2>
                <button type="button" class="main-search__close" aria-label="{{ 'collection.close_filters' | t }}" data-facets-close>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m5 5 10 10M15 5 5 15" />
                  </svg>
                </button>
              </div>
              <input type="hidden" name="q" value="{{ search.terms | escape }}">
              <input type="hidden" name="options[prefix]" value="last">

              {% if show_filters %}
                {% for filter in search.filters %}
                  <details class="main-search__filter">
                    <summary>{{ filter.label | escape }}</summary>
                    <div class="main-search__filter-values">
                      {% case filter.type %}
                        {% when 'price_range' %}
                          <div class="main-search__price-range">
                            <label>
                              {{ 'collection.price_from' | t }}
                              <input
                                type="number"
                                name="{{ filter.min_value.param_name }}"
                                min="0"
                                step="any"
                                max="{{ filter.range_max | divided_by: 100.0 }}"
                                placeholder="0"
                                {% if filter.min_value.value %}
                                  value="{{ filter.min_value.value | divided_by: 100.0 }}"
                                {% endif %}
                              >
                            </label>
                            <label>
                              {{ 'collection.price_to' | t }}
                              <input
                                type="number"
                                name="{{ filter.max_value.param_name }}"
                                min="0"
                                step="any"
                                max="{{ filter.range_max | divided_by: 100.0 }}"
                                placeholder="{{ filter.range_max | divided_by: 100.0 }}"
                                {% if filter.max_value.value %}
                                  value="{{ filter.max_value.value | divided_by: 100.0 }}"
                                {% endif %}
                              >
                            </label>
                          </div>
                        {% else %}
                          {% for filter_value in filter.values %}
                            <label class="main-search__filter-value">
                              <input
                                type="checkbox"
                                name="{{ filter_value.param_name }}"
                                value="{{ filter_value.value }}"
                                {% if filter_value.active %}
                                  checked
                                {% endif %}
                                {% if filter_value.count == 0 and filter_value.active == false %}
                                  disabled
                                {% endif %}
                              >
                              {{ filter_value.label | escape }} ({{ filter_value.count }})
                            </label>
                          {% endfor %}
                      {% endcase %}
                    </div>
                  </details>
                {% endfor %}
              {% endif %}

              {% if show_sorting %}
                <label class="main-search__sort">
                  {{ 'collection.sort_by' | t }}
                  <select name="sort_by">
                    {% for option in search.sort_options %}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected
                        {% endif %}
                      >
                        {{- option.name | escape -}}
                      </option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}

              <button type="submit" class="button main-search__apply">{{ 'collection.apply' | t }}</button>
            </form>
            <div class="main-search__drawer-footer" role="status">
              <button type="button" class="button main-search__show" data-facets-close>
                <span data-facets-part="show">{{ 'collection.show_results' | t: count: search.results_count }}</span>
              </button>
            </div>
          </dialog>
        {% endif %}

        <p class="main-search__count" role="status" tabindex="-1" data-facets-part="count">
          {%- if search.results_count > 0 -%}
            {{ 'search.results_for_html' | t: terms: terms, count: search.results_count }}
          {%- else -%}
            {{ 'search.no_results_html' | t: terms: terms }}
          {%- endif -%}
        </p>

        <div class="main-search__part" data-facets-part="active" data-facets-link>
          {% if show_filters %}
            {% capture active_filters %}
              {% for filter in search.filters %}
                {% if filter.type == 'price_range' %}
                  {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                    {% assign min_value = filter.min_value.value | default: 0 %}
                    {% assign max_value = filter.max_value.value | default: filter.range_max %}
                    {% capture price_label %}{{ min_value | money }} – {{ max_value | money }}{% endcapture %}
                    <li>
                      <a href="{{ filter.url_to_remove }}">
                        {{- 'collection.remove_filter' | t: filter: price_label -}}
                      </a>
                    </li>
                  {% endif %}
                {% else %}
                  {% for filter_value in filter.active_values %}
                    <li>
                      <a href="{{ filter_value.url_to_remove }}">
                        {{- 'collection.remove_filter' | t: filter: filter_value.label -}}
                      </a>
                    </li>
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endcapture %}

            {% if active_filters != blank %}
              <ul class="main-search__active" role="list" aria-label="{{ 'collection.active_filters' | t }}">
                {{ active_filters }}
                <li>
                  <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
                </li>
              </ul>
            {% endif %}
          {% endif %}
        </div>

        <div class="main-search__part" data-facets-part="results">
          {% paginate search.results by section.settings.results_per_page %}
            {% if search.results_count > 0 %}
              <ul
                class="main-search__grid"
                role="list"
                data-load-more-grid
                style="--columns: {{ section.settings.columns }};"
              >
                {% for result in search.results %}
                  <li class="main-search__card">
                    {% case result.object_type %}
                      {% when 'product' %}
                        {% render 'product-card', product: result, show_quick_add: section.settings.show_quick_add, anatomy: section.settings.card_anatomy %}
                      {% when 'article' %}
                        <a class="main-search__image" href="{{ result.url }}" tabindex="-1" aria-hidden="true">
                          {% if result.image %}
                            {{
                              result.image
                              | image_url: width: 1200
                              | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy'
                            }}
                          {% else %}
                            {{ 'image' | placeholder_svg_tag: 'placeholder main-search__placeholder' }}
                          {% endif %}
                        </a>
                        <p class="main-search__type text-small">{{ 'search.article' | t }}</p>
                        <a class="main-search__product-title" href="{{ result.url }}">{{ result.title | escape }}</a>
                        <p class="main-search__excerpt text-small">{{ result.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                      {% when 'page' %}
                        <p class="main-search__type text-small">{{ 'search.page' | t }}</p>
                        <a class="main-search__product-title" href="{{ result.url }}">{{ result.title | escape }}</a>
                        <p class="main-search__excerpt text-small">{{ result.content | strip_html | truncatewords: 20 }}</p>
                    {% endcase %}
                  </li>
                {% endfor %}
              </ul>
            {% elsif show_filters %}
              <p class="main-search__empty" data-facets-link>
                <a href="{{ clear_url }}">{{ 'collection.clear_all' | t }}</a>
              </p>
            {% endif %}

            {% if paginate.pages > 1 %}
              <load-more class="main-search__more" data-section-id="{{ section.id }}">
                {% if paginate.next %}
                  <a class="button button--secondary main-search__load-more" href="{{ paginate.next.url }}" data-load-more>
                    {{- 'collection.load_more' | t -}}
                  </a>
                {% endif %}
                <nav class="main-search__pagination" aria-label="{{ 'collection.pagination' | t }}">
                  {{ paginate | default_pagination }}
                </nav>
              </load-more>
            {% endif %}
          {% endpaginate %}

          {% if search.results_count == 0 and active_filters == blank %}
            {% assign suggestion = section.settings.no_results_collection %}
            <div class="main-search__suggestions">
              <div class="main-search__tips">
                <h2 class="text-h5">{{ 'search.tips_title' | t }}</h2>
                <ul>
                  <li>{{ 'search.tips.spelling' | t }}</li>
                  <li>{{ 'search.tips.fewer_words' | t }}</li>
                  <li>{{ 'search.tips.other_words' | t }}</li>
                </ul>
              </div>

              {% capture suggestions %}
                {% if suggestion != blank and suggestion.products_count > 0 %}
                  <ul class="main-search__grid" role="list" style="--columns: {{ section.settings.columns }};">
                    {% for product in suggestion.products limit: section.settings.columns %}
                      <li>
                        {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, anatomy: section.settings.card_anatomy %}
                      </li>
                    {% endfor %}
                  </ul>
                {% elsif collections.size > 0 %}
                  <ul class="main-search__collections" role="list">
                    {% for collection in collections limit: 12 %}
                      <li>
                        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% endcapture %}

              {% if suggestions != blank %}
                {% if section.settings.no_results_heading != blank %}
                  <h2 class="main-search__suggestions-title">{{ section.settings.no_results_heading | escape }}</h2>
                {% endif %}
                {{ suggestions }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </facet-filters>
    {% elsif request.design_mode %}
      <ul
        class="main-search__grid"
        role="list"
        style="--columns: {{ section.settings.columns }};"
      >
        {% for i in (1..placeholder_count) %}
          {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
          <li>
            {% render 'product-card', placeholder: placeholder, anatomy: section.settings.card_anatomy %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% javascript %}
  class FacetFilters extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      this.form = this.querySelector('form');
      this.abort = new AbortController();
      this.addEventListener('click', (event) => {
        if (event.target.closest('[data-facets-open]')) return this.dialog.showModal();
        if (event.target.closest('[data-facets-close]') || event.target === this.dialog) return this.dialog.close();
        const link = event.target.closest('[data-facets-link] a');
        if (!link) return;
        event.preventDefault();
        this.update(new URL(link.href));
      });
      this.form?.addEventListener('change', () => this.update(this.formUrl()));
      this.form?.addEventListener('submit', (event) => {
        event.preventDefault();
        this.update(this.formUrl());
      });
      matchMedia('(min-width: 750px)').addEventListener('change', () => this.dialog?.close(), { signal: this.abort.signal });
    }

    disconnectedCallback() {
      this.abort.abort();
    }

    formUrl() {
      const url = new URL(this.form.action);
      url.search = new URLSearchParams(new FormData(this.form));
      return url;
    }

    async update(url) {
      this.request?.abort();
      this.request = new AbortController();
      const fetchUrl = new URL(url);
      fetchUrl.searchParams.set('section_id', this.dataset.sectionId);
      try {
        const response = await fetch(fetchUrl, { signal: this.request.signal });
        if (!response.ok) throw new Error(response.statusText);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const focused = document.activeElement;
        const hadFocus = this.contains(focused);
        const key = hadFocus && focused.name ? `[name="${CSS.escape(focused.name)}"]` : null;
        const value = key && focused.type === 'checkbox' ? focused.value : null;
        const open = [...this.querySelectorAll('form details')].map((details) => details.open);
        for (const part of this.querySelectorAll('[data-facets-part]')) {
          const next = html.querySelector(`[data-facets-part="${part.dataset.facetsPart}"]`);
          if (next) part.replaceChildren(...next.childNodes);
        }
        this.querySelectorAll('form details').forEach((details, index) => (details.open = open[index] ?? false));
        history.replaceState(null, '', url);
        let target = null;
        if (key) target = [...this.querySelectorAll(key)].find((input) => value === null || input.value === value);
        else if (hadFocus && !focused.isConnected) target = this.querySelector('[data-facets-part="count"]');
        target?.focus();
      } catch (error) {
        if (error.name !== 'AbortError') window.location.assign(url);
      }
    }
  }

  if (!customElements.get('facet-filters')) {
    customElements.define('facet-filters', FacetFilters);
  }

  class LoadMore extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', (event) => {
        const link = event.target.closest('[data-load-more]');
        if (!link) return;
        event.preventDefault();
        this.load(link);
      });
    }

    async load(link) {
      if (this.loading) return;
      this.loading = true;
      const url = new URL(link.href);
      url.searchParams.set('section_id', this.dataset.sectionId);
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error(response.statusText);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const items = [...html.querySelector('[data-load-more-grid]').children];
        const grid = this.parentElement.querySelector('[data-load-more-grid]');
        grid.append(...items);
        const next = html.querySelector('[data-load-more]');
        if (next) {
          const nextUrl = new URL(next.getAttribute('href'), link.href);
          nextUrl.searchParams.delete('section_id');
          link.href = nextUrl;
        } else {
          link.remove();
          this.dataset.done = '';
        }
        this.querySelector('nav').replaceWith(html.querySelector('load-more nav'));
        items[0]?.querySelector('a:not([tabindex="-1"]), button')?.focus();
      } catch {
        window.location.assign(link.href);
      } finally {
        this.loading = false;
      }
    }
  }

  if (!customElements.get('load-more')) {
    customElements.define('load-more', LoadMore);
  }
{% endjavascript %}

{% stylesheet %}
  .main-search {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .main-search__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .main-search__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .main-search__title {
    margin: 0;
  }

  .main-search__results,
  .main-search__part {
    display: contents;
  }

  .main-search__drawer {
    display: block;
    position: static;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  facet-filters .main-search__open,
  .main-search__drawer-header,
  .main-search__drawer-footer {
    display: none;
  }

  facet-filters:defined .main-search__apply {
    display: none;
  }

  .main-search__drawer[open] {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    width: min(24rem, 100vw);
    height: 100dvh;
    margin-inline-start: auto;
    background-color: var(--color-background);
  }

  .main-search__drawer::backdrop {
    background-color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }

  .main-search__drawer[open] .main-search__facets {
    flex-direction: column;
    flex-wrap: nowrap;
    flex: 1;
    align-items: stretch;
    overflow-y: auto;
    padding: var(--space-lg);
  }

  .main-search__drawer[open] .main-search__drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .main-search__drawer-title {
    margin: 0;
  }

  .main-search__close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .main-search__close svg {
    width: 2rem;
  }

  .main-search__drawer[open] .main-search__filter-values {
    position: static;
    min-width: 0;
    max-height: none;
    padding: var(--space-sm) 0 0;
    border: 0;
  }

  .main-search__drawer[open] .main-search__sort {
    margin-inline-start: 0;
  }

  .main-search__drawer[open] .main-search__drawer-footer {
    display: block;
    padding: var(--space-md) var(--space-lg);
    border-block-start: var(--border-width) solid var(--color-border-subtle);
  }

  .main-search__show {
    width: 100%;
  }

  .main-search__facets {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .main-search__filter {
    position: relative;
  }

  .main-search__filter summary {
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .main-search__filter-values {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 14rem;
    max-height: 20rem;
    overflow-y: auto;
    margin-top: var(--space-2xs);
    padding: var(--space-md);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
  }

  .main-search__filter-value {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: var(--target-size-min);
  }

  .main-search__filter-value:has(input:disabled) {
    opacity: var(--opacity-disabled);
  }

  .main-search__price-range {
    display: flex;
    gap: var(--space-md);
  }

  .main-search__price-range label,
  .main-search__sort {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .main-search__price-range input {
    width: 6rem;
  }

  .main-search__sort {
    margin-inline-start: auto;
  }

  .main-search :is(input[type='number'], select) {
    padding: var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .main-search__apply {
    align-self: flex-end;
  }

  .main-search__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-search__active a {
    display: block;
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-badges);
    color: inherit;
    text-decoration: none;
  }

  .main-search__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-row-gap) var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .main-search__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .main-search__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .main-search__image {
    display: block;
    aspect-ratio: var(--image-ratio);
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
  }

  .main-search__image img,
  .main-search__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-search__product-title {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.main-search__product-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .main-search__empty {
    margin: 0;
  }

  .main-search__suggestions {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .main-search__tips :is(h2, ul),
  .main-search__suggestions-title {
    margin: 0;
  }

  .main-search__tips ul {
    padding-inline-start: var(--space-lg);
  }

  .main-search__collections {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-search__collections a {
    display: flex;
    align-items: center;
    min-block-size: var(--target-size-min);
    padding: var(--space-2xs) var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-badges);
    color: inherit;
    text-decoration: none;
  }


  .main-search__more {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-search__more .main-search__load-more {
    display: none;
  }

  .main-search__pagination {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .main-search__pagination :is(a, span) {
    padding: var(--space-2xs) var(--space-sm);
    color: inherit;
  }

  .main-search__pagination .current {
    font-weight: bold;
  }

  @media (max-width: 749px) {
    facet-filters:defined .main-search__open {
      display: inline-flex;
    }

    facet-filters:defined .main-search__drawer:not([open]) {
      display: none;
    }

    .main-search__active {
      flex-wrap: nowrap;
      overflow-x: auto;
    }

    .main-search__active a {
      white-space: nowrap;
    }

    load-more:defined .main-search__load-more {
      display: flex;
    }

    load-more:defined:is(:has(.main-search__load-more), [data-done]) .main-search__pagination {
      display: none;
    }
  }
  .main-search__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    max-width: var(--width-text);
  }

  .main-search__form input {
    flex: 1 1 14rem;
    padding: var(--space-xs);
    border: var(--border-width) solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .main-search__count,
  .main-search__type,
  .main-search__excerpt {
    margin: 0;
  }

  .main-search__type {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground-muted);
  }

  .main-search__excerpt {
    color: var(--color-foreground-muted);
  }


{% endstylesheet %}

