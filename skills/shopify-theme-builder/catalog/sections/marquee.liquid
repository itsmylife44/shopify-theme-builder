      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "item_style",
      "label": "t:labels.item_style",
      "options": [
        {
          "value": "text",
          "label": "t:options.item_style.text"
        },
        {
          "value": "badge",
          "label": "t:options.item_style.badge"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "speed",
      "label": "t:labels.speed",
      "info": "t:info.marquee_speed",
      "options": [
        {
          "value": "slow",
          "label": "t:options.speed.slow"
        },
        {
          "value": "medium",
          "label": "t:options.speed.medium"
        },
        {
          "value": "fast",
          "label": "t:options.speed.fast"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:general.item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Free shipping over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.marquee",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Free shipping over $50"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Made to last"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free returns for 30 days"
          }
        }
      ]
    },
    {
      "name": "t:general.marquee_badges",
      "settings": { "item_style": "badge" },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Free shipping over $50"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Made to last"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free returns for 30 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
