{% comment %}An email signup under a heading and text.{% endcomment %}
<div class="newsletter full-width color-{{ section.settings.color_scheme }}">
  <div class="newsletter__inner">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="newsletter__text rte">{{ section.settings.text }}</div>
    {% endif %}

    {% assign form_id = 'Newsletter-' | append: section.id %}
    {% form 'customer', id: form_id, class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        autocomplete="email"
        required
        placeholder="{{ 'footer.newsletter_email' | t }}"
        aria-label="{{ 'footer.newsletter_email' | t }}"
      >
      <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
      {% if form.posted_successfully? %}
        <p class="newsletter__message" role="status">{{ 'footer.newsletter_success' | t }}</p>
      {% elsif form.errors %}
        <div class="newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .newsletter__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--section-spacing);
    text-align: center;
  }

  .newsletter__text {
    max-width: var(--width-text);
  }

  .newsletter__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    max-width: var(--width-narrow);
  }

  .newsletter__form input[type='email'] {
    flex: 1 1 14rem;
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .newsletter__message {
    flex-basis: 100%;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Be the first to hear about new products and exclusive offers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}
