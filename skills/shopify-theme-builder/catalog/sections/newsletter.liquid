{% comment %}An email signup under a heading and text.{% endcomment %}
<div class="newsletter full-width newsletter--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}"{% if section.settings.reveal %} data-reveal{% endif %} style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};">
  <div class="newsletter__inner">
    {% if section.settings.layout == 'split' %}
      <div class="newsletter__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag: widths: '375, 550, 750, 1100, 1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder newsletter__placeholder' }}
        {% endif %}
      </div>
    {% endif %}

    <div class="newsletter__body">
      <div class="newsletter__content">
        {% if section.settings.heading != blank %}
          <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="newsletter__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      {% assign form_id = 'Newsletter-' | append: section.id %}
      {% form 'customer', id: form_id, class: 'newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="{{ form_id }}-email" class="visually-hidden">{{ 'footer.newsletter_email' | t }}</label>
        <input
          id="{{ form_id }}-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'footer.newsletter_email' | t }}"
        >
        <button type="submit" class="button">{{ section.settings.button_label | escape }}</button>
        {% if form.posted_successfully? %}
          <p class="newsletter__message" role="status">{{ 'footer.newsletter_success' | t }}</p>
        {% elsif form.errors %}
          <div class="newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .newsletter__inner {
    grid-column: 2;
    display: grid;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .newsletter__body,
  .newsletter__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .newsletter--centered .newsletter__body,
  .newsletter--centered .newsletter__content {
    align-items: center;
    text-align: center;
  }

  .newsletter__text {
    max-width: var(--width-text);
  }

  .newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    width: 100%;
    max-width: var(--width-narrow);
  }

  .newsletter--centered .newsletter__form {
    justify-content: center;
  }

  .newsletter__form input[type='email'] {
    flex: 1 1 14rem;
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .newsletter__message {
    flex-basis: 100%;
    margin: 0;
  }

  .newsletter__media {
    aspect-ratio: var(--image-ratio);
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
  }

  .newsletter__media img,
  .newsletter__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 750px) {
    .newsletter--split .newsletter__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .newsletter--inline .newsletter__body {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2xl);
    }

    .newsletter--inline .newsletter__content,
    .newsletter--inline .newsletter__form {
      flex: 1 1 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "card", "label": "t:options.image_ratio.card" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "natural", "label": "t:options.image_ratio.natural" }
      ],
      "default": "card"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "centered", "label": "t:options.layout.centered" },
        { "value": "split", "label": "t:options.layout.split" },
        { "value": "inline", "label": "t:options.layout.inline" }
      ],
      "default": "centered"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Be the first to hear about new products and exclusive offers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:labels.reveal",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    },
    {
      "name": "t:general.newsletter_split",
      "settings": {
        "layout": "split"
      }
    },
    {
      "name": "t:general.newsletter_inline",
      "settings": {
        "layout": "inline"
      }
    }
  ]
}
{% endschema %}
