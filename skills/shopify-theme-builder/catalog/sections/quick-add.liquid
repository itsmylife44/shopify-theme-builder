{% comment %}The quick add dialog of product cards, with the variant picker and add to cart, fetched through the Section Rendering API.{% endcomment %}
{% # theme-check-disable ValidScopedCSSClass %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  if product.requires_selling_plan
    assign selling_plan_allocation = current_variant.selling_plan_allocations.first
  endif
  if selling_plan_allocation
    assign price = selling_plan_allocation.price
    assign compare_at_price = selling_plan_allocation.compare_at_price
  else
    assign price = current_variant.price
    assign compare_at_price = current_variant.compare_at_price
  endif
%}

{% if product != blank %}
  <quick-add-dialog>
    <dialog class="quick-add color-{{ section.settings.color_scheme }}" aria-labelledby="QuickAddTitle">
      <div class="quick-add__inner" data-url="{{ product.url }}">
        <form method="dialog">
          <button class="quick-add__close" aria-label="{{ 'quick_add.close' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m5 5 10 10M15 5 5 15" />
            </svg>
          </button>
        </form>

        <div class="quick-add__summary">
          <div class="quick-add__media">
            {% if featured_media %}
              {{
                featured_media.preview_image
                | image_url: width: 400
                | image_tag: widths: '200, 400', sizes: '8rem', loading: 'lazy'
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder quick-add__placeholder' }}
            {% endif %}
          </div>
          <div>
            <h2 id="QuickAddTitle" class="quick-add__title text-h4">{{ product.title | escape }}</h2>
            <p class="quick-add__price">
              {% if compare_at_price > price %}
                <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
                {{ price | money }}
                <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
                <s class="quick-add__compare-at">{{ compare_at_price | money }}</s>
              {% else %}
                {{ price | money }}
              {% endif %}
            </p>
            {% if selling_plan_allocation %}
              <p class="quick-add__plan">{{ selling_plan_allocation.selling_plan.name | escape }}</p>
            {% endif %}
          </div>
        </div>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="quick-add__option">
              <legend>{{ option.name | escape }}</legend>
              {% for option_value in option.values %}
                {% capture input_id %}QuickAdd-{{ option.position }}-{{ forloop.index0 }}{% endcapture %}
                <input
                  id="{{ input_id }}"
                  class="quick-add__option-input visually-hidden"
                  type="radio"
                  name="QuickAdd-option-{{ option.position }}"
                  value="{{ option_value | escape }}"
                  data-option-value-id="{{ option_value.id }}"
                  {% if option_value.product_url %}
                    data-product-url="{{ option_value.product_url }}"
                  {% endif %}
                  {% if option_value.selected %}
                    checked
                  {% endif %}
                >
                <label
                  for="{{ input_id }}"
                  class="quick-add__option-label{% unless option_value.available %} quick-add__option-label--unavailable{% endunless %}"
                >
                  {{- option_value | escape -}}
                  {% unless option_value.available %}
                    <span class="visually-hidden">{{ 'product.unavailable' | t }}</span>
                  {% endunless %}
                </label>
              {% endfor %}
            </fieldset>
          {% endfor %}
        {% endunless %}

        {% form 'product', product, id: 'QuickAddForm', class: 'quick-add__form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% if selling_plan_allocation %}
            <input type="hidden" name="selling_plan" value="{{ selling_plan_allocation.selling_plan.id }}">
          {% endif %}
          <button
            type="submit"
            class="button quick-add__add"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              {{ 'product.add_to_cart' | t }}
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>
        {% endform %}

        <a class="quick-add__details" href="{{ product.url }}">{{ 'quick_add.view_details' | t }}</a>
      </div>
    </dialog>
  </quick-add-dialog>
{% endif %}

{% schema %}
{
  "name": "t:general.quick_add",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
