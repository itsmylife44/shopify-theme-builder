{% liquid
  assign show_placeholders = false
  if recommendations.performed? and recommendations.products_count == 0 and request.design_mode
    assign show_placeholders = true
  endif
%}

<div class="related-products full-width color-{{ section.settings.color_scheme }}">
  <product-recommendations
    class="related-products__inner"
    {% unless recommendations.performed? %}
      data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ section.settings.products_to_show }}&intent=related"
    {% endunless %}
  >
    {% if recommendations.products_count > 0 or show_placeholders %}
      <div class="related-products__content">
        {% if section.settings.heading != blank %}
          <h2 class="related-products__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <ul
          class="related-products__grid"
          role="list"
          style="--columns: {{ section.settings.columns }};"
        >
          {% if show_placeholders %}
            {% for i in (1..section.settings.products_to_show) %}
              {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
              <li class="related-products__card">
                <div class="related-products__image">
                  {{ 'product-' | append: placeholder | placeholder_svg_tag: 'related-products__placeholder' }}
                </div>
                <p class="related-products__title">{{ 'related_products.product_title' | t }}</p>
                <p class="related-products__price">{{ 1999 | money }}</p>
              </li>
            {% endfor %}
          {% else %}
            {% for recommendation in recommendations.products %}
              <li class="related-products__card">
                <a class="related-products__image" href="{{ recommendation.url }}" tabindex="-1" aria-hidden="true">
                  {% if recommendation.featured_image %}
                    {{
                      recommendation.featured_image
                      | image_url: width: 1200
                      | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'related-products__placeholder' }}
                  {% endif %}
                </a>
                <a class="related-products__title" href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a>
                <p class="related-products__price">{{ recommendation.price | money }}</p>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    {% endif %}
  </product-recommendations>
</div>

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    async connectedCallback() {
      if (!this.dataset.url) return;
      const text = await fetch(this.dataset.url)
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!text) return;
      const fresh = new DOMParser().parseFromString(text, 'text/html').querySelector('product-recommendations');
      if (fresh) this.replaceChildren(...fresh.childNodes);
    }
  }

  if (!customElements.get('product-recommendations')) {
    customElements.define('product-recommendations', ProductRecommendations);
  }
{% endjavascript %}

{% stylesheet %}
  .related-products {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .related-products__inner {
    grid-column: 2;
  }

  .related-products__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-block: 3rem;
  }

  .related-products__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .related-products__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .related-products__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .related-products__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .related-products__image img,
  .related-products__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-products__placeholder {
    background-color: rgb(from var(--color-foreground) r g b / 0.08);
    fill: rgb(from var(--color-foreground) r g b / 0.4);
  }

  .related-products__title {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.related-products__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  a.related-products__title:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .related-products__price {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.related_products"
    }
  ]
}
{% endschema %}
