{% comment %}Related or complementary products Shopify recommends alongside the one on the page.{% endcomment %}
{% liquid
  assign show_placeholders = false
  if recommendations.performed? and recommendations.products_count == 0 and request.design_mode
    assign show_placeholders = true
  endif
%}

<div class="related-products full-width color-{{ section.settings.color_scheme }}">
  <product-recommendations
    class="related-products__inner"
    {% unless recommendations.performed? %}
      data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    {% endunless %}
  >
    {% if recommendations.products_count > 0 or show_placeholders %}
      <div class="related-products__content">
        {% if section.settings.heading != blank %}
          <h2 class="related-products__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <ul
          class="related-products__grid"
          role="list"
          style="--columns: {{ section.settings.columns }};"
        >
          {% if show_placeholders %}
            {% for i in (1..section.settings.products_to_show) %}
              {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
              <li class="related-products__card">
                <div class="related-products__image">
                  {{ 'product-' | append: placeholder | placeholder_svg_tag: 'placeholder related-products__placeholder' }}
                </div>
                <p class="related-products__title">{{ 'related_products.product_title' | t }}</p>
                <p class="related-products__price">{{ 1999 | money }}</p>
              </li>
            {% endfor %}
          {% else %}
            {% for recommendation in recommendations.products %}
              <li class="related-products__card">
                <a class="related-products__image" href="{{ recommendation.url }}" tabindex="-1" aria-hidden="true">
                  {% if recommendation.featured_image %}
                    {{
                      recommendation.featured_image
                      | image_url: width: 1200
                      | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy'
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder related-products__placeholder' }}
                  {% endif %}
                </a>
                <a class="related-products__title" href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a>
                <p class="related-products__price">{{ recommendation.price | money }}</p>
                {% assign unit_variant = recommendation.selected_or_first_available_variant %}
                {% if unit_variant.unit_price_measurement %}
                  <p class="related-products__unit-price text-small">
                    <span class="visually-hidden">{{ 'product.unit_price' | t }}</span>
                    {{ unit_variant.unit_price | unit_price_with_measurement: unit_variant.unit_price_measurement }}
                  </p>
                {% endif %}
                {% if section.settings.show_quick_add %}
                  {% if recommendation.has_only_default_variant and recommendation.requires_selling_plan == false %}
                    <form class="related-products__quick-add" action="{{ routes.cart_add_url }}" method="post" data-quick-add-form>
                      <input type="hidden" name="id" value="{{ recommendation.selected_or_first_available_variant.id }}">
                      {% if recommendation.available %}
                        <button
                          type="submit"
                          class="related-products__quick-add-button"
                          aria-label="{{ 'quick_add.add_label' | t: product: recommendation.title }}"
                        >
                          {{- 'quick_add.add' | t -}}
                        </button>
                      {% else %}
                        <button type="button" class="related-products__quick-add-button" disabled>{{ 'product.sold_out' | t }}</button>
                      {% endif %}
                    </form>
                  {% else %}
                    <a
                      class="related-products__quick-add-button"
                      href="{{ recommendation.url }}"
                      aria-haspopup="dialog"
                      aria-label="{{ 'quick_add.choose_options_label' | t: product: recommendation.title }}"
                      data-quick-add
                    >
                      {{- 'quick_add.choose_options' | t -}}
                    </a>
                  {% endif %}
                {% endif %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    {% endif %}
  </product-recommendations>
</div>

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    async connectedCallback() {
      if (!this.dataset.url) return;
      const text = await fetch(this.dataset.url)
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!text) return;
      const fresh = new DOMParser().parseFromString(text, 'text/html').querySelector('product-recommendations');
      if (fresh) this.replaceChildren(...fresh.childNodes);
    }
  }

  if (!customElements.get('product-recommendations')) {
    customElements.define('product-recommendations', ProductRecommendations);
  }
{% endjavascript %}

{% stylesheet %}
  .related-products {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .related-products__inner {
    grid-column: 2;
  }

  .related-products__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-md);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .related-products__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }

  .related-products__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .related-products__image {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .related-products__image img,
  .related-products__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-products__title {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.related-products__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .related-products__price {
    margin: 0;
  }

  .related-products__unit-price {
    margin: 0;
    opacity: var(--opacity-muted);
  }

  .related-products__quick-add {
    display: contents;
  }

  .related-products__quick-add-button {
    align-self: start;
    margin-block-start: auto;
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--color-button);
    background-color: var(--color-button);
    color: var(--color-button-label);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .related-products__quick-add-button:disabled {
    opacity: var(--opacity-disabled);
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.recommendations",
      "info": "t:info.related_products_intent",
      "options": [
        { "value": "related", "label": "t:options.recommendations.related" },
        { "value": "complementary", "label": "t:options.recommendations.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.related_products"
    },
    {
      "name": "t:general.complementary_products",
      "settings": {
        "intent": "complementary",
        "heading": "Pairs well with"
      }
    }
  ]
}
{% endschema %}
