{% comment %}Related or complementary products Shopify recommends alongside the one on the page.{% endcomment %}
{% liquid
  assign show_placeholders = false
  if recommendations.performed? and recommendations.products_count == 0 and request.design_mode
    assign show_placeholders = true
  endif
%}

<div class="related-products full-width color-{{ section.settings.color_scheme }}" data-spacing="{{ section.settings.spacing }}">
  <product-recommendations
    class="related-products__inner"
    {% unless recommendations.performed? %}
      data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    {% endunless %}
  >
    {% if recommendations.products_count > 0 or show_placeholders %}
      <div class="related-products__content">
        {% if section.settings.heading != blank %}
          <h2 class="related-products__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <ul
          class="related-products__grid"
          role="list"
          style="--columns: {{ section.settings.columns }};"
        >
          {% if show_placeholders %}
            {% for i in (1..section.settings.products_to_show) %}
              {% assign placeholder = i | minus: 1 | modulo: 6 | plus: 1 %}
              <li>
                {% render 'product-card', placeholder: placeholder, anatomy: section.settings.card_anatomy %}
              </li>
            {% endfor %}
          {% else %}
            {% for recommendation in recommendations.products %}
              <li>
                {% render 'product-card', product: recommendation, show_quick_add: section.settings.show_quick_add, anatomy: section.settings.card_anatomy %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
    {% endif %}
  </product-recommendations>
</div>

{% javascript %}
  class ProductRecommendations extends HTMLElement {
    async connectedCallback() {
      if (!this.dataset.url) return;
      const text = await fetch(this.dataset.url)
        .then((response) => (response.ok ? response.text() : null))
        .catch(() => null);
      if (!text) return;
      const fresh = new DOMParser().parseFromString(text, 'text/html').querySelector('product-recommendations');
      if (fresh) this.replaceChildren(...fresh.childNodes);
    }
  }

  if (!customElements.get('product-recommendations')) {
    customElements.define('product-recommendations', ProductRecommendations);
  }
{% endjavascript %}

{% stylesheet %}
  .related-products {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .related-products__inner {
    grid-column: 2;
  }

  .related-products__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .related-products__grid {
    display: grid;
    gap: var(--grid-row-gap) var(--grid-gap);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mobile: one row that swipes, the next card peeking in, so an odd count never leaves a card alone on a row. */
  @media (max-width: 749px) {
    .related-products__grid {
      grid-auto-flow: column;
      grid-auto-columns: 75%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .related-products__grid > * {
      scroll-snap-align: start;
    }
  }

  @media (min-width: 750px) {
    .related-products__grid {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }









{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:labels.recommendations",
      "info": "t:info.related_products_intent",
      "options": [
        { "value": "related", "label": "t:options.recommendations.related" },
        { "value": "complementary", "label": "t:options.recommendations.complementary" }
      ],
      "default": "related"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "card_anatomy",
      "label": "t:labels.card_anatomy",
      "options": [
        {
          "value": "theme",
          "label": "t:options.card_anatomy.theme"
        },
        {
          "value": "minimal",
          "label": "t:options.card_anatomy.minimal"
        },
        {
          "value": "detailed",
          "label": "t:options.card_anatomy.detailed"
        },
        {
          "value": "editorial",
          "label": "t:options.card_anatomy.editorial"
        }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:labels.show_quick_add",
      "default": true
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    }
  ],
  "presets": [
    {
      "name": "t:general.related_products"
    },
    {
      "name": "t:general.complementary_products",
      "settings": {
        "intent": "complementary",
        "heading": "Pairs well with"
      }
    },
    {
      "name": "t:general.related_products_minimal",
      "settings": {
        "card_anatomy": "minimal"
      }
    },
    {
      "name": "t:general.related_products_detailed",
      "settings": {
        "card_anatomy": "detailed"
      }
    },
    {
      "name": "t:general.related_products_editorial",
      "settings": {
        "card_anatomy": "editorial",
        "products_to_show": 3,
        "columns": 3,
        "show_quick_add": false
      }
    }
  ]
}
{% endschema %}
