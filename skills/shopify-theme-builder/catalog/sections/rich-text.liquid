{% comment %}A heading, text and a button, for a message or a story.{% endcomment %}
<div
  class="rich-text full-width color-{{ section.settings.color_scheme }}"
  style="--text-align: {{ section.settings.alignment | replace: 'left', 'start' | replace: 'right', 'end' }};"
>
  <div class="rich-text__inner">
    {% if section.settings.heading != blank %}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rich-text__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a
        class="button"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .rich-text {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .rich-text__inner {
    grid-column: 2;
    display: grid;
    justify-items: var(--text-align);
    gap: var(--space-md);
    padding-block: var(--section-spacing);
    text-align: var(--text-align);
  }

  .rich-text__inner > * {
    max-width: var(--width-prose);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "center"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Talk about your brand"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.rich_text"
    }
  ]
}
{% endschema %}
