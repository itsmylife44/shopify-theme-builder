{% comment %}Full-width slides, each with an image, heading, text and button, that customers step through.{% endcomment %}
{% liquid
  assign several = false
  if section.blocks.size > 1
    assign several = true
  endif

  assign autoplay = false
  if several and section.settings.autoplay and settings.motion != 'none'
    assign autoplay = true
  endif
%}
{% if section.blocks.size > 0 %}
  <slide-show
    class="slideshow full-width media-edge slideshow--{{ section.settings.height }} color-{{ section.settings.color_scheme }}"
    data-spacing="{{ section.settings.spacing }}"{% if section.settings.reveal %} data-reveal{% endif %}
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ 'slideshow.label' | t }}"
    {% if autoplay %}
      data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
    {% endif %}
  >
    <div class="slideshow__track" {% if several %}tabindex="0"{% endif %}>
      {% for block in section.blocks %}
        {% liquid
          assign loading = 'lazy'
          assign fetchpriority = 'auto'
          assign heading_tag = 'h2'
          if forloop.first and section.index == 1
            assign loading = 'eager'
            assign fetchpriority = 'high'
            assign heading_tag = 'h1'
          elsif forloop.first and section.index <= 3
            assign loading = 'eager'
          endif

          assign sizes = '100vw'
          if block.settings.content_style == 'split'
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          endif

          assign position = block.settings.content_position | split: '_'
          assign content_block = position.first | replace: 'top', 'start' | replace: 'middle', 'center' | replace: 'bottom', 'end'
          assign content_inline = position.last | replace: 'left', 'start' | replace: 'right', 'end'
          assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
          assign image = block.settings.image | default: block.settings.image_mobile
        %}
        <div
          class="slideshow__slide slideshow__slide--{{ block.settings.content_style }}"
          style="--content-block: {{ content_block }}; --content-inline: {{ content_inline }}; --overlay-opacity: {{ overlay_opacity }};"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ 'slideshow.slide' | t: index: forloop.index, count: forloop.length }}"
          {% if forloop.first == false %}
            inert
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="slideshow__media">
            {% if image != blank %}
              <picture>
                {% if block.settings.image_mobile != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 550 }} 550w, {{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ block.settings.image_mobile | image_url: width: 1500 }} 1500w"
                    sizes="100vw"
                    width="{{ block.settings.image_mobile.width }}"
                    height="{{ block.settings.image_mobile.height }}"
                  >
                {% endif %}
                {{
                  image
                  | image_url: width: 3840
                  | image_tag:
                    class: 'slideshow__image',
                    widths: '750, 1100, 1500, 2200, 3000, 3840',
                    sizes: sizes,
                    loading: loading,
                    fetchpriority: fetchpriority
                }}
              </picture>
            {% else %}
              {% assign placeholder = forloop.index0 | modulo: 2 | plus: 1 | prepend: 'lifestyle-' %}
              {{ placeholder | placeholder_svg_tag: 'placeholder slideshow__image slideshow__placeholder' }}
            {% endif %}
          </div>

          {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
            <div class="slideshow__content">
              {% if block.settings.heading != blank %}
                <{{ heading_tag }} class="slideshow__heading text-display">{{ block.settings.heading }}</{{ heading_tag }}>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="slideshow__text">{{ block.settings.text }}</div>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a
                  class="button"
                  href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if several %}
      <div class="slideshow__controls">
        <button type="button" class="slideshow__control" data-step="-1" aria-label="{{ 'slideshow.previous' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m12 5-5 5 5 5" />
          </svg>
        </button>
        {% if autoplay %}
          <button
            type="button"
            class="slideshow__control"
            data-pause
            aria-label="{{ 'slideshow.pause' | t }}"
            data-label-pause="{{ 'slideshow.pause' | t }}"
            data-label-play="{{ 'slideshow.play' | t }}"
            hidden
          >
            <svg class="slideshow__icon-pause" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="M7 5v10m6-10v10" />
            </svg>
            <svg class="slideshow__icon-play" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
              <path stroke="currentColor" stroke-linejoin="round" stroke-width="var(--icon-stroke-width)" d="M7 5v10l8-5z" />
            </svg>
          </button>
        {% endif %}
        <button type="button" class="slideshow__control" data-step="1" aria-label="{{ 'slideshow.next' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="var(--icon-stroke-width)" d="m8 5 5 5-5 5" />
          </svg>
        </button>
      </div>
    {% endif %}
  </slide-show>
{% endif %}

{% stylesheet %}
  .slideshow {
    display: flex;
    flex-direction: column;
  }

  .slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .slideshow__track:focus-visible {
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  .slideshow--small {
    --slide-height: clamp(20rem, 45svh, 32rem);
  }

  .slideshow--medium {
    --slide-height: clamp(24rem, 60svh, 40rem);
  }

  .slideshow--large {
    --slide-height: clamp(28rem, 75svh, 48rem);
  }

  .slideshow--full_screen {
    --slide-height: 100svh;
  }

  .slideshow__slide {
    position: relative;
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: var(--content-grid);
    min-height: var(--slide-height);
    padding-block: var(--section-spacing);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
  }

  .slideshow__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .slideshow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slideshow__content {
    position: relative;
    grid-column: 2;
    align-self: var(--content-block);
    justify-self: var(--content-inline);
    display: flex;
    flex-direction: column;
    align-items: var(--content-inline);
    gap: var(--space-md);
    max-width: var(--width-text);
    text-align: var(--content-inline);
  }

  .slideshow__slide--boxed .slideshow__content {
    padding: var(--space-xl);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .slideshow__slide--bare .slideshow__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-background);
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  .slideshow__slide--split {
    min-height: 0;
    padding-block: 0;
  }

  .slideshow__slide--split .slideshow__media {
    position: relative;
    grid-column: 1 / -1;
    min-height: calc(var(--slide-height) / 2);
  }

  .slideshow__slide--split .slideshow__image {
    position: absolute;
    inset: 0;
  }

  .slideshow__slide--split .slideshow__content {
    padding-block: var(--section-spacing);
  }

  @media (min-width: 750px) {
    .slideshow__slide--split {
      grid-template-columns: 1fr 1fr;
      min-height: var(--slide-height);
    }

    .slideshow__slide--split .slideshow__media {
      grid-column: 1;
    }

    .slideshow__slide--split .slideshow__content {
      padding-inline: var(--space-2xl);
    }
  }

  .slideshow__controls {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
  }

  .slideshow__control {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-size);
    min-block-size: var(--target-size);
    padding: var(--space-xs);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .slideshow__control[hidden] {
    display: none;
  }

  .slideshow__control svg {
    width: 1.5rem;
  }

  .slideshow__control[data-step] svg:dir(rtl) {
    scale: -1 1;
  }

  .slideshow__control[data-paused] .slideshow__icon-pause,
  .slideshow__control:not([data-paused]) .slideshow__icon-play {
    display: none;
  }

  /* With expressive motion, the slide shown slowly zooms in, from its first frame, and eases back once it leaves. */
  @media (prefers-reduced-motion: no-preference) {
    .slideshow__slide:not([inert]) .slideshow__media img {
      scale: var(--motion-hero-zoom);
    }

    .slideshow__media img {
      transition: scale var(--motion-duration-hero-zoom) ease-out;
    }

    @starting-style {
      .slideshow__slide:not([inert]) .slideshow__media img {
        scale: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slideshow__track {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  class SlideShow extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.slideshow__track');
      this.slides = [...this.track.children];
      if (this.slides.length < 2) return;
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.current = 0;

      this.addEventListener(
        'click',
        (event) => {
          const button = event.target.closest('[data-step], [data-pause]');
          if (!button) return;
          if (button.hasAttribute('data-pause')) this.setPaused(!this.paused);
          else this.show(this.current + Number(button.dataset.step));
        },
        { signal }
      );
      this.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const forward = (event.key === 'ArrowRight') === (getComputedStyle(this).direction !== 'rtl');
          this.show(this.current + (forward ? 1 : -1));
        },
        { signal }
      );
      this.track.addEventListener(
        'scroll',
        () => {
          const index = Math.round(Math.abs(this.track.scrollLeft) / this.track.clientWidth);
          if (index !== this.current) this.select(index);
        },
        { signal, passive: true }
      );
      this.addEventListener(
        'shopify:block:select',
        (event) => {
          this.selected = true;
          this.show(this.slides.indexOf(event.target));
        },
        { signal }
      );
      this.addEventListener('shopify:block:deselect', () => (this.selected = false), { signal });

      const delay = Number(this.dataset.autoplay);
      if (!delay || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      this.pauseButton = this.querySelector('[data-pause]');
      this.pauseButton.hidden = false;
      this.timer = setInterval(() => {
        if (!this.paused && !this.selected && !this.matches(':hover, :focus-within')) this.show(this.current + 1);
      }, delay);
    }

    disconnectedCallback() {
      this.controller?.abort();
      clearInterval(this.timer);
    }

    show(index) {
      const slide = this.slides[(index + this.slides.length) % this.slides.length];
      const offset = slide.getBoundingClientRect().left - this.track.getBoundingClientRect().left;
      this.track.scrollBy(offset, 0);
    }

    select(index) {
      this.current = index;
      this.slides.forEach((slide, i) => (slide.inert = i !== index));
    }

    setPaused(paused) {
      this.paused = paused;
      this.pauseButton.toggleAttribute('data-paused', paused);
      this.pauseButton.setAttribute('aria-label', this.pauseButton.dataset[paused ? 'labelPlay' : 'labelPause']);
    }
  }

  if (!customElements.get('slide-show')) customElements.define('slide-show', SlideShow);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.slideshow",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        { "value": "small", "label": "t:options.height.small" },
        { "value": "medium", "label": "t:options.height.medium" },
        { "value": "large", "label": "t:options.height.large" },
        { "value": "full_screen", "label": "t:options.height.full_screen" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.autoplay",
      "info": "t:info.slideshow_autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.change_slides_every",
      "visible_if": "{{ section.settings.autoplay }}",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:labels.reveal",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:labels.image_mobile",
          "info": "t:info.hero_image_mobile"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "t:labels.content_position",
          "options": [
            { "value": "top_left", "label": "t:options.content_position.top_left" },
            { "value": "top_center", "label": "t:options.content_position.top_center" },
            { "value": "top_right", "label": "t:options.content_position.top_right" },
            { "value": "middle_left", "label": "t:options.content_position.middle_left" },
            { "value": "middle_center", "label": "t:options.content_position.middle_center" },
            { "value": "middle_right", "label": "t:options.content_position.middle_right" },
            { "value": "bottom_left", "label": "t:options.content_position.bottom_left" },
            { "value": "bottom_center", "label": "t:options.content_position.bottom_center" },
            { "value": "bottom_right", "label": "t:options.content_position.bottom_right" }
          ],
          "default": "middle_left"
        },
        {
          "type": "select",
          "id": "content_style",
          "label": "t:labels.content_style",
          "options": [
            { "value": "bare", "label": "t:options.content_style.bare" },
            { "value": "boxed", "label": "t:options.content_style.boxed" },
            { "value": "split", "label": "t:options.content_style.split" }
          ],
          "default": "boxed"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:labels.overlay_opacity",
          "info": "t:info.hero_overlay_opacity",
          "visible_if": "{{ block.settings.content_style == 'bare' }}",
          "min": 0,
          "max": 90,
          "step": 10,
          "unit": "%",
          "default": 30
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Welcome to our store"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Tell customers what makes your products special.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:labels.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    },
    {
      "name": "t:general.slideshow_full_screen",
      "settings": { "height": "full_screen" },
      "blocks": [
        {
          "type": "slide",
          "settings": { "content_position": "middle_center", "content_style": "bare", "overlay_opacity": 40 }
        },
        {
          "type": "slide",
          "settings": { "content_position": "middle_center", "content_style": "bare", "overlay_opacity": 40 }
        }
      ]
    },
    {
      "name": "t:general.slideshow_split",
      "settings": { "height": "medium" },
      "blocks": [
        {
          "type": "slide",
          "settings": { "content_style": "split" }
        },
        {
          "type": "slide",
          "settings": { "content_style": "split" }
        }
      ]
    },
    {
      "name": "t:general.slideshow_text_on_image",
      "blocks": [
        {
          "type": "slide",
          "settings": { "content_position": "bottom_left", "content_style": "bare", "overlay_opacity": 20 }
        },
        {
          "type": "slide",
          "settings": { "content_position": "bottom_left", "content_style": "bare", "overlay_opacity": 20 }
        }
      ]
    }
  ]
}
{% endschema %}
