{% comment %}The people behind the shop, each with a portrait, a name and a role, as photo cards, round portraits, an inline list or cards.{% endcomment %}
{% liquid
  assign layout = section.settings.layout
  assign sizes = '(min-width: 750px) 33vw, 100vw'
  if layout == 'inline_list'
    assign sizes = '4rem'
  elsif layout != 'photo_cards'
    assign sizes = '8rem'
  endif
%}

<div
  class="team team--{{ section.settings.layout }} full-width color-{{ section.settings.color_scheme }}"
  data-spacing="{{ section.settings.spacing }}"{% if section.settings.reveal %} data-reveal{% endif %}
  style="--image-ratio: {% render 'image-ratio', ratio: section.settings.image_ratio %};"
>
  <div class="team__inner">
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="team__intro">
        {% if section.settings.heading != blank %}
          <h2 class="team__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="team__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    {% endif %}

    <ul class="team__grid" data-reveal-stagger role="list">
      {% for block in section.blocks %}
        <li class="team__person" {{ block.shopify_attributes }}>
          <div class="team__portrait">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: alt: '', widths: '160, 320, 450, 600, 900, 1200', sizes: sizes, loading: 'lazy'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder team__placeholder' }}
            {% endif %}
          </div>
          <div class="team__details">
            {% if block.settings.name != blank %}
              <h3 class="team__name text-h5">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.name | escape }}</a>
                {%- else -%}
                  {{ block.settings.name | escape }}
                {%- endif -%}
              </h3>
            {% endif %}
            {% if block.settings.role != blank %}
              <p class="team__role">{{ block.settings.role | escape }}</p>
            {% endif %}
            {% if block.settings.bio != blank %}
              <p class="team__bio text-small">{{ block.settings.bio | escape }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .team {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .team__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-block: var(--section-spacing-start) var(--section-spacing);
  }

  .team__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: var(--width-prose);
  }

  .team--round_portraits .team__intro,
  .team--cards .team__intro {
    align-self: center;
    text-align: center;
  }

  .team__text > :first-child {
    margin-block-start: 0;
  }

  .team__text > :last-child {
    margin-block-end: 0;
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-row-gap) var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team__person {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .team--round_portraits .team__person,
  .team--cards .team__person {
    align-items: center;
    text-align: center;
  }

  /* Inline list: a small portrait beside the name and role. */
  .team--inline_list .team__person {
    flex-direction: row;
    align-items: center;
    gap: var(--space-md);
  }

  .team--cards .team__person {
    padding: var(--card-padding);
    border: var(--card-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-cards);
    background-color: var(--card-background);
  }

  .team__portrait {
    flex: none;
    overflow: hidden;
    border-radius: var(--style-border-radius-media);
  }

  .team__portrait img,
  .team__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team--photo_cards .team__portrait img,
  .team--photo_cards .team__placeholder {
    height: auto;
    aspect-ratio: var(--image-ratio);
  }

  /* Small portraits take the badge shape: round with the rounded shape family. */
  .team--round_portraits .team__portrait,
  .team--inline_list .team__portrait,
  .team--cards .team__portrait {
    width: 8rem;
    height: 8rem;
    border-radius: var(--style-border-radius-badges);
  }

  .team--inline_list .team__portrait {
    width: 4rem;
    height: 4rem;
  }

  .team__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .team__name,
  .team__role,
  .team__bio {
    margin: 0;
  }

  .team__name a {
    color: inherit;
    text-decoration: none;
  }

  .team__name a:hover {
    text-decoration: underline;
  }

  .team__role {
    color: var(--color-foreground-muted);
  }

  @media (min-width: 750px) {
    .team__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .team--round_portraits .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.team",
  "tag": "section",
  "max_blocks": 12,
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "photo_cards", "label": "t:options.layout.photo_cards" },
        { "value": "round_portraits", "label": "t:options.layout.round_portraits" },
        { "value": "inline_list", "label": "t:options.layout.inline_list" },
        { "value": "cards", "label": "t:options.layout.cards" }
      ],
      "default": "photo_cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "card", "label": "t:options.image_ratio.card" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "natural", "label": "t:options.image_ratio.natural" }
      ],
      "default": "card"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The people behind it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Introduce the makers, the workshop and the founder behind your products.</p>"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "none", "label": "t:options.spacing.none" },
        { "value": "tight", "label": "t:options.spacing.tight" },
        { "value": "theme", "label": "t:options.spacing.theme" },
        { "value": "loose", "label": "t:options.spacing.loose" }
      ],
      "default": "theme"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "t:labels.reveal",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "t:general.person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.portrait"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:labels.role",
          "default": "Role"
        },
        {
          "type": "text",
          "id": "bio",
          "label": "t:labels.short_line"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link",
          "info": "t:info.team_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.team",
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    },
    {
      "name": "t:general.team_round_portraits",
      "settings": { "layout": "round_portraits" },
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    },
    {
      "name": "t:general.team_inline_list",
      "settings": { "layout": "inline_list" },
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" },
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    },
    {
      "name": "t:general.team_cards",
      "settings": { "layout": "cards" },
      "blocks": [
        { "type": "person" },
        { "type": "person" },
        { "type": "person" }
      ]
    }
  ]
}
{% endschema %}
