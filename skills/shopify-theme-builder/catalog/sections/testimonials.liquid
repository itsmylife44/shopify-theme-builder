{% comment %}Customer quotes in a grid.{% endcomment %}
<div class="testimonials full-width color-{{ section.settings.color_scheme }}">
  <div class="testimonials__inner">
    {% if section.settings.heading != blank %}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="testimonials__list" role="list">
      {% for block in section.blocks %}
        <li class="testimonials__item" {{ block.shopify_attributes }}>
          <figure class="testimonials__figure">
            <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
            {% if block.settings.author != blank %}
              <figcaption class="testimonials__author">
                {{ block.settings.author | escape }}
                {% if block.settings.author_detail != blank %}
                  <span class="testimonials__detail">{{ block.settings.author_detail | escape }}</span>
                {% endif %}
              </figcaption>
            {% endif %}
          </figure>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .testimonials {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .testimonials__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    padding-block: var(--section-spacing);
  }

  .testimonials__heading {
    text-align: center;
  }

  .testimonials__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-lg);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .testimonials__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    margin: 0;
    padding: var(--space-lg);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--style-border-radius-cards);
  }

  .testimonials__quote {
    margin: 0;
  }

  .testimonials__author {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    font-weight: 600;
  }

  .testimonials__detail {
    font-weight: normal;
    opacity: var(--opacity-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What our customers say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:general.testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:labels.quote",
          "default": "<p>Share what a customer loved about your products.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:labels.author",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "author_detail",
          "label": "t:labels.author_detail",
          "info": "t:info.testimonials_author_detail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
